@implements IDisposable

@inject NavigationManager NavigationManager

<NavLink class="nav-link" href="" Match="NavLinkMatch.All">
    <div class="top-row ps-3 navbar navbar-dark">
        <div class="container-fluid">
            <div class="navbar-brand">Sınav Sistemi</div>
        </div>

    </div>
</NavLink>


<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">

        <AuthorizeView>
            <Authorized>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/Auto/MSAdd">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Otomatik Öğrenci Ekle
                    </NavLink>
                </div>

                <div class="nav-item px-3" hidden>
                    <NavLink class="nav-link" href="StudentAdd">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Tekli Öğrenci Ekle
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/LessonAdd">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Ders Ekle
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="TeacherAdd">
                        <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span>Öğretmen kayıt
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="FirstUp/SchoolName">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Okul Adı
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="SetPrincipal">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Müdür ayarları
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="SemesterAdd">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Dönem adı
                    </NavLink>
                </div>
                
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Register">
                        <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span>Personel kayıt
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Logout">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Çıkış Yap
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Manage">
                        <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> @context.User.Identity?.Name
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="nav-link">
                            <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Logout
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Register">
                        <span class="bi bi-person-nav-menu" aria-hidden="true"></span> Register
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Login
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>


@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}