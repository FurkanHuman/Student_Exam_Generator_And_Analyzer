@using Microsoft.AspNetCore.Authorization
@implements IDisposable
@rendermode InteractiveServer

@inject NavigationManager NavigationManager
@inject IConfiguration Configuration

<NavLink class="nav-link" href="" Match="NavLinkMatch.All">
    <div class="top-row ps-3 navbar navbar-dark">
        <div class="container-fluid">
            <div class="navbar-brand">Sınav Sistemi</div>
        </div>
    </div>
</NavLink>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">

        <AuthorizeView Context="General">
            <Authorized>

                @foreach (NavMenuItem item in navMenuItems)
                {
                    string text = ResolveText(item.Text, General);

                    <AuthorizeView Roles="@string.Join(',', item.Roles ?? [])" 
                    Policy="@item.Policy">
                        <div class="nav-item px-3">
                            <NavLink class="nav-link nav-menu-item" href="@item.Link">
                                <span class="nav-menu-icon @item.Icon"></span>
                                <span class="nav-menu-text">@text</span>
                            </NavLink>
                        </div>
                    </AuthorizeView>
                }

                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="nav-link nav-link-button">
                            <span class="bi bi-box-arrow-right nav-icon"></span>
                            <span>Çıkış Yap</span>
                        </button>
                    </form>
                </div>

            </Authorized>

            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Register">
                        <span class="bi bi-person-plus nav-icon"></span>
                        <span>Kayıt</span>
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-box-arrow-in-right nav-icon"></span>
                        <span>Giriş</span>
                    </NavLink>
                </div>

            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string? currentUrl;
    private List<NavMenuItem> navMenuItems = new();

    protected override async Task OnInitializedAsync()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;

        navMenuItems = Configuration.GetSection("NavMenuItems").Get<List<NavMenuItem>>() ?? [];
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private static string ResolveText(string? text, AuthenticationState auth)
    {
        if (string.IsNullOrWhiteSpace(text))
            return string.Empty;

        return text switch
        {
            "{{UserName}}" => auth.User.Identity?.Name ?? "Kullanıcı",
            _ => text
        };
    }

    private sealed class NavMenuItem
    {
        public string? Text { get; set; }
        public string? Link { get; set; }
        public string? Icon { get; set; }
        public List<string>? Roles { get; set; }
        public string? Policy { get; set; }
        public bool IsDynamic => Text?.Contains("{{") == true;
    }
}
