@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <header class="bg-white border-bottom shadow-sm py-2 px-3 px-md-4">
            <div class="container-fluid d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                <div class="text-muted small text-center text-md-start">
                    Bu proje açık kaynaklı, özgür ve tamamen ücretsizdir. Sen de katkı sağlayarak bu yolculuğun bir parçası olabilirsin.
                </div>

                <div class="d-flex gap-2 flex-wrap justify-content-center">
                    <a class="btn btn-outline-secondary btn-sm d-flex align-items-center" href="https://github.com/FurkanHuman/Student_Exam_Generator_And_Analyzer" target="_blank" title="GitHub'da Görüntüle">
                        <img src="github-mark.svg" alt="GitHub" style="height: 1em; margin-right: 0.5em;">GitHub
                    </a>

                    <a class="btn btn-info btn-sm" href="/SupportMe" target="_blank" title="Projeyi Destekle">
                        ❤️ Destek Ol
                    </a>
                </div>
            </div>
        </header>


        <article class="content px-4">
            @Body

            <div class="version-banner" hidden>
                <span style="color: red; font-weight: bold;">V0.0.1-alpha</span> — Geliştirme aşamasında.
                <br />
                @versionMsg[rndMsg]
            </div>

        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

<style>
    .version-banner {
        align-content: center;
        align-items: center;
        text-align: center;
        position: fixed;
        bottom: 10rem;
        right: -1rem;
        transform: rotate(-45deg);
        background-color: rgba(0, 0, 0, 0.75);
        color: #fff;
        font-size: 1rem;
        padding: 5px 10px;
        z-index: 9999;
        pointer-events: none;
        border-radius: 5px;
        box-shadow: 0 0 5px rgba(0,0,0,0.4);
        font-family: 'Courier New', Courier, monospace;
    }
</style>

@code {
    private static string[] versionMsg { get; set; } =
            {"Hızlı ilerlemek için kahve desteği gerekli! ☕☕☕",
            "Kahve molasını azaltmam gerek! ☕" ,
            "☕☕☕☕☕ ☕☕☕☕☕ ☕☕☕☕☕",
            "kod yazarken ölümsüzlüğü bulduk!?! ♾️♾️♾️",
            "Pantheon, S.E. Lain, Evangelion, Code Lyoko 👁️👁️👁️",
            "En iyi kod çalışan koddur.",
            "Hayatım olmuş kod, sen olmasanda olur!!!",
            "😅 Kod daha tam yürümeyi öğrenmedi...",
            "kod kendi kendini yazmıyor hâlâ",
            "Kod yazmazsan sabaha kadar bitmeyecek 🤡"
    };

    int rndMsg = 0;

    protected override Task OnInitializedAsync()
    {
        Random rnd = new();

        rndMsg = rnd.Next(0, versionMsg.Length);

        return base.OnInitializedAsync();
    }
}