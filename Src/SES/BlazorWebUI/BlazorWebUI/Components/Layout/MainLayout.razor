@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4" hidden="hidden">
            <a href="https://furkanhuman.app/" target="_blank">Hakkında</a>
        </div>

        <article class="content px-4">
            @Body

            <div class="version-banner">
                <span style="color: red; font-weight: bold;">Alfa V0.1</span> — Geliştirme aşamasında.
                <br />
                Hızlı ilerlemek için kahve desteği gerekli!
            </div>

        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

<style>
    .version-banner {
        position: fixed;
        bottom: 11rem;
        right: -1rem;
        transform: rotate(-45deg);
        background-color: rgba(0, 0, 0, 0.75);
        color: #fff;
        font-size: 1rem;
        padding: 5px 10px;
        z-index: 9999;
        pointer-events: none;
        border-radius: 5px;
        box-shadow: 0 0 5px rgba(0,0,0,0.4);
        font-family: 'Courier New', Courier, monospace;
    }
</style>

