@using Application.Features.FeedBacks.Commands.Create
@using BlazorWebUI.Client.Pages.Styles
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IMediator Mediator
@inject AuthenticationStateProvider AuthenticationStateProvider

<button type="button" class="btn btn-outline-primary btn-sm" @onclick="OpenModal" title="Geri Bildirim Gönder">
    💬 Geri Bildirim
</button>

<ModalDialog @ref="feedbackModal" Title="Geri Bildirim Gönder">
    <div class="feedback-form">
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @errorMessage
                <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @successMessage
                <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
            </div>
        }

        @if (!isAuthenticated)
        {
            <div class="mb-3">
                <label for="feedbackEmail" class="form-label">E-posta <span class="text-danger">*</span></label>
                <input type="email" class="form-control" id="feedbackEmail" @bind="email" 
                       placeholder="ornek@email.com" required />
            </div>
        }
        else
        {
            <div class="mb-3">
                <div class="alert alert-info mb-0">
                    <small>📧 <strong>@currentUserEmail</strong> olarak geri bildirim gönderiyorsunuz.</small>
                </div>
            </div>
        }

        <div class="mb-3">
            <label for="feedbackMessage" class="form-label">Mesajınız <span class="text-danger">*</span></label>
            <textarea class="form-control" id="feedbackMessage" @bind="message" 
                      rows="5" placeholder="Geri bildiriminizi buraya yazın..." required></textarea>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-secondary" @onclick="CloseModal" disabled="@isSubmitting">
                İptal
            </button>
            <button type="button" class="btn btn-primary" @onclick="SubmitFeedback" disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Gönderiliyor...</span>
                }
                else
                {
                    <span>Gönder</span>
                }
            </button>
        </div>
    </div>
</ModalDialog>

<style>
    .feedback-form {
        min-width: 300px;
    }
</style>

@code {
    private ModalDialog feedbackModal=new();
    private string email = string.Empty;
    private string message = string.Empty;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isSubmitting = false;
    private bool isAuthenticated = false;
    private string currentUserEmail = string.Empty;
    private string currentUserName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CheckAuthenticationState();
    }

    private async Task CheckAuthenticationState()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        isAuthenticated = user.Identity?.IsAuthenticated ?? false;

        if (isAuthenticated)
        {
            currentUserEmail = user.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.Email)?.Value 
                ?? user.FindFirst("email")?.Value 
                ?? string.Empty;

            currentUserName = user.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.Name)?.Value 
                ?? user.FindFirst("name")?.Value 
                ?? user.Identity?.Name 
                ?? string.Empty;
        }
    }

    private async Task OpenModal()
    {
        await CheckAuthenticationState();
        errorMessage = string.Empty;
        successMessage = string.Empty;
        feedbackModal?.Open();
    }

    private void CloseModal()
    {
        feedbackModal?.Close();
        if (!isAuthenticated)
        {
            email = string.Empty;
        }
        message = string.Empty;
        errorMessage = string.Empty;
        successMessage = string.Empty;
    }

    private async Task SubmitFeedback()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;

        string emailToSend = isAuthenticated ? currentUserEmail : email.Trim();

        if (string.IsNullOrWhiteSpace(emailToSend))
        {
            errorMessage = "E-posta adresi bulunamadı.";
            return;
        }

        if (string.IsNullOrWhiteSpace(message))
        {
            errorMessage = "Lütfen mesajınızı girin.";
            return;
        }

        if (!isAuthenticated && !IsValidEmail(emailToSend))
        {
            errorMessage = "Lütfen geçerli bir e-posta adresi girin.";
            return;
        }

        try
        {
            isSubmitting = true;
            StateHasChanged();

            var command = new CreateFeedBackCommand
            {
                UserName = isAuthenticated ? currentUserName : null,
                Email = emailToSend,
                Message = message.Trim(),
                PageUrl = NavigationManager.Uri
            };

            var response = await Mediator.Send(command);

            successMessage = "Geri bildiriminiz başarıyla gönderildi. Teşekkür ederiz! 🎉";
            message = string.Empty;
            if (!isAuthenticated)
            {
                email = string.Empty;
            }

            await Task.Delay(2000);
            CloseModal();
        }
        catch (Exception ex)
        {
            errorMessage = $"Geri bildirim gönderilirken bir hata oluştu: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private bool IsValidEmail(string email)
    {
        try
        {
            var addr = new System.Net.Mail.MailAddress(email);
            return addr.Address == email;
        }
        catch
        {
            return false;
        }
    }
}