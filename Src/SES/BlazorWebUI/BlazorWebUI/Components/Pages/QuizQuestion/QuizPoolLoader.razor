@using Application.Features.Lessons.Queries.GetList
@using Application.Features.Lessons.Queries.GetListLessonQueryBySemesterId
@using Application.Features.QuizQuestions.Queries.GetByLessonId
@using Application.Features.Semesters.Queries.GetList
@using Application.Features.QuizQuestions.Queries.GetList
@using NArchitecture.Core.Application.Requests
@using NArchitecture.Core.Application.Responses

@rendermode InteractiveServer
@inject IMediator _mediatr

@code
{
    [Parameter]
    public EventCallback<IList<GetByLessonIdQuizQuestionListItemDto>> OnQQList { get; set; }

    [Parameter]
    public EventCallback<int> OnSemesterId { get; set; }

    [Parameter]
    public EventCallback<int> OnLessonId { get; set; }

    [Parameter]
    public EventCallback<int> OnStudentClasssAge { get; set; }

    private int? SelectedSemesterId { get; set; }
    private int? SelectedLessonId { get; set; }

    private GetListResponse<GetListSemesterListItemDto> GetListSemesters { get; set; } = new();
    private GetListResponse<GetListLessonQueryBySemesterIdDto> GetListLessons { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        PageRequest pR = new() { PageIndex = 0, PageSize = int.MaxValue };
        GetListSemesters = await _mediatr.Send(new GetListSemesterQuery() { PageRequest = pR });
        await base.OnInitializedAsync();
    }

    private async Task SelectSemester(int semesterId)
    {
        SelectedSemesterId = semesterId;
        SelectedLessonId = null;
        GetListLessons = await _mediatr.Send(new GetListLessonQueryBySemesterIdQuery() { SemesterId = semesterId });
    }

    private async Task SelectLesson(int lessonId)
    {
        SelectedLessonId = lessonId;
        await LoadSelectedQuestion();
    }

    private async Task LoadSelectedQuestion()
    {
        List<GetByLessonIdQuizQuestionListItemDto> _qqList = new();
        if (SelectedLessonId != null)
        {
            GetListResponse<GetByLessonIdQuizQuestionListItemDto> GetListQuizQuestion = await _mediatr.Send(new GetByLessonIdQuizQuestionQuery() { LessonId = SelectedLessonId.Value });

            _qqList.AddRange(GetListQuizQuestion.Items);
        }

        _qqList = _qqList.Distinct().ToList();

        int classAge = GetListLessons.Items.FirstOrDefault(l => l.Id == SelectedLessonId)?.StudentClassAge ?? 0;
        await OnQQList.InvokeAsync(_qqList);
        await OnLessonId.InvokeAsync(SelectedLessonId!.Value);
        await OnSemesterId.InvokeAsync(SelectedSemesterId!.Value);
        await OnStudentClasssAge.InvokeAsync(classAge);
    }
}

<div class="form-control">

    <div class="btn-group m-2">
        <button class="btn btn-secondary btn-lg dropdown-toggle" type="button" data-bs-toggle="dropdown">
            @(SelectedSemesterId.HasValue ? GetListSemesters.Items.FirstOrDefault(s => s.Id == SelectedSemesterId)?.Name : "Dönem Seç")
        </button>
        <ul class="dropdown-menu">
            @foreach (var semester in GetListSemesters.Items)
            {
                <li @onclick="() => SelectSemester(semester.Id)" class="dropdown-item">@($"{semester.BeginSemesterDate.Year} - {semester.EndSemesterDate.Year} {semester.Name}")</li>
            }
        </ul>
    </div>

    @if (SelectedSemesterId.HasValue)
    {
        <div class="btn-group m-2">
            <button class="btn btn-secondary btn-lg dropdown-toggle" type="button" data-bs-toggle="dropdown">
                @(SelectedLessonId.HasValue ? GetListLessons.Items.FirstOrDefault(l => l.Id == SelectedLessonId)?.LessonName : "Ders Seç")
            </button>
            <ul class="dropdown-menu">
                @foreach (var lesson in GetListLessons.Items)
                {
                    <li @onclick="() => SelectLesson(lesson.Id)" class="dropdown-item">@lesson.StudentClassAge. Sınıf @lesson.LessonName</li>
                }
            </ul>
        </div>
    }
</div>
