@page "/Auto/DocumentQuestionExtraction"
@rendermode InteractiveServer

@using Application.Features.Lessons.Queries.GetById
@using Application.Features.ReferenceBenefits.Queries.GetListByIdReferenceBenefitBenefit
@using Application.Services.AIService
@using Application.Features.QuizQuestions.Commands.Create
@using Application.Services.AIService.Models
@using BlazorWebUI.Components.Shared
@using Domain.Enums
@using BlazorWebUI.Client.Pages.Styles.QQ
@using BlazorWebUI.Client.Pages.Styles.Form
@using NArchitecture.Core.Application.Responses
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Dosyadan Soru Çıkartma</PageTitle>

<div class="document-extraction-container">
    <!-- Header -->
    <div class="page-header mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="ai-icon">
                <i class="bi bi-file-earmark-text"></i>
            </div>
            <div>
                <h2 class="mb-1">
                    <i class="bi bi-file-earmark-arrow-up me-2"></i>Dosyadan Soru Çıkartma
                </h2>
                <p class="text-muted mb-0">
                    PDF, Word, Excel dosyalarından AI ile soru çıkartın
                </p>
            </div>
        </div>
    </div>

    <!-- Benefit Loader and Selector -->
    @if (_isQQBenefitLoaderVisible)
    {
        <div class="benefit-section mb-4">
            <QQBenefitLoader IsVisible="_isQQBenefitLoaderVisible"
                             OnSelectedBenefitId="HandleBenefitId"
                             OnLessonId="HandleLessonId" />
        </div>
    }

    @if (!_isQQBenefitLoaderVisible && CheckboxItems.Count > 0)
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">
                    <i class="bi bi-bookmark-star me-2"></i>Kazanım Seçimi
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-info mb-3">
                    <i class="bi bi-info-circle me-2"></i>
                    <strong>İsteğe Bağlı:</strong> Kazanım seçerseniz, AI çıkartılan soruları bu kazanımlara göre etiketler.
                </div>

                <QQBenefitAdd OnSelectedBenefits="HandleSelectedBenefits"
                              CheckboxItems="CheckboxItems" />

                @if (_selectedBenefits.Count > 0)
                {
                    <div class="mt-3">
                        <p class="text-muted mb-2">
                            <i class="bi bi-check-circle me-1"></i>
                            Seçili Kazanımlar (@_selectedBenefits.Count):
                        </p>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var benefit in _selectedBenefits)
                            {
                                <span class="badge bg-info px-3 py-2">
                                    @benefit.Value
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- File Upload Section -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-cloud-upload me-2"></i>Dosya Yükleme
            </h5>
        </div>
        <div class="card-body p-4">
            <div class="row g-4">
                <!-- File Upload -->
                <div class="col-12">
                    <label class="form-label fw-semibold required">
                        <i class="bi bi-paperclip text-primary me-2"></i>Dosya Seçin
                    </label>
                    <InputFile OnChange="HandleFileSelection"
                               class="form-control"
                               accept=".pdf,.doc,.docx,.xls,.xlsx,.txt"
                               disabled="@_isExtracting" />
                    <small class="form-text text-muted">
                        <i class="bi bi-info-circle me-1"></i>
                        Desteklenen formatlar: PDF, Word (DOC/DOCX), Excel (XLS/XLSX), Text (TXT)
                    </small>
                </div>

                @if (_selectedFile != null)
                {
                    <div class="col-12">
                        <div class="alert alert-success">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <i class="bi bi-file-earmark-check me-2"></i>
                                    <strong>Seçili Dosya:</strong> @_selectedFile.Name
                                </div>
                                <div>
                                    <span class="badge bg-success">@FormatFileSize(_selectedFile.Size)</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Extraction Settings -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-gradient-ai text-white">
            <h5 class="mb-0">
                <i class="bi bi-gear-fill me-2"></i>Çıkartma Ayarları
            </h5>
        </div>

        <div class="card-body p-4">
            @if (_hasError)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>Hata!</strong> @_errorMessage
                    <button type="button" class="btn-close" @onclick="() => _hasError = false"></button>
                </div>
            }

            @if (_isSuccess)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    <strong>Başarılı!</strong> Sorular başarıyla çıkartıldı.
                    <button type="button" class="btn-close" @onclick="() => _isSuccess = false"></button>
                </div>
            }

            <div class="row g-4">
                <!-- Extraction Prompt -->
                <div class="col-12">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-chat-left-text text-primary me-2"></i>Ek Talimatlar (İsteğe Bağlı)
                    </label>
                    <InputTextArea class="form-control"
                                   rows="4"
                                   @bind-Value="_extractionPrompt"
                                   placeholder="AI'ya nasıl soru çıkartması gerektiği hakkında ek talimatlar verin. Örn: 'Sadece çoktan seçmeli soruları çıkart', 'Zorluk seviyesini yüksek tut'..." />
                    <small class="form-text text-muted">
                        <i class="bi bi-info-circle me-1"></i>
                        Boş bırakırsanız, AI dosyayı otomatik analiz eder.
                    </small>
                </div>

                <!-- Max Questions -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-hash text-success me-2"></i>Maksimum Soru Sayısı
                    </label>
                    <InputText class="form-control"
                               type="number"
                               min="0"
                               max="100"
                               @bind-Value="_maxQuestions"
                               placeholder="0 = Sınırsız" />
                    <small class="form-text text-muted">0 = Tüm soruları çıkart</small>
                </div>

                <!-- Language Selection -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold required">
                        <i class="bi bi-translate text-info me-2"></i>Dil
                    </label>
                    <div class="dropdown w-100">
                        <button class="btn btn-outline-secondary dropdown-toggle w-100 text-start"
                                type="button"
                                data-bs-toggle="dropdown"
                                disabled="@_isExtracting">
                            @(!string.IsNullOrEmpty(_selectedLanguage.Value) ? _selectedLanguage.Value : "Dil Seçin")
                        </button>
                        <ul class="dropdown-menu w-100">
                            @foreach (var language in QQStatic.LanguagePairsTUR)
                            {
                                <li>
                                    <a class="dropdown-item" @onclick="() => SelectLanguage(language)">
                                        <i class="bi bi-globe me-2"></i>@language.Value
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                <!-- Question Type (Optional) -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-list-check text-warning me-2"></i>Soru Türü (Opsiyonel)
                    </label>
                    <div class="dropdown w-100">
                        <button class="btn btn-outline-secondary dropdown-toggle w-100 text-start"
                                type="button"
                                data-bs-toggle="dropdown"
                                disabled="@_isExtracting">
                            @(_selectedQuestionType.HasValue && QQStatic.SelectTypeOptionsTUR.ContainsKey(_selectedQuestionType.Value)
                                                        ? QQStatic.SelectTypeOptionsTUR[_selectedQuestionType.Value]
                                                        : "Otomatik Tespit")
                        </button>
                        <ul class="dropdown-menu w-100">
                            <li>
                                <a class="dropdown-item" @onclick="() => SelectQuestionType(null)">
                                    <i class="bi bi-magic me-2"></i>Otomatik Tespit
                                </a>
                            </li>
                            @foreach (var type in QQStatic.SelectTypeOptionsTUR)
                            {
                                <li>
                                    <a class="dropdown-item" @onclick="() => SelectQuestionType(type.Key)">
                                        @type.Value
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                <!-- Difficulty Level -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold required">
                        <i class="bi bi-speedometer2 text-danger me-2"></i>Beklenen Zorluk
                    </label>
                    <select class="form-select" @bind="_difficultyLevel" disabled="@_isExtracting">
                        <option value="0">Seviye Seçin</option>
                        <option value="1">Kolay</option>
                        <option value="2">Orta</option>
                        <option value="3">Zor</option>
                    </select>
                </div>

                <!-- AI Model Selector -->
                <div class="col-md-4">
                    <AIModelSelector @bind-SelectedProvider="_selectedAIProvider"
                                     @bind-SelectedModel="_selectedAIModel"
                                     IsDisabled="@_isExtracting" />
                </div>

                <!-- Benefit Toggle -->
                <div class="col-md-4">
                    <div class="form-check form-switch mt-4">
                        <InputCheckbox class="form-check-input"
                                       @bind-Value="_isQQBenefitLoaderVisible"
                                       id="flexCheckLoader"
                                       disabled="@_isExtracting"
                                       @onclick="ToggleBenefitLoader" />
                        <label class="form-check-label" for="flexCheckLoader">
                            <i class="bi bi-shuffle me-1"></i>Kazanım Filtresini Değiştir
                        </label>
                    </div>
                </div>
            </div>

            <!-- Extract Button -->
            <hr class="my-4" />

            <div class="d-grid gap-2">
                <button class="btn btn-lg btn-primary"
                        @onclick="ExtractQuestionsAsync"
                        disabled="@ExtractButtonIsDisabled">
                    @if (_isExtracting)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        <span>AI Soruları Çıkartıyor...</span>
                    }
                    else
                    {
                        <i class="bi bi-file-earmark-arrow-down me-2"></i>
                        <span>Soruları Çıkart</span>
                    }
                </button>
            </div>

            @if (_isExtracting)
            {
                <div class="progress mt-3" style="height: 25px;">
                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
                         role="progressbar"
                         style="width: @_progress%">
                        %@_progress
                    </div>
                </div>
                <p class="text-center text-muted mt-2 mb-0">
                    <small>@_progressMessage</small>
                </p>
            }
        </div>
    </div>

    <!-- Extracted Questions Preview -->
    @if (_extractedQuestions.Count > 0)
    {
        <div class="card shadow-sm border-0">
            <div class="card-header bg-success text-white">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-check-circle me-2"></i>Çıkartılan Sorular
                    </h5>
                    <span class="badge bg-white text-success">
                        @_selectedQuestionIndices.Count / @_extractedQuestions.Count Seçili
                    </span>
                </div>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-info mb-4 d-flex justify-content-between align-items-center">
                    <div>
                        <i class="bi bi-info-circle me-2"></i>
                        Kaydetmek istediğiniz soruları seçin ve onaylayın.
                    </div>
                    <button class="btn btn-sm btn-outline-primary" @onclick="SelectAllQuestions">
                        <i class="bi bi-check-all me-1"></i>
                        @(_selectedQuestionIndices.Count == _extractedQuestions.Count ? "Hiçbirini Seçme" : "Tümünü Seç")
                    </button>
                </div>

                @foreach (var (question, index) in _extractedQuestions.Select((q, i) => (q, i)))
                {
                    <div class="extracted-question-item mb-4 @(IsQuestionSelected(index) ? "selected" : "")">
                        <div class="question-selector">
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="question_@index"
                                       checked="@IsQuestionSelected(index)"
                                       @onchange="() => ToggleQuestionSelection(index)">
                                <label class="form-check-label fw-bold" for="question_@index">
                                    Soru @(index + 1)
                                </label>
                            </div>
                            <span class="badge bg-primary">
                                @GetQuestionTypeName(question.QuestionType)
                            </span>
                        </div>

                        <div class="question-preview-card card border-0 shadow-sm">
                            <div class="card-body">
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-star me-1"></i>@question.MinimumScore / @question.MaximumScore Puan
                                        </span>
                                    </div>

                                    @if (!string.IsNullOrEmpty(question.Stem))
                                    {
                                        <div class="question-context p-3 bg-light rounded mb-3">
                                            <small class="text-muted d-block mb-1">
                                                <i class="bi bi-info-circle me-1"></i>Bilgi/Ana Metin
                                            </small>
                                            <p class="mb-0">@question.Stem</p>
                                        </div>
                                    }

                                    <p class="fs-5 fw-semibold mb-3">@question.Prompt</p>

                                    @if (question.BenefitCodes.Any())
                                    {
                                        <div class="mb-3">
                                            <small class="text-muted d-block mb-2">
                                                <i class="bi bi-bookmark me-1"></i>Kazanımlar:
                                            </small>
                                            <div class="d-flex flex-wrap gap-2">
                                                @foreach (var benefitCode in question.BenefitCodes)
                                                {
                                                    <span class="badge bg-info">@benefitCode</span>
                                                }
                                            </div>
                                        </div>
                                    }

                                    @if (question.Options != null && question.Options.Any())
                                    {
                                        <div>
                                            <small class="text-muted d-block mb-2">
                                                <i class="bi bi-list-check me-1"></i>Seçenekler:
                                            </small>
                                            <div class="options-list">
                                                @{
                                                    int optionIndex = 0;
                                                }
                                                @foreach (var option in question.Options!)
                                                {
                                                    <div class="option-item @(option.Value ? "correct" : "")">
                                                        <span class="option-letter">@GetOptionLetter(optionIndex++)</span>
                                                        <span class="option-text">@option.Key</span>
                                                        @if (option.Value)
                                                        {
                                                            <span class="badge bg-success ms-2">Doğru</span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <hr class="my-4" />

                <div class="d-flex gap-2 justify-content-between align-items-center flex-wrap">
                    <div>
                        <small class="text-muted">
                            <i class="bi bi-info-circle me-1"></i>
                            @_selectedQuestionIndices.Count soru kaydedilecek
                        </small>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-danger" @onclick="ClearExtractedQuestions">
                            <i class="bi bi-trash me-2"></i>Temizle
                        </button>
                        <button class="btn btn-success"
                                @onclick="SaveSelectedQuestionsAsync"
                                disabled="@SaveButtonIsDisabled">
                            @if (_isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Kaydediliyor...</span>
                            }
                            else
                            {
                                <i class="bi bi-save me-2"></i>
                                <span>Seçilenleri Kaydet (@_selectedQuestionIndices.Count)</span>
                            }
                        </button>
                    </div>
                </div>

                @if (_isSaving)
                {
                    <div class="progress mt-3" style="height: 25px;">
                        <div class="progress-bar bg-success"
                             role="progressbar"
                             style="width: @_saveProgress%">
                            @_savedCount / @_selectedQuestionIndices.Count
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<style>
    .document-extraction-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 1rem;
    }

    .page-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 2rem;
        border-radius: 1rem;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

    .ai-icon {
        font-size: 3rem;
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0.7;
        }
    }

    .bg-gradient-ai {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .required::after {
        content: " *";
        color: #dc3545;
    }

    .extracted-question-item {
        padding: 1rem;
        border-radius: 0.5rem;
        border: 2px solid transparent;
        transition: all 0.3s;
    }

        .extracted-question-item.selected {
            border-color: #198754;
            background-color: #f0fdf4;
        }

    .question-selector {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

        .question-selector .form-check-input {
            width: 1.5rem;
            height: 1.5rem;
            cursor: pointer;
        }

    .question-preview-card {
        background: white;
    }

    .question-context {
        border-left: 4px solid #0d6efd;
    }

    .options-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .option-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem;
        background: #f8f9fa;
        border-radius: 0.375rem;
        border: 2px solid transparent;
    }

        .option-item.correct {
            background: #d1f4e0;
            border-color: #198754;
        }

    .option-letter {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        background: #6c757d;
        color: white;
        border-radius: 50%;
        font-weight: bold;
        flex-shrink: 0;
    }

    .option-item.correct .option-letter {
        background: #198754;
    }

    .option-text {
        flex: 1;
    }

    .dropdown-menu {
        max-height: 300px;
        overflow-y: auto;
    }

    .dropdown-item {
        cursor: pointer;
        transition: background-color 0.2s;
    }

        .dropdown-item:hover {
            background-color: #f8f9fa;
        }

    .progress {
        border-radius: 10px;
        overflow: hidden;
    }

    .benefit-section {
        animation: slideDown 0.3s ease-out;
    }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 768px) {
        .page-header {
            padding: 1rem;
        }

        .ai-icon {
            font-size: 2rem;
        }
    }
</style>

@inject IAIServiceFactory _ServiceProvider
@inject IMediator _mediator

@code {
    private IBrowserFile? _selectedFile;
    private KeyValuePair<string, string> _selectedLanguage;
    private string _extractionPrompt { get; set; } = string.Empty;
    private string _maxQuestions { get; set; } = "0";
    private byte? _selectedQuestionType { get; set; }
    private byte _difficultyLevel { get; set; } = 0;
    private string _selectedAIProvider { get; set; } = string.Empty;
    private string _selectedAIModel { get; set; } = string.Empty;
    private bool _isQQBenefitLoaderVisible { get; set; } = true;
    private bool _isExtracting { get; set; } = false;
    private bool _isSaving { get; set; } = false;
    private bool _isSuccess { get; set; } = false;
    private bool _hasError { get; set; } = false;
    private string _errorMessage { get; set; } = string.Empty;

    private int _progress { get; set; } = 0;
    private string _progressMessage { get; set; } = string.Empty;
    private int _saveProgress { get; set; } = 0;
    private int _savedCount { get; set; } = 0;

    private int _selectedBenefitId { get; set; }
    private int _selectedLessonId { get; set; }
    private Dictionary<string, string> _benefits { get; set; } = new();
    private Dictionary<string, string> _filteredBenefitsForAI { get; set; } = new();
    private Dictionary<string, int> _benefitCodeToId { get; set; } = new();
    private Dictionary<int, string> _selectedBenefits { get; set; } = new();

    private ICollection<CheckboxItem<int>> CheckboxItems { get; set; } = new List<CheckboxItem<int>>();

    private List<AIQuestionGenerationResponse> _extractedQuestions { get; set; } = new();
    private HashSet<int> _selectedQuestionIndices { get; set; } = new();

    private bool ExtractButtonIsDisabled => !CanExtract() || _isExtracting;
    private bool SaveButtonIsDisabled => _selectedQuestionIndices.Count == 0 || _isSaving;

    private void SelectLanguage(KeyValuePair<string, string> langPair)
    {
        _selectedLanguage = langPair;
    }

    private void SelectQuestionType(byte? typeKey)
    {
        _selectedQuestionType = typeKey;
    }

    private async Task HandleFileSelection(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        _hasError = false;

        // Validate file size (max 10MB)
        if (_selectedFile.Size > 10 * 1024 * 1024)
        {
            _hasError = true;
            _errorMessage = "Dosya boyutu 10MB'dan küçük olmalıdır.";
            _selectedFile = null;
        }
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    private async Task HandleBenefitId(int benefitId)
    {
        try
        {
            _selectedBenefitId = benefitId;
            var response = await _mediator.Send(new GetListByIdReferenceBenefitBenefitQuery { Id = benefitId });

            _benefits.Clear();
            _benefitCodeToId.Clear();
            CheckboxItems.Clear();

            foreach (var benefit in response.Items)
            {
                _benefits.Add(benefit.BenefitCode, benefit.Description);
                _benefitCodeToId.Add(benefit.BenefitCode, benefit.Id);

                CheckboxItems.Add(new CheckboxItem<int>
                {
                    Key = benefit.Id,
                    DisplayValue = $"{benefit.BenefitCode} - {benefit.Description}"
                });
            }

            _isQQBenefitLoaderVisible = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _hasError = true;
            _errorMessage = "Kazanımlar yüklenirken hata oluştu: " + ex.Message;
        }
    }

    private Task HandleLessonId(int lessonId)
    {
        _selectedLessonId = lessonId;
        return Task.CompletedTask;
    }

    private void HandleSelectedBenefits(ICollection<CheckboxItem<int>> selectedItems)
    {
        _selectedBenefits = selectedItems.ToDictionary(item => item.Key, item => item.DisplayValue);

        var selectedCodes = selectedItems
            .Select(item => _benefitCodeToId.FirstOrDefault(x => x.Value == item.Key).Key)
            .Where(code => !string.IsNullOrEmpty(code))
            .ToList();

        var tempBenefits = new Dictionary<string, string>();
        foreach (var code in selectedCodes)
            if (_benefits.ContainsKey(code))
                tempBenefits[code] = _benefits[code];

        _filteredBenefitsForAI = tempBenefits;
    }

    private void ToggleBenefitLoader()
    {
        if (!_isQQBenefitLoaderVisible)
        {
            CheckboxItems.Clear();
            _selectedBenefits.Clear();
            _benefits.Clear();
            _benefitCodeToId.Clear();
        }
    }

    private bool CanExtract()
    {
        return _selectedFile != null &&
               !string.IsNullOrEmpty(_selectedLanguage.Key) &&
               !string.IsNullOrEmpty(_selectedAIProvider) &&
               !string.IsNullOrEmpty(_selectedAIModel) &&
               _difficultyLevel > 0 &&
               _selectedLessonId > 0;
    }

    private async Task ExtractQuestionsAsync()
    {
        if (!CanExtract() || _selectedFile == null) return;

        var aiService = _ServiceProvider.GetService(_selectedAIProvider);

        try
        {
            _isExtracting = true;
            _hasError = false;
            _isSuccess = false;
            _progress = 0;
            _progressMessage = "Dosya okunuyor...";
            StateHasChanged();

            // Read file content
            byte[] fileBytes;
            using (var ms = new MemoryStream())
            {
                await _selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(ms);
                fileBytes = ms.ToArray();
            }

            _progress = 20;
            _progressMessage = "Dosya içeriği işleniyor...";
            StateHasChanged();

            string base64Content = Convert.ToBase64String(fileBytes);

            _progress = 40;
            _progressMessage = "AI bağlantısı kuruluyor...";
            StateHasChanged();

            var lessonResponse = await _mediator.Send(new GetByIdLessonQuery { Id = _selectedLessonId });

            var request = new AIQuestionExtractionRequest
            {
                DocumentContent = base64Content,
                FileName = _selectedFile.Name,
                MimeType = _selectedFile.ContentType,
                LanguageCode = _selectedLanguage.Key,
                ExtractionPrompt = _extractionPrompt,
                LessonName = lessonResponse.LessonName,
                DifficultyLevel = _difficultyLevel,
                ExpectedQuestionType = _selectedQuestionType.HasValue ? (QuestionType)_selectedQuestionType.Value : null,
                LearningObjectives = _filteredBenefitsForAI,
                MaxQuestions = int.Parse(_maxQuestions)
            };

            _progress = 60;
            _progressMessage = "AI soruları çıkartıyor... Bu birkaç dakika sürebilir.";
            StateHasChanged();

            using var cts = new CancellationTokenSource();
            var result = await aiService.ExtractQuestionsFromDocumentAsync(
                extractionRequest: request,
                aiModel: _selectedAIModel!,
                cancellationToken: cts.Token
            );

            _progress = 90;
            _progressMessage = "Sorular işleniyor...";
            StateHasChanged();

            if (result != null && result.Count > 0)
            {
                _extractedQuestions = result.ToList();
                _selectedQuestionIndices = Enumerable.Range(0, _extractedQuestions.Count).ToHashSet();
            }
            else
            {
                _hasError = true;
                _errorMessage = "AI dosyadan soru çıkartamadı. Lütfen farklı bir dosya deneyin veya ayarları değiştirin.";
                return;
            }

            _progress = 100;
            _progressMessage = "Tamamlandı!";
            _isSuccess = true;
            StateHasChanged();

            await Task.Delay(1000);
        }
        catch (Exception ex)
        {
            _hasError = true;
            _errorMessage = $"Sorular çıkartılırken hata oluştu: {ex.Message}";
        }
        finally
        {
            _isExtracting = false;
            _progress = 0;
            _progressMessage = string.Empty;
            StateHasChanged();
        }
    }

    private void ClearExtractedQuestions()
    {
        _extractedQuestions.Clear();
        _selectedQuestionIndices.Clear();
        _isSuccess = false;
        _selectedFile = null;
    }

    private bool IsQuestionSelected(int index) => _selectedQuestionIndices.Contains(index);

    private void ToggleQuestionSelection(int index)
    {
        if (_selectedQuestionIndices.Contains(index))
            _selectedQuestionIndices.Remove(index);
        else
            _selectedQuestionIndices.Add(index);
    }

    private void SelectAllQuestions()
    {
        if (_selectedQuestionIndices.Count == _extractedQuestions.Count)
            _selectedQuestionIndices.Clear();
        else
            _selectedQuestionIndices = Enumerable.Range(0, _extractedQuestions.Count).ToHashSet();
    }

    private string GetQuestionTypeName(QuestionType type)
    {
        return type switch
        {
            QuestionType.OpenEnded => "Açık Uçlu",
            QuestionType.MultipleChoice => "Çoktan Seçmeli",
            QuestionType.TrueFalse => "Doğru/Yanlış",
            QuestionType.FillInTheBlank => "Boşluk Doldurma",
            QuestionType.Matching => "Eşleştirme",
            _ => "Bilinmeyen"
        };
    }

    private string GetOptionLetter(int index) => ((char)('A' + index)).ToString();

    private async Task SaveSelectedQuestionsAsync()
    {
        if (_selectedQuestionIndices.Count == 0) return;

        try
        {
            _isSaving = true;
            _savedCount = 0;
            _saveProgress = 0;
            _hasError = false;
            StateHasChanged();

            var selectedQuestions = _selectedQuestionIndices
                .OrderBy(i => i)
                .Select(i => _extractedQuestions[i])
                .ToList();

            foreach (var question in selectedQuestions)
            {
                try
                {
                    var optionAppDtos = new List<QuestionOptionAppDto?>();

                    if (question.Options != null && question.Options.Any())
                        foreach (var option in question.Options)
                            optionAppDtos.Add(new QuestionOptionAppDto
                            {
                                IsCorrect = option.Value,
                                OptionText = option.Key
                            });

                    var benefitIds = question.BenefitCodes
                        .Where(code => _benefitCodeToId.ContainsKey(code))
                        .Select(code => _benefitCodeToId[code])
                        .ToList();

                    // If no benefits mapped, use the selected benefit
                    if (benefitIds.Count == 0 && _selectedBenefitId > 0)
                        benefitIds.Add(_selectedBenefitId);

                    if (benefitIds.Count == 0)
                    {
                        _hasError = true;
                        _errorMessage = $"Soru için geçerli kazanım bulunamadı.";
                        break;
                    }

                    var command = new CreateQuizQuestionCommand
                    {
                        IsAIGenerated = true,
                        RefBenefitId = _selectedBenefitId,
                        LessonId = _selectedLessonId,
                        BenefitIds = benefitIds,
                        QuestionType = question.QuestionType,
                        MaxScore = question.MaximumScore,
                        Score = question.MaximumScore,
                        Stem = question.Stem,
                        Prompt = question.Prompt,
                        QuestionImage = null,
                        QQOptions = optionAppDtos
                    };

                    await _mediator.Send(command);

                    _savedCount++;
                    _saveProgress = (int)((_savedCount / (double)selectedQuestions.Count) * 100);
                    StateHasChanged();

                    await Task.Delay(100);
                }
                catch (Exception ex)
                {
                    _hasError = true;
                    _errorMessage = $"Soru kaydedilirken hata: {ex.Message}";
                    break;
                }
            }

            if (!_hasError)
            {
                _isSuccess = true;
                _extractedQuestions.Clear();
                _selectedQuestionIndices.Clear();
                _selectedFile = null;
            }
        }
        catch (Exception ex)
        {
            _hasError = true;
            _errorMessage = $"Kayıt işlemi sırasında hata: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
            _saveProgress = 0;
            _savedCount = 0;
            StateHasChanged();
        }
    }
}