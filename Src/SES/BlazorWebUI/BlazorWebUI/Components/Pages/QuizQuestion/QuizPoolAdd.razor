@page "/QuizPoolAdd"
@using Application.Features.QuizQuestions.Commands.Create
@using Application.Features.ReferenceBenefits.Queries.GetListByIdReferenceBenefitBenefit
@using BlazorWebUI.Client.Pages.Styles.QQ
@using Application.Features.ReferenceBenefits.Queries.GetById
@using Domain.Enums
@using NArchitecture.Core.Application.Responses
@rendermode InteractiveServer

<PageTitle>Soru Ekle</PageTitle>

<QQBenefitLoader IsVisible="_isVisible" OnLessonId="HandleLessonId" OnSelectedBenefitId="HandleBenefitId" />

<h3>Soru Ekle</h3>

<QQBody OnQQBodyData="HandleQuizPoolAddAsync" CheckboxItems="@CheckboxItems" OnQQBenefitLoader="UpdateQQBenefitLoaderVisibility" />

@inject IMediator _mediator

@code {
    protected override Task OnInitializedAsync()
    {
        _isVisible = true;
        return base.OnInitializedAsync();
    }

    public ICollection<CheckboxItem<int>> CheckboxItems { get; set; } = [];

    private bool _isVisible { get; set; }
    private int _refBenefitId { get; set; }
    private int _lessonId { get; set; }

    private async Task HandleQuizPoolAddAsync(QQBodyDto qQBodyDto)
    {
        ICollection<QuestionOptionAppDto?> optionAppDtos = [];

        if (qQBodyDto.QuestionOptions != null && qQBodyDto.QuestionOptions.Count != 0)
            foreach (QuestionOptionDto optionDto in qQBodyDto.QuestionOptions)
                optionAppDtos.Add(new() { IsCorrect = optionDto.IsCorrect, OptionText = optionDto.OptionText });

        await _mediator.Send(new CreateQuizQuestionCommand()
            {
                RefBenefitId = _refBenefitId,
                LessonId = _lessonId,
                BenefitIds = qQBodyDto.SelectedBenefits.Keys,
                QuestionType = (QuestionType)qQBodyDto.SelectedQType,
                MaxScore = qQBodyDto.MaxScore,
                Score = qQBodyDto.Score,
                QuestionBody = qQBodyDto.Question,
                Question = qQBodyDto.QuestionBody,
                QuestionImage = null,
                QQOptions = optionAppDtos
            });
    }

    private async Task HandleBenefitId(int id)
    {
        _refBenefitId = id;
        GetListResponse<GetListByIdReferenceBenefitBenefitDto> response = await _mediator.Send(new GetListByIdReferenceBenefitBenefitQuery { Id = id });

        foreach (GetListByIdReferenceBenefitBenefitDto rbBenefitDto in response.Items)
            CheckboxItems.Add(new CheckboxItem<int> { Key = rbBenefitDto.Id, DisplayValue = $"{rbBenefitDto.BenefitCode} {rbBenefitDto.Description}" });
    }

    private async Task HandleLessonId(int lessonId)
    {
        _lessonId = lessonId;
        await Task.Yield();
    }

    private async Task UpdateQQBenefitLoaderVisibility(bool isVisible)
    {
        _isVisible = !isVisible;
        await Task.Yield();
    }
}
