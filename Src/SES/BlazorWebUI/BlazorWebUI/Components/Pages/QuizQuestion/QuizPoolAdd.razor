@page "/QuizPoolAdd"
@using Application.Features.QuizQuestions.Commands.Create
@using Application.Features.QuizQuestions.Queries.GetById
@using Application.Features.ReferenceBenefits.Queries.GetListByIdReferenceBenefitBenefit
@using BlazorWebUI.Client.Pages.Styles.QQ
@using Application.Features.ReferenceBenefits.Queries.GetById
@using Application.Services.ImageService;
@using Domain.Enums
@using Microsoft.AspNetCore.Authorization
@using NArchitecture.Core.Application.Responses
@using AutoMapper
@rendermode InteractiveServer
@attribute [Authorize(policy: "QuizPoolAdd")]

<PageTitle>@(_isVariantMode ? "Soru Versiyonu Oluştur" : "Yeni Soru Ekle")</PageTitle>

<div class="page-header mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="mb-1">
                <i class="bi @(_isVariantMode ? "bi-diagram-2" : "bi-plus-circle") me-2"></i>
                @(_isVariantMode ? "Soru Versiyonu Oluştur" : "Yeni Soru Ekle")
            </h2>
            <p class="text-muted mb-0">
                @if (_isVariantMode)
                {
                    <span>Mevcut sorudan yeni bir versiyon oluşturun. Değiştirmek istediğiniz alanları güncelleyin.</span>
                }
                else
                {
                    <span>Soru havuzuna yeni bir soru ekleyin</span>
                }
            </p>
        </div>
        @if (_isVariantMode)
        {
            <div>
                <span class="badge bg-success fs-6 px-3 py-2">
                    <i class="bi bi-diagram-2 me-1"></i>Versiyon Modu
                </span>
            </div>
        }
    </div>
</div>

<QQBenefitLoader IsVisible="_isBenefitLoaderVisible"
                 OnLessonId="HandleLessonId"
                 OnSelectedBenefitId="HandleBenefitId" />

<QQBody OnQQBodyData="HandleQuizPoolAddAsync"
        OnQQBenefitLoader="UpdateBenefitLoaderVisibility"
        CheckboxItems="_checkboxItems"
        IsVariantMode="_isVariantMode"
        VariantData="_variantSourceData" />
<style>
    .page-header {
        animation: fadeIn 0.3s ease-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@inject IMediator _mediator
@inject IImageService _imageService
@inject IMapper _mapper
@inject NavigationManager _navigationManager

@code {
    [SupplyParameterFromQuery(Name = "variant")]
    public bool? IsVariantParam { get; set; }

    [SupplyParameterFromQuery(Name = "previousQuestionId")]
    public int? PreviousQuestionIdParam { get; set; }

    private ICollection<CheckboxItem<int>> _checkboxItems = [];
    private bool _isBenefitLoaderVisible;
    private bool _isVariantMode;
    private int _refBenefitId;
    private int _lessonId;
    private QQBodyDto? _variantSourceData;

    protected override async Task OnInitializedAsync()
    {
        _isVariantMode = IsVariantParam ?? false;
        _isBenefitLoaderVisible = true;

        if (_isVariantMode && PreviousQuestionIdParam.HasValue)
            await LoadPreviousQuestionAsync(PreviousQuestionIdParam.Value);

        await base.OnInitializedAsync();
    }

    private async Task LoadPreviousQuestionAsync(int questionId)
    {
        GetByIdQuizQuestionQuery query = new() { Id = questionId };
        GetByIdQuizQuestionResponse previousQuestion = await _mediator.Send(query);
        _variantSourceData = _mapper.Map<QQBodyDto>(previousQuestion);
    }

    private async Task HandleQuizPoolAddAsync(QQBodyDto bodyDto)
    {

        ICollection<QuestionOptionAppDto?> optionAppDtos = [];

        if (bodyDto.QuestionOptions != null && bodyDto.QuestionOptions.Count != 0)
            foreach (QuestionOptionDto optionDto in bodyDto.QuestionOptions)
                optionAppDtos.Add(new() { IsCorrect = optionDto.IsCorrect, OptionText = optionDto.OptionText });


        string? questionImageId = await ProcessImageAsync(bodyDto);

        await _mediator.Send(new CreateQuizQuestionCommand
        {
            RefBenefitId = _refBenefitId,
            LessonId = _lessonId,
            BenefitIds = bodyDto.SelectedBenefits.Keys,
            QuestionType = (QuestionType)bodyDto.SelectedQType,
            MaxScore = bodyDto.MaxScore,
            Score = bodyDto.Score,
            Stem = bodyDto.Stem,
            Prompt = bodyDto.Prompt,
            QuestionImage = questionImageId,
            QQOptions = optionAppDtos,
            PreviousQuestionId = _isVariantMode ? PreviousQuestionIdParam : null,
            IsAIGenerated = false
        });

        if (_isVariantMode)
            _navigationManager.NavigateTo("/PoolList");
    }

    private async Task<string?> ProcessImageAsync(QQBodyDto bodyDto)
    {

        if (bodyDto.FileData?.MemoryStream != null)
        {
            Dictionary<string, object> uploaded = await _imageService.UploadFileAsync(
                bodyDto.FileData.MemoryStream,
                bodyDto.FileData.FileName,
                CancellationToken.None);
            return uploaded.GetValueOrDefault("id")?.ToString();
        }

        if (_isVariantMode && bodyDto.FileData?.Id != null)
            return bodyDto.FileData.Id;

        return null;
    }

    private async Task HandleBenefitId(int id)
    {
        _refBenefitId = id;
        _checkboxItems.Clear();

        GetListResponse<GetListByIdReferenceBenefitBenefitDto> response =
            await _mediator.Send(new GetListByIdReferenceBenefitBenefitQuery { Id = id });

        foreach (GetListByIdReferenceBenefitBenefitDto benefit in response.Items)
            _checkboxItems.Add(new CheckboxItem<int>
            {
                Key = benefit.Id,
                DisplayValue = $"{benefit.BenefitCode} {benefit.Description}"
            });

        StateHasChanged();
    }

    private void HandleLessonId(int lessonId) => _lessonId = lessonId;
    private void UpdateBenefitLoaderVisibility(bool isVisible) => _isBenefitLoaderVisible = !isVisible;
}
