@using Application.Features.QuizQuestions.Queries.GetByLessonId
@using AutoMapper
@using BlazorWebUI.Client.Pages.Styles.QQ

@rendermode InteractiveServer
@inject IMapper _mapper 
@page "/PoolList"
@code {
    private IList<QQBodyDto> _listOfQQBodyDto { get; set; } = [];

    private void LoadAPool(IList<GetByLessonIdQuizQuestionListItemDto> getByQuizzes)
    {
        _listOfQQBodyDto = _mapper.Map<IList<QQBodyDto>>(getByQuizzes);
    }
}

<QuizPoolLoader OnQQList="LoadAPool"></QuizPoolLoader>


@if (_listOfQQBodyDto.Count != 0)
{
    <div class="form-control">
        @foreach (QQBodyDto quest in _listOfQQBodyDto)
        {
            <QQView QQBody="quest" />
        }
    </div>
}