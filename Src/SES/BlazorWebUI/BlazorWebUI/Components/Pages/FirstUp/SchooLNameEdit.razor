@page "/FirstUp/SchoolName"
@namespace BlazorWebUI.Components.Pages.FirstUp
@using Application.Features.SchoolFeature;

<PageTitle>Okul Ekle</PageTitle>

<h2>Okul Adı</h2>
<h6>burası sadece okul adını düzenlemek için vardır</h6>
<h6>okul adını güncelleyemez, sadece yeni okul adı eklenebilir</h6>
<p></p>

<br />

<div class="input-group mb-3">
    <EditForm method="post" OnValidSubmit="Update" Model="schoolNameForm" FormName="SchoolNameForm">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="input-group mb-3" style="width:35rem;">
            <label class="input-group-text">Okul Adı:</label>
            <InputText type="Text" class="form-control conversion" id="name" style="text-transform:uppercase" @bind-Value="schoolNameForm.SchoolName" />
            <div class="input-group-append">
                <button type="submit" class="btn btn-primary">Kaydet</button>
            </div>
        </div>
    </EditForm>
</div>


<h6>Okulun Önceki adları</h6>
<ul class="list-group" style="width:35rem;">
    @foreach (var school in previousSchoolNames)
    {
        <li class="list-group-item list-group-item-action  @(previousSchoolNames.Keys.Max()==school.Key ? "active" : "")">@school.Value</li>
    }
</ul>


@inject ISchoolService _SchoolService;

@code {

    private class SchoolNameForm
    {
        public string SchoolName { get; set; } = string.Empty;
    }

    [SupplyParameterFromForm]
    private SchoolNameForm schoolNameForm { get; set; } = new();

    private Dictionary<int, string> previousSchoolNames = new();


    protected override async Task OnInitializedAsync()
    {
        if (_SchoolService.IsDbEmpty())
        {
            previousSchoolNames = _SchoolService.GetSchoolNames();
        }
        await base.OnInitializedAsync();
    }

    // schoolNameForm.SchoolName = _SchoolService.GetSchoolName();
    private void Update()
    {
        if (string.IsNullOrWhiteSpace(schoolNameForm.SchoolName))
            return;
        if (previousSchoolNames.ContainsValue(schoolNameForm.SchoolName))
            return;
            // todo: Alert Ekle

        _SchoolService.AddSchool(schoolNameForm.SchoolName);
        previousSchoolNames = _SchoolService.GetSchoolNames();

        schoolNameForm = new();
    }
}
