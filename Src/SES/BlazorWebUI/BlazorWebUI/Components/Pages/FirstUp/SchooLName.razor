@page "/FirstUp/SchoolName"
@namespace BlazorWebUI.Components.Pages.FirstUp
@using Application.Features.Schools.Commands.Create
@using Application.Features.Schools.Queries.GetList
@using NArchitecture.Core.Application.Requests
@using NArchitecture.Core.Application.Responses


<PageTitle>Okul Ekle</PageTitle>

<h2>Okul Adı</h2>
<h6>burası sadece okul adını düzenlemek için vardır</h6>
<h6>okul adını güncelleyemez, sadece yeni okul adı eklenebilir</h6>
<p></p>

<br />

<div class="input-group mb-3">
    <EditForm method="post" OnValidSubmit="Submit" Model="schoolNameForm" FormName="SchoolNameForm">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="input-group mb-3" style="width:35rem;">
            <label class="input-group-text">Okul Adı:</label>
            <InputText type="Text" class="form-control conversion" id="name" style="text-transform:uppercase" @bind-Value="schoolNameForm.SchoolName" />
            <div class="input-group-append">
                <button type="submit" class="btn btn-primary">Kaydet</button>
            </div>
        </div>
    </EditForm>
</div>


<h6>Okulun Önceki adları</h6>
<ul class="list-group" style="width:35rem;">
    @foreach (GetListSchoolListItemDto getListSchoolListItemDto in previousSchoolNames.Items)
    {
        <li class="list-group-item list-group-item-action  @(previousSchoolNames.Items.Select(psn=>psn.Id).Max() == getListSchoolListItemDto.Id ? "active" : "")">@getListSchoolListItemDto.Name</li>

    }
</ul>


@inject IMediator _IMediator;
@code {

    [SupplyParameterFromForm]
    private SchoolNameForm schoolNameForm { get; set; } = new();

    private GetListResponse<GetListSchoolListItemDto> previousSchoolNames = new();


    protected override async Task OnInitializedAsync()
    {
        GetListSchoolQuery getListSchoolQuery = new();
        getListSchoolQuery.PageRequest = new() { PageIndex = 0, PageSize = int.MaxValue };

        var previousSchoolNamesRequest = await _IMediator.Send(getListSchoolQuery);
        previousSchoolNames = previousSchoolNamesRequest;
        previousSchoolNames.Items = previousSchoolNames.Items.OrderByDescending(v => v.Id).ToList();

        await base.OnInitializedAsync();
    }

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(schoolNameForm.SchoolName))
            return;
        if (previousSchoolNames.Items.Any(p => p.Name.Contains(schoolNameForm.SchoolName)))
            return;
        // todo: Alert Ekle

        CreateSchoolCommand command = new() { Name = schoolNameForm.SchoolName.ToUpper() };
        CreatedSchoolResponse response = await _IMediator.Send(command);
        previousSchoolNames.Items.Add(new() { Id = response.Id, Name = response.Name });
    }

    private class SchoolNameForm
    {
        public string SchoolName { get; set; } = string.Empty;
    }

}
