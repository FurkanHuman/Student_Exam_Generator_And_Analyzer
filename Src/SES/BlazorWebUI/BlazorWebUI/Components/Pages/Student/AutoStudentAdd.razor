@*
    todo: CreateMultiStudentCommand needs reafator with PdfReaderService.GetAllClassesAndStudents method and this page working style.
    Now working style is not good. All students and classes are displayed after being added to the database, and the deletion process is carried out.
*@
@page "/Auto/MSAdd"
@using Application.Features.Schools.Queries.GetList
@using Application.Features.Semesters.Queries.GetList
@using Application.Features.StudentClasses.Queries.GetList
@using Application.Features.Students.Commands.Delete
@using Application.Features.Students.Commands.MultiCreate
@using Application.Features.Teachers.Queries.GetList
@using BlazorWebUI.Client.Pages.Styles
@using NArchitecture.Core.Application.Responses
@using MediatR
@rendermode InteractiveServer

<PageTitle>Otomatik Öğrenci Ekle</PageTitle>

<h1>Otomatik öğrenci ekleme</h1>
<div class="mb-5" />
<div class="input-group mb-3">

    <EditForm OnValidSubmit="AddAutoStudent" method="post" enctype="multipart/form-data" Model="_multiStudentDto" FormName="StudentMultiAdd">

        <DataAnnotationsValidator />
        <ValidationSummary />
        <AntiforgeryToken />

        <div class="input-group mb-3" style="width:15rem;">
            <label class="input-group-text">Okul :</label>
            <InputSelect class="form-select" id="schoolDD" @bind-Value="_multiStudentDto.SchoolId">
                @foreach (GetListSchoolListItemDto school in _schoolListResponse.Items)
                {
                    <option value="@school.Id">@school.Name</option>
                }
            </InputSelect>
        </div>

        <div class="input-group mb-3" style="width:15rem;">
            <label class="input-group-text">Dönem :</label>
            <InputSelect class="form-select" id="schoolSemester" @bind-Value="_multiStudentDto.SemesterId">
                @foreach (GetListSemesterListItemDto semester in _semesterResponse.Items)
                {
                    <option value="@semester.Id">@semester.BeginSemesterDate @semester.EndSemesterDate @semester.Name</option>
                }
            </InputSelect>
        </div>

        <div class="input-group mb-3" style="width:15rem;">
            <label class="input-group-text">Öğretmen :</label>
            <InputSelect class="form-select" id="teacher" @bind-Value="_multiStudentDto.TeacherId">
                @foreach (GetListTeacherListItemDto teacher in _teacherResponse.Items)
                {
                    <option value="@teacher.Id">@teacher.Name @teacher.SurName</option>
                }
            </InputSelect>
        </div>

        <div class="input-group mb-3" style="width:20rem;">
            <label class="input-group-text">Öğrenci Dosyası :</label>
            <InputFile type="file" name="FileFromPdf" class="form-control" accept=".pdf" OnChange="FileToMemoryAsync" />

        </div>

        <div class="mb-3">
            <button type="submit" class="btn btn-primary text-lg-end">Kaydet</button>
        </div>

    </EditForm>

</div>

@if (_createdMultiStudents.Count > 0)
{
    <div class="container mt-4">

        <h2> Eklenen Öğrenci Bilgileri Tablosu</h2>
        <table class="table table-bordered table-striped">
            <thead class="table-light">
                <tr>
                    <th>Öğrenci No</th>
                    <th>Ad</th>
                    <th>Soyad</th>
                    <th>Sınıf</th>
                    <th>Işlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (CreatedMultiStudentResponse st in _createdMultiStudents)
                {
                    <tr>
                        <td>@st.SchoolNumber</td>
                        <td>@st.Name</td>
                        <td>@st.SurName</td>
                        <td>@st.ClassAge/@st.ClassBranch</td>
                        <td>
                            <button class="btn btn-danger" @onclick="() => DeleteStudent(st.Id)">Sil</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<ModalDialog @ref="_modalStatus" Title="Eklendi">
    <div style="background-color: #d4edda; color: #155724; padding: 1rem; border-radius: 0.25rem;">
        <p>Öğrenciler başarıyla eklendi</p>
        <p>Dikkat: Silinen öğrenciler sistemden geri döndürülemeyecek şekilde kalıcı olarak silinir.</p>
        <button class="btn btn-primary" @onclick="() => _modalStatus.Close()">Kapat</button>
    </div>
</ModalDialog>


@inject IMediator _mediator

@code {
    [SupplyParameterFromForm]
    private MultiStudentDto _multiStudentDto { get; set; } = new()
    { TeacherId = 0, SchoolId = 0, SemesterId = 0 };

    private byte[] _fileContent = Array.Empty<byte>();

    GetListResponse<GetListSchoolListItemDto> _schoolListResponse = new();
    GetListResponse<GetListSemesterListItemDto> _semesterResponse = new();
    GetListResponse<GetListTeacherListItemDto> _teacherResponse = new();
    GetListResponse<GetListStudentClassListItemDto> _studentClassResponse = new();
    ICollection<CreatedMultiStudentResponse> _createdMultiStudents = [];

    private ModalDialog _modalStatus { get; set; } = new();

    private async Task DeleteStudent(int studentId)
    {
        await _mediator.Send(new DeleteStudentCommand { Id = studentId, PermanentDelete = true });

        _createdMultiStudents = _createdMultiStudents.Where(st => st.Id != studentId).ToList();
    }
    protected override async Task OnInitializedAsync()
    {
        _schoolListResponse = await _mediator.Send(new GetListSchoolQuery()
        {
            PageRequest = new()
            {
                PageIndex = 0,
                PageSize = int.MaxValue
            }
        });

        _semesterResponse = await _mediator.Send(new GetListSemesterQuery()
        {
            PageRequest = new()
            {
                PageIndex = 0,
                PageSize = int.MaxValue
            }
        });

        _teacherResponse = await _mediator.Send(new GetListTeacherQuery()
        {
            PageRequest = new()
            {
                PageIndex = 0,
                PageSize = int.MaxValue
            }
        });

        _studentClassResponse = await _mediator.Send(new GetListStudentClassQuery()
        {
            PageRequest = new()
            {
                PageIndex = 0,
                PageSize = int.MaxValue
            }
        });

        await base.OnInitializedAsync();
    }


    private async Task FileToMemoryAsync(InputFileChangeEventArgs e)
    {
        IBrowserFile fileFromPdf = e.File;
        if (fileFromPdf.Size == 0)
            return;

        using MemoryStream memoryStream = new();
        await fileFromPdf.OpenReadStream().CopyToAsync(memoryStream);
        _fileContent = memoryStream.ToArray();
    }

    private async Task AddAutoStudent()
    {
        CreateMultiStudentCommand createMultiStudentCommand = new()
        {
            PdfFile = _fileContent,
            RefTeacherId = _multiStudentDto.TeacherId,
            SchoolId = _multiStudentDto.SchoolId,
            SemesterId = _multiStudentDto.SemesterId,
        };

        _createdMultiStudents = await _mediator.Send(createMultiStudentCommand);

        _modalStatus.Open();
    }

    private record MultiStudentDto
    {
        public required int SchoolId { get; set; }
        public required int TeacherId { get; set; }
        public required int SemesterId { get; set; }
    }
}
