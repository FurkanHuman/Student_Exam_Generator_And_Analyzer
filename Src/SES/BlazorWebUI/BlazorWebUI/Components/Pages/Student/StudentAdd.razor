@*todo: The error of not being able to add non-existent classes will be fixed.*@
@page "/StudentAdd"
@using Application.Features.Schools.Queries.GetList
@using Application.Features.Semesters.Queries.GetList
@using Application.Features.Students.Commands.Create
@using Application.Features.Students.Queries.GetList
@using BlazorWebUI.Client.Pages.Styles
@using NArchitecture.Core.Application.Responses

<PageTitle>Öğrenci Ekle</PageTitle>

<h3>Tekli öğrenci Ekleme</h3>

<br />
<div class="input-group mb-3">

    <EditForm method="post" OnValidSubmit="Submit" Model="_studentForm" FormName="StudentSingleAdd">

        <DataAnnotationsValidator />
        <ValidationSummary />
        <AntiforgeryToken />

        <div class="input-group mb-3" style="width:12rem;">
            <label class="input-group-text">Okul :</label>
            <InputSelect class="form-select" id="schoolDD" @bind-Value="_studentForm.SchoolId">
                <option selected>Seçiniz...</option>
                @foreach (GetListSchoolListItemDto school in _schoolResponse.Items)
                {
                    <option value="@school.Id">@school.Name</option>
                }
            </InputSelect>
        </div>

        <div class="input-group mb-3" style="width:12rem;">
            <label class="input-group-text">Dönem :</label>
            <InputSelect class="form-select" id="schoolSemester" @bind-Value="_studentForm.SemesterId">
                <option selected>Seçiniz...</option>
                @foreach (GetListSemesterListItemDto semester in _semesterResponse.Items)
                {
                    <option value="@semester.Id">@semester.BeginSemesterDate @semester.EndSemesterDate @semester.Name</option>
                }
            </InputSelect>
        </div>

        <div class="input-group mb-3" style="width:12rem;">
            <label class="input-group-text">Sınıf :</label>
            <InputSelect class="form-select" id="classAge" @bind-Value="_studentForm.ClassAge">
                <option selected>Seçiniz...</option>
                @for (int classAge = 0; classAge <= 12; classAge++)
                {
                    <option value="@classAge">@classAge</option>
                }
            </InputSelect>
        </div>

        <div class="input-group mb-3" style="width:12rem;">

            <label class="input-group-text">Alt Sınıf :</label>
            <InputSelect class="form-select" id="altClasss" @bind-Value="_studentForm.ClassBranch">
                <option selected>Seçiniz...</option>
                @for (char altClassAge = 'A'; altClassAge <= 'Z'; altClassAge++)
                {
                    <option value="@altClassAge">@altClassAge</option>
                }
            </InputSelect>
        </div>

        <div class="input-group mb-3" style="width:12rem;">
            <label class="input-group-text">Cinsiyet :</label>
            <InputSelect class="form-select" id="gender" @bind-Value="_studentForm.Gender">
                <option selected>Seçiniz...</option>
                <option value="K">Kız</option>
                <option value="E">Erkek</option>
            </InputSelect>
        </div>

        <div class="input-group mb-3" style="width:15rem;">
            <label class="input-group-text">Okul Numarası :</label>
            <InputText type="Text" class="form-control" id="schoolNumber" @bind-Value="_studentForm.SchoolNumber" />
        </div>

        <div class="input-group mb-3" style="width:15rem;">
            <label class="input-group-text">Adı :</label>
            <InputText type="Text" class="form-control" id="name" @bind-Value="_studentForm.Name" />
        </div>

        <div class="input-group mb-3" style="width:15rem;">
            <label class="input-group-text">Soyadı : </label>
            <InputText type="Text" class="form-control" id="surname" @bind-Value="_studentForm.SurName" />
        </div>
        <div class="input-group mb-3" style="width:15rem;">
            <label class="input-group-text">Açıklama : </label>
            <InputTextArea type="Text" class="form-control" id="surname" @bind-Value="_studentForm.Description" />
        </div>

        <div class="input-group mb-3" style="width:15rem;">
            <button type="submit" class="btn btn-primary">Kaydet</button>
        </div>

    </EditForm>
</div>

<ModalDialog @ref="_modalStatus" Title="Eklendi">
    <div style="background-color: #d4edda; color: #155724; padding: 1rem; border-radius: 0.25rem;">
        <p>Öğrenci başarıyla eklendi</p>
        <button class="btn btn-primary" @onclick="() => _modalStatus.Close()">Kapat</button>
    </div>
</ModalDialog>

@inject IMediator _mediator

@code {
    [SupplyParameterFromForm]
    StudentCreateForm _studentForm { get; set; } = new();

    GetListResponse<GetListSchoolListItemDto> _schoolResponse = new();
    GetListResponse<GetListSemesterListItemDto> _semesterResponse = new();

    private ModalDialog _modalStatus { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        _schoolResponse = await _mediator.Send(new GetListSchoolQuery()
            {
                PageRequest = new()
                {
                    PageIndex = 0,
                    PageSize = int.MaxValue
                }
            });

        _semesterResponse = await _mediator.Send(new GetListSemesterQuery()
            {
                PageRequest = new()
                {
                    PageIndex = 0,
                    PageSize = int.MaxValue
                }
            });
        await base.OnInitializedAsync();
    }

    private async Task Submit()
    {
        CreateStudentCommand createStudentCommand = new()
            {
                Name = _studentForm.Name,
                SurName = _studentForm.SurName,
                ClassAge = _studentForm.ClassAge,
                ClassBranch = _studentForm.ClassBranch,
                SchoolNumber = _studentForm.SchoolNumber,
                Gender = _studentForm.Gender,
                Description = _studentForm.Description,
                SchoolId = _studentForm.SchoolId,
                SemesterId = _studentForm.SemesterId
            };

        CreatedStudentResponse response = await _mediator.Send(createStudentCommand);
        _modalStatus.Open();
        _studentForm = new();
    }

    public class StudentCreateForm
    {
        public string Name { get; set; }

        public string SurName { get; set; }

        public string SchoolNumber { get; set; }

        public int ClassAge { get; set; }

        public char ClassBranch { get; set; }

        public char Gender { get; set; }

        public string? Description { get; set; }

        public int SchoolId { get; set; }

        public int SemesterId { get; set; }
    }
}
