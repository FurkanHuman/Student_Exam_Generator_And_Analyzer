@page "/LessonAdd"

@using Application.Features.Lessons.Commands.Create
@using Application.Features.Semesters.Queries.GetList
@using NArchitecture.Core.Application.Responses

<PageTitle>Ders Ekle</PageTitle>

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-lg-8 col-xl-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="fas fa-book-open mr-2"></i>Yeni Ders Ekle</h4>
                </div>
                <div class="card-body">
                    @if (_isLoading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="sr-only">Yükleniyor...</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <EditForm Model="_lessonForm" FormName="LessonAddForm" OnValidSubmit="OnSubmitAsync">
                            <DataAnnotationsValidator />
                            <AntiforgeryToken />

                            @if (_successMessage != null)
                            {
                                <div class="alert alert-success alert-dismissible fade show" role="alert">
                                    <i class="fas fa-check-circle mr-2"></i>@_successMessage
                                    <button type="button" class="close" @onclick="() => _successMessage = null">
                                        <span>&times;</span>
                                    </button>
                                </div>
                            }

                            <div class="form-group">
                                <label for="name" class="font-weight-bold">Ders Adı <span class="text-danger">*</span></label>
                                <InputText class="form-control" id="name" placeholder="Örn: MATEMATİK"
                                           style="text-transform:uppercase" @bind-Value="_lessonForm.Name" />
                                <ValidationMessage For="@(() => _lessonForm.Name)" class="text-danger small" />
                            </div>

                            <div class="form-group">
                                <label for="description" class="font-weight-bold">Açıklama <span class="text-danger">*</span></label>
                                <InputText class="form-control" id="description" placeholder="Ders hakkında kısa açıklama"
                                           style="text-transform:uppercase" @bind-Value="_lessonForm.Description" />
                                <ValidationMessage For="@(() => _lessonForm.Description)" class="text-danger small" />
                            </div>

                            <div class="form-row">
                                <div class="form-group col-md-6">
                                    <label for="semester" class="font-weight-bold">Dönem <span class="text-danger">*</span></label>
                                    <InputSelect class="form-control" id="semester" @bind-Value="_lessonForm.SemesterId">
                                        <option value="0">-- Dönem Seçiniz --</option>
                                        @foreach (var semester in _getListSemester.Items)
                                        {
                                            <option value="@semester.Id">
                                                @semester.BeginSemesterDate.Year - @semester.EndSemesterDate.Year | @semester.Name
                                            </option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => _lessonForm.SemesterId)" class="text-danger small" />
                                </div>

                                <div class="form-group col-md-6">
                                    <label for="classAge" class="font-weight-bold">Sınıf <span class="text-danger">*</span></label>
                                    <InputSelect class="form-control" id="classAge" @bind-Value="_lessonForm.ClassAge">
                                        <option value="0">-- Sınıf Seçiniz --</option>
                                        @for (byte i = 1; i <= 12; i++)
                                        {
                                            <option value="@i">@i. Sınıf</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => _lessonForm.ClassAge)" class="text-danger small" />
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-group col-md-6">
                                    <label for="passingScore" class="font-weight-bold">Geçme Notu</label>
                                    <InputNumber class="form-control" id="passingScore" min="0" max="100"
                                                 @bind-Value="_lessonForm.PassingScore" />
                                    <small class="form-text text-muted">0-100 arası değer giriniz</small>
                                </div>

                                <div class="form-group col-md-6">
                                    <label class="font-weight-bold d-block">Ders Durumu</label>
                                    <div class="custom-control custom-switch mt-2">
                                        <InputCheckbox class="custom-control-input" id="isMandatory"
                                                       @bind-Value="_lessonForm.IsMandatory" />
                                        <label class="custom-control-label" for="isMandatory">
                                            @(_lessonForm.IsMandatory ? "Zorunlu Ders" : "Seçmeli Ders")
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <hr class="my-4" />

                            <div class="d-flex justify-content-between align-items-center">
                                <button type="button" class="btn btn-outline-secondary" @onclick="ResetForm">
                                    <i class="fas fa-redo mr-1"></i>Formu Temizle
                                </button>
                                <button type="submit" class="btn btn-primary px-4" disabled="@_isSubmitting">
                                    @if (_isSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm mr-2" role="status"></span>
                                        <span>Kaydediliyor...</span>
                                    }
                                    else
                                    {
                                        <i class="fas fa-save mr-2"></i>
                                        <span>Kaydet</span>
                                    }
                                </button>
                            </div>

                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@inject IMediator _Mediator

@code {
    [SupplyParameterFromForm]
    private LessonDto _lessonForm { get; set; } = new() { Name = string.Empty, Description = string.Empty };

    private GetListResponse<GetListSemesterListItemDto> _getListSemester = new();
    private bool _isLoading = true;
    private bool _isSubmitting = false;
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        GetListSemesterQuery getListSemesterQuery = new()
        {
            PageRequest = new() { PageIndex = 0, PageSize = int.MaxValue }
        };

        _getListSemester = await _Mediator.Send(getListSemesterQuery);

        if (_getListSemester.Items.Any())
        {
            _lessonForm.SemesterId = _getListSemester.Items[_getListSemester.Count - 1].Id;
        }

        _isLoading = false;

        await base.OnInitializedAsync();
    }

    private async Task OnSubmitAsync()
    {
        _isSubmitting = true;
        _successMessage = null;

        CreateLessonCommand createLesson = new()
        {
            LessonName = _lessonForm.Name,
            Description = _lessonForm.Description,
            SemesterId = _lessonForm.SemesterId,
            ClassAge = _lessonForm.ClassAge,
            PassingScore = _lessonForm.PassingScore,
            IsMandatory = _lessonForm.IsMandatory
        };

        await _Mediator.Send(createLesson);
        _successMessage = "Ders başarıyla eklendi!";
        ResetForm();

        _isSubmitting = false;
    }

    private void ResetForm()
    {
        _lessonForm = new() { Name = string.Empty, Description = string.Empty };
        if (_getListSemester.Items.Any())
        {
            _lessonForm.SemesterId = _getListSemester.Items[_getListSemester.Count - 1].Id;
        }
    }

    private sealed class LessonDto
    {
        public required string Name { get; set; }
        public int PassingScore { get; set; } = 50;
        public bool IsMandatory { get; set; } = false;
        public required string Description { get; set; }
        public int ClassAge { get; set; }
        public int SemesterId { get; set; }
    }
}