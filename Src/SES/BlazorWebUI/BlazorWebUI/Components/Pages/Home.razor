@page "/"
@using Application.Services.Personels
@using BlazorWebUI.Components.Account
@using Domain.Entities
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity

<PageTitle>Hoş geldiniz</PageTitle>
<div class="alert alert-info" style="margin-top: 2rem;">
    <h4>Bilgilendirme</h4>
    <ul>
        <li><strong>Bu platform şu anda bir <span style="color: #0f7bff;">demo</span> sürümüdür.</strong></li>
        <li>Kullanım sırasında <span style="color: #dc3545;">hata</span> ya da eksiklerle karşılaşmanız mümkündür.</li>
        <li>Platformu <strong>tek başıma</strong> geliştiriyorum. Bu nedenle bazı geliştirmeler zaman alabilir.</li>
        <li>Yakında <strong>çoklu dil desteği</strong>, <strong>e-ödev</strong>, <strong>e-sınav</strong> ve <strong>analiz</strong> gibi yeni özellikler sisteme eklenecek.</li>
        <li>Ayrıca <strong>Yapay Zeka</strong> desteğiyle sınav analizleri, soru üretimi ve ödevlerde rehberlik gibi akıllı işlevler sunulacak. Sistem zamanla öğrenci davranışlarını daha iyi anlayacak ve buna göre gelişen bir yapıya sahip olacak.</li>
        <li>Bu platform, <strong>merkeziyetsiz</strong> yapısıyla her okulun kendi verisi üzerinde tam denetim sahibi olmasını sağlar. Veri güvenliği ve yerel kontrol ön plandadır.</li>
    </ul>
    <p style="margin-top: 1rem;">
        Geri bildirimleriniz benim için çok değerli. Sürece gösterdiğiniz anlayış ve sabır için teşekkür ederim.
    </p>
    <p style="margin-top: 0.5rem;">
        Eğer projeye katkıda bulunmak ya da destek olmak isterseniz, yukarıdaki <strong>GitHub</strong> bağlantısı üzerinden projeye katılabilir veya <strong>Destek Ol</strong> butonunu kullanabilirsiniz. Küçük bir destek bile büyük bir fark yaratabilir.
    </p>
</div>

<AuthorizeView>
    Hoş Geldiniz...
    <br />
    @(GetMessage())
</AuthorizeView>



@inject IPersonelService _personelService
@inject UserManager<ApplicationUser> _userManager

@code {
    private ApplicationUser? user = default!;
    private Personel? personel { get; set; } = default!;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        user = await _userManager.GetUserAsync(HttpContext.User);
        if (user == null)
            return;
        personel = await _personelService.GetByIdAsync(user!.PersonelId);
    }

    private string GetMessage()
    {
        switch (personel, user)
        {
            case (null, null) :
                return string.Empty;

            case (Personel p, ApplicationUser u) when p.BirthDate == DateOnly.FromDateTime(DateTime.Now):
                return $"Mutlu Yıllar, Merhaba {p.Name} {p.SurName}";

            case (Personel p, ApplicationUser u) when p == null && u != null:
                return $"Merhaba {u.Email} Lütfen Sistem Yöneticiniz ile İletişime geçin. Personel Bilgisi Bulunamadı";

            default:
                return $"Merhaba {personel!.Name} {personel!.SurName}";
        }
    }
}