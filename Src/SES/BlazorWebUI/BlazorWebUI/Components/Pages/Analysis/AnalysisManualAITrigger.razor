@page "/Analysis/Trigger/AI"
@rendermode InteractiveServer
@using Application.Features.Analyses.Commands.UpdateAIRequest
@using Application.Features.Analyses.Queries.GetList
@using Application.Services.AIService
@using BlazorWebUI.Components.Shared
@using NArchitecture.Core.Application.Requests
@using NArchitecture.Core.Application.Responses

<PageTitle>Analiz Yapay Zeka Tetikleyici</PageTitle>

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h3 class="text-primary mb-3">
                <i class="bi bi-robot"></i> AI Analiz Tetikleyici
            </h3>
            <p class="text-muted">Analizler için yapay zeka sağlayıcısı ve model seçerek AI analizi başlatın</p>
        </div>
    </div>

    @if (_analysisList.Items.Count == 0)
    {
        <div class="alert alert-info d-flex align-items-center" role="alert">
            <i class="bi bi-info-circle-fill me-3" style="font-size: 2rem;"></i>
            <div>
                <h5 class="alert-heading mb-2">AI Analizi Bekleyen Analiz Bulunamadı</h5>
                <p class="mb-0">Tüm analizler için AI analizi tamamlanmış veya henüz analiz oluşturulmamış.</p>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (GetListAnalysisListItemDto analysis in _analysisList.Items)
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-lg-4">
                                <h5 class="mb-2">
                                    <i class="bi bi-clipboard-data text-primary"></i>
                                    @analysis.Name
                                </h5>
                                <p class="mb-1 text-muted">
                                    <i class="bi bi-book"></i> @analysis.LessonName
                                </p>
                                <p class="mb-0 small text-muted">
                                    <i class="bi bi-calendar-range"></i>
                                    @analysis.SemesterStartDate.ToString("dd.MM.yyyy") - @analysis.SemesterEndDate.ToString("dd.MM.yyyy")
                                </p>
                            </div>
                            <div class="col-lg-6">
                                <AIModelSelector IsDisabled="false"
                                                 @bind-SelectedProvider="_selectedProviders[analysis.Id]"
                                                 @bind-SelectedModel="_selectedModels[analysis.Id]" />
                            </div>
                            <div class="col-lg-2 text-end">
                                <button class="btn btn-primary w-100"
                                        @onclick="@(() => Trigger(analysis.Id))"
                                        disabled="@IsTriggerButtonDisabled(analysis.Id)">
                                    <i class="bi bi-lightning-charge-fill"></i> Tetikle
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Inject]
    private IMediator _mediator { get; set; } = default!;

    private GetListResponse<GetListAnalysisListItemDto> _analysisList { get; set; } = new();

    private Dictionary<string, string> _aiProviders = new();
    private Dictionary<string, Dictionary<string, string>> _providerModels = new();
    private Dictionary<int, string> _selectedProviders { get; set; } = new();
    private Dictionary<int, string> _selectedModels { get; set; } = new();
    private string _selectedAIProvider { get; set; } = string.Empty;
    private string _selectedAIModel { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        LoadAIModels();

        PageRequest pg = new() { PageIndex = 0, PageSize = int.MaxValue };
        _analysisList = await _mediator.Send(new GetListAnalysisQuery { PageRequest = pg });
        _analysisList.Items = _analysisList.Items.Where(a => !a.HasAiResponse).ToList();

        foreach (int id in _analysisList.Items.Select(a => a.Id))
        {
            _selectedProviders[id] = string.Empty;
            _selectedModels[id] = string.Empty;
        }
    }

    private void LoadAIModels()
    {
        _aiProviders = AIModelsLoader.GetAIProviders();
        _providerModels = AIModelsLoader.GetProviderModels();

    }

    private void OnProviderChanged(int analysisId)
    {
        if (_selectedModels.ContainsKey(analysisId))
            _selectedModels[analysisId] = string.Empty;
    }

    private Dictionary<string, string> GetModelsForProvider(string provider)
    {
        return _providerModels.ContainsKey(provider)
            ? _providerModels[provider]
            : new Dictionary<string, string>();
    }

    private bool IsModelDropdownDisabled(int analysisId)
    {
        return !_selectedProviders.ContainsKey(analysisId) || string.IsNullOrEmpty(_selectedProviders[analysisId]);
    }

    private bool IsTriggerButtonDisabled(int analysisId)
    {
        return !_selectedProviders.ContainsKey(analysisId)
            || string.IsNullOrEmpty(_selectedProviders[analysisId])
            || !_selectedModels.ContainsKey(analysisId)
            || string.IsNullOrEmpty(_selectedModels[analysisId]);
    }

    private bool CanTrigger(int analysisId)
    {
        return !IsTriggerButtonDisabled(analysisId);
    }

    private async Task Trigger(int id)
    {
        if (!CanTrigger(id))
            return;

        UpdateAIRequestAnalysisCommand command = new()
        {
            Id = id,
            Provider = _selectedProviders[id],
            Model = _selectedModels[id]
        };

        await _mediator.Send(command);

        GetListAnalysisListItemDto? analysis = _analysisList.Items.FirstOrDefault(a => a.Id == id);
        if (analysis != null)
            _analysisList.Items.Remove(analysis);

        _selectedProviders.Remove(id);
        _selectedModels.Remove(id);
    }
}