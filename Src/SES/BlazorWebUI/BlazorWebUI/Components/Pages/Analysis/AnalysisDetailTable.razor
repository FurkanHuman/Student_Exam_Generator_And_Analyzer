@using Application.Services.CalculatorFactory


@if (DetailTableData != null && DetailTableData.Any())
{
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 pt-4 pb-3">
                    <h5 class="text-primary mb-0">
                        <i class="bi bi-table"></i> Öğrenci Detay Tablosu
                    </h5>
                </div>
                <div class="card-body p-0">

                    @foreach (AnalysisDetailTableDto examData in DetailTableData)
                    {
                        <div class="mb-4">
                            <div class="bg-light border-bottom p-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <small class="text-muted">
                                            <i class="bi bi-question-circle"></i> Toplam Soru Sayısı: @examData.QuestionCount
                                        </small>
                                    </div>
                                </div>
                            </div>
                            <div class="p-0">
                                <div class="table-responsive">
                                    <table class="table table-bordered table-hover table-sm mb-0">
                                        <thead class="table-dark sticky-top">
                                            <tr>
                                                <th class="text-center align-middle" style="min-width: 5rem;">Ö. No</th>
                                                <th class="align-middle" style="min-width: 12.5rem;">Ad + Soyad</th>
                                                @for (int i = 1; i <= examData.QuestionCount; i++)
                                                {
                                                    <th class="text-center align-middle" style="min-width: 3.125rem;">S@(i)</th>
                                                }
                                                <th class="text-center align-middle bg-warning text-dark" style="min-width: 6.25rem;">Toplam</th>
                                                <th class="text-center align-middle bg-info text-dark" style="min-width: 7.5rem;">Durum</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (StudentTableDto student in examData.Students)
                                            {
                                                int totalScore = student.StudentAnswerScores.Sum(s => s.GivenScore);
                                                (bool IsPassed, string Status) passFail = GetPassFailStatus(totalScore);

                                                <tr class="align-middle @GetRowClass(totalScore)">
                                                    <td class="text-center fw-semibold">@student.SchoolNumber</td>
                                                    <td class="fw-medium">@student.Name @student.Surname</td>
                                                    @foreach (int score in student.StudentAnswerScores.Select(sas => sas.GivenScore))
                                                    {
                                                        <td class="text-center">
                                                            <span class="badge @GetScoreBadgeClass(score) fs-6 px-2 py-1">
                                                                @score
                                                            </span>
                                                        </td>
                                                    }
                                                    <td class="text-center">
                                                        <span class="badge bg-warning text-dark fs-5 px-3 py-2 fw-bold">
                                                            @totalScore
                                                        </span>
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="badge @GetStatusBadgeClass(passFail.Status) fs-5 px-3 py-2">
                                                            @passFail.Status
                                                        </span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public IList<AnalysisDetailTableDto>? DetailTableData { get; set; }

    [Parameter]
    public int PassingScore { get; set; }

    private string GetRowClass(int totalScore)
    {
        return totalScore switch
        {
            >= 85 => "table-success",
            >= 70 => "table-primary",
            >= 60 => "table-info",
            >= 50 => "table-warning",
            _ => "table-danger"
        };
    }

    private string GetScoreBadgeClass(int score)
    {
        return score switch
        {
            >= 8 => "bg-success text-white",
            >= 6 => "bg-primary text-white",
            >= 4 => "bg-info text-white",
            >= 2 => "bg-warning text-dark",
            _ => "bg-danger text-white"
        };
    }

    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Pek iyi" => "bg-success text-white",
            "İyi" => "bg-primary text-white",
            "Orta" => "bg-info text-white",
            "Geçer" => "bg-warning text-dark",
            _ => "bg-danger text-white"
        };
    }

    private (bool IsPassed, string Status) GetPassFailStatus(int totalScore)
    {
        return totalScore switch
        {
            >= 85 => (true, "Pek iyi"),
            >= 70 => (true, "İyi"),
            >= 60 => (true, "Orta"),
            int s when s >= 50 => (true, "Geçer"),
            _ => (false, "Geçmez")
        };
    }
}

<style>
    .table-sm td, .table-sm th {
        padding: 0.5rem;
        vertical-align: middle;
    }

    .table thead th {
        box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,0.1);
    }

    .table-responsive {
        max-height: 75vh;
        overflow-y: auto;
    }

    .table-hover tbody tr {
        transition: background-color 0.2s ease;
    }

        .table-hover tbody tr:hover {
            background-color: rgba(0,0,0,0.05);
        }
</style>
