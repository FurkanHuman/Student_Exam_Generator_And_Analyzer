@using Application.Services.CalculatorFactory
@using BlazorWebUI.Components.Pages.Analysis.Charts

@if (AdvancedData != null && ClusteredStudents != null)
{
    <div class="row mb-4">
        <div class="col-12">
            <h4 class="mb-3 text-primary">
                <i class="bi bi-graph-up"></i> Gelişmiş Analiz Grafikleri
            </h4>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-12">
            <BoxPlotChart StudentScores="@AdvancedData.StudentScores" />
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-12">
            <QuestionHeatmap QuestionAverages="@AdvancedData.QuestionAverages"
                             MaxScore="10" />
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-12">
            <StackedBarChart QuestionStats="@AdvancedData.QuestionStats" />
        </div>
    </div>


    <div class="row g-4 mb-4">
        <div class="col-lg-12">
            <StudentClusteringChart ClusteredData="@ClusteredStudents" />
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-12">
            <PerformanceScatterPlot Students="@AdvancedData.PerformanceData" />
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-12">
            <ParallelCoordinatesChart StudentProfiles="@AdvancedData.ParallelData" />
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-12">
            <AnalysisBenefitRadarChart RadarData="RadarData" />
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        Grafik verileri hazırlanıyor, lütfen bekleyiniz...
    </div>
}

@code {
    [Parameter]
    public AdvancedStatisticsData? AdvancedData { get; set; }

    [Parameter]
    public List<List<StudentPerformanceDto>>? ClusteredStudents { get; set; }

    [Parameter]
    public BenefitRadarResultDto? RadarData { get; set; }
}
