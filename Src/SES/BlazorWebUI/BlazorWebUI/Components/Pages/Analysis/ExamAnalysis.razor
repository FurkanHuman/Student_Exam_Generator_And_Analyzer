@page "/sinav-analizi"
@using System.ComponentModel.DataAnnotations
@using BlazorWebUI.Components.Layout
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer
@layout FullScreenLayout

<div class="container my-4">
    <div class="alert alert-warning text-center" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>
        Bu sayfa, yalnızca <strong>örnek amaçlı</strong> hazırlanmıştır. Nihai sürümde içerik ve yapı değişebilir.

    </div>
</div>



<div class="container-fluid py-4 print-container">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center bg-primary text-white">
                    <h2 class="mb-1">@examInfo.Period - @examInfo.SchoolName</h2>
                    <h4 class="mb-0">@examInfo.Subject - @examInfo.Grade - Dönem Analizi</h4>
                </div>
            </div>
        </div>
    </div>

    <!-- Bölüm 1: Genel İstatistikler -->
    <div class="row mb-4">
        <div class="col-12">
            <h4 class="mb-3 text-primary">📊 Genel İstatistikler</h4>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center bg-info text-white">
                    <h5 class="card-title">Sınava Giren</h5>
                    <h2 class="mb-0">@statistics.AttendeesCount</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center bg-warning text-white">
                    <h5 class="card-title">Sınava Girmeyen</h5>
                    <h2 class="mb-0">@statistics.AbsenteesCount</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center bg-success text-white">
                    <h5 class="card-title">Başarılı</h5>
                    <h2 class="mb-0">@statistics.PassedCount</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center bg-danger text-white">
                    <h5 class="card-title">Başarısız</h5>
                    <h2 class="mb-0">@statistics.FailedCount</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Bölüm 2: Öğrenci Detay Tablosu -->
    <div class="row mb-4">
        <div class="col-12">
            <h4 class="mb-3 text-primary">📋 Öğrenci Detay Tablosu</h4>
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-info">
                                <tr>
                                    <th>Sıra No</th>
                                    <th>Öğrenci No</th>
                                    <th>Adı</th>
                                    <th>Soyadı</th>
                                    @for (int i = 1; i <= examInfo.QuestionCount; i++)
                                    {
                                        <th class="text-center">@i</th>
                                    }
                                    <th class="text-center">Toplam</th>
                                    <th class="text-center">Durum</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var student in students)
                                {
                                    <tr class="@GetRowBackgroundClass(student.TotalScore)">
                                        <td>@student.RowNumber</td>
                                        <td>@student.StudentNumber</td>
                                        <td>@student.FirstName</td>
                                        <td>@student.LastName</td>
                                        @for (int i = 0; i < examInfo.QuestionCount; i++)
                                        {
                                            <td class="text-center">
                                                <span class="badge @GetScoreBadgeClass(student.QuestionScores[i]) fs-6 px-2 py-1">
                                                    @student.QuestionScores[i]
                                                </span>
                                            </td>
                                        }
                                        <td class="text-center">
                                            <span class="badge @GetScoreBadgeClass(student.TotalScore) fs-5 px-3 py-2">
                                                @student.TotalScore.ToString()
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge @GetStatusBadgeClass(student.Status) fs-5 px-3 py-2">
                                                @student.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Soru Başına Sınıf Ortalaması -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title text-primary mb-3">📈 Soru Başına Sınıf Ortalaması</h5>
                    <div class="row">
                        @for (int i = 0; i < examInfo.QuestionCount; i++)
                        {
                            <div class="col-md-2 col-sm-3 col-4 mb-2">
                                <div class="text-center">
                                    <small class="text-muted">Soru @(i + 1)</small>
                                    <div class="badge @GetScoreBadgeClass(questionAverages[i]) fs-5 px-2 py-1 d-block">
                                        @questionAverages[i].ToString("F2")
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <hr>
                    <div class="text-center">
                        <h6 class="mb-1">Sınıf Ortalaması</h6>
                        <span class="badge @GetScoreBadgeClass(classAverage) fs-3 px-4 py-3">@classAverage.ToString("F2")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sınıf Başarı Tablosu -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title text-primary mb-3">🎯 Sınıf Başarı Tablosu</h5>
                    <div class="row text-center">
                        <div class="col-md-2 col-sm-4 col-6 mb-3">
                            <div class="p-3 bg-danger text-white rounded">
                                <h6>Geçmez</h6>
                                <h4>@successDistribution.Gecmez</h4>
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-4 col-6 mb-3">
                            <div class="p-3 bg-warning text-white rounded">
                                <h6>Geçer</h6>
                                <h4>@successDistribution.Gecer</h4>
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-4 col-6 mb-3">
                            <div class="p-3 bg-info text-white rounded">
                                <h6>Orta</h6>
                                <h4>@successDistribution.Orta</h4>
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-4 col-6 mb-3">
                            <div class="p-3 bg-primary text-white rounded">
                                <h6>İyi</h6>
                                <h4>@successDistribution.Iyi</h4>
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-4 col-6 mb-3">
                            <div class="p-3 bg-success text-white rounded">
                                <h6>Pek İyi</h6>
                                <h4>@successDistribution.PekIyi</h4>
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-4 col-6 mb-3">
                            <div class="p-3 bg-secondary text-white rounded">
                                <h6>Ortalama</h6>
                                <h4>@classAverage.ToString("F2")</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bölüm 3: Grafikler -->
    <div class="row mb-4">
        <div class="col-12">
            <h4 class="mb-3 text-primary">📊 Analiz Grafikleri</h4>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Başarı Dağılımı</h5>
                    <canvas id="successChart" width="400" height="200"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Soru Başarı Oranları</h5>
                    <canvas id="questionChart" width="400" height="200"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Not Dağılımı</h5>
                    <canvas id="gradeChart" width="400" height="200"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Sınıf Performansı</h5>
                    <canvas id="performanceChart" width="400" height="200"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Bölüm 4: Kazanım Analizi -->
    <div class="row mb-4">
        <div class="col-12">
            <h4 class="mb-3 text-primary">🎯 Kazanım Analizi</h4>
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Kazanım Kodu</th>
                                    <th>Kazanım Açıklaması</th>
                                    <th class="text-center">Başarı Puanı</th>
                                    <th class="text-center">Başarı Oranı (%)</th>
                                    <th class="text-center">Durum</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var outcome in learningOutcomes)
                                {
                                    <tr class="@GetOutcomeRowClass(outcome.SuccessScore)">
                                        <td><strong>@outcome.Code</strong></td>
                                        <td>@outcome.Description</td>
                                        <td class="text-center">
                                            <span class="badge @GetOutcomeBadgeClass(outcome.SuccessScore) fs-5 px-2 py-1">
                                                @outcome.SuccessScore.ToString("F2")
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge @GetOutcomeBadgeClass(outcome.SuccessScore) fs-5 px-2 py-1">
                                                @((outcome.SuccessScore / 4.0 * 100).ToString("F1"))%
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge @GetOutcomeBadgeClass(outcome.SuccessScore) fs-5 px-2 py-1">
                                                @GetOutcomeStatus(outcome.SuccessScore)
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bölüm 5: Yapay Zeka Görüşü -->
    <div class="row mb-4">
        <div class="col-12">
            <h4 class="mb-3 text-primary">🤖 Yapay Zeka Analizi</h4>
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-8">
                            <h5 class="mb-3">Sınav Analizi ve Öneriler</h5>
                            <div class="bg-light p-3 rounded">
                                <p class="mb-2">
                                    <strong>Genel Değerlendirme:</strong>
                                    Sınıf ortalaması @classAverage.ToString("F2") ile @GetPerformanceLevel(classAverage) seviyesinde bir performans göstermektedir.
                                </p>
                                <p class="mb-2">
                                    <strong>Güçlü Alanlar:</strong>
                                    En yüksek başarı gösterilen sorular: @GetTopQuestions()
                                </p>
                                <p class="mb-2">
                                    <strong>Gelişim Alanları:</strong>
                                    Düşük performans gösterilen sorular: @GetWeakQuestions()
                                </p>
                                <p class="mb-2">
                                    <strong>Öneriler:</strong>
                                    @GetRecommendations()
                                </p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="text-center">
                                <div class="badge bg-primary fs-5 mb-2 px-3 py-2">AI Model</div>
                                <p class="small text-muted">GPT-4 Education Analytics</p>
                                <p class="small text-muted">Analiz Tarihi: @DateTime.Now.ToString("dd.MM.yyyy")</p>
                                <p class="small text-muted">Güvenilirlik: %94</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bölüm 6: Sorumlu Personel -->
    <div class="row mb-4">
        <div class="col-12">
            <h4 class="mb-3 text-primary">👥 Sorumlu Personel</h4>
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <h6 class="text-muted">Sınavı Yapan Öğretmen</h6>
                            <p class="mb-0"><strong>@examInfo.ExamTeacher</strong></p>
                        </div>
                        <div class="col-md-4 mb-3">
                            <h6 class="text-muted">Okuyan Öğretmenler</h6>
                            @foreach (var teacher in examInfo.ReadingTeachers)
                            {
                                <p class="mb-1">@teacher</p>
                            }
                        </div>
                        <div class="col-md-4 mb-3">
                            <h6 class="text-muted">Müdür</h6>
                            <p class="mb-0"><strong>@examInfo.Principal</strong></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Yazdırma Butonu -->
    <div class="row d-print-none" >
        <div class="col-12 text-center">
            <button class="btn btn-primary btn-lg" @onclick="PrintPage">
                <i class="bi bi-printer"></i> Yazdır
            </button>
        </div>
    </div>
</div>

<style>
    /* Yazdırma için CSS */
    @@media print {
        .d-print-none {
            display: none !important;
        }

        .print-container {
            max-width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        .card {
            break-inside: avoid;
            page-break-inside: avoid;
        }

        .table {
            font-size: 12px;
        }

        .badge {
            color: #000 !important;
            border: 1px solid #000;
        }
    }

    /* Responsive tablo */
    @@media (max-width: 25rem) {
        .table-responsive {
            font-size: 12px;
        }
    }
</style>


@code {
    // Sınav bilgileri
    private ExamInfo examInfo = new ExamInfo
    {
        Period = "2024-2025 Güz Dönemi",
        SchoolName = "Atatürk İlkokulu",
        Subject = "Matematik",
        Grade = "4-A",
        QuestionCount = 10,
        ExamTeacher = "Ayşe YILMAZ",
        ReadingTeachers = new List<string> { "Mehmet KAYA", "Fatma ÖZKAN" },
        Principal = "Ahmet DEMIR"
    };

    // İstatistikler
    private ExamStatistics statistics = new ExamStatistics
    {
        AttendeesCount = 25,
        AbsenteesCount = 3,
        PassedCount = 18,
        FailedCount = 7
    };

    // Örnek öğrenci verileri
    private List<Student> students = new List<Student>();
    private List<double> questionAverages = new List<double>();
    private double classAverage = 0.0;
    private SuccessDistribution successDistribution = new SuccessDistribution();
    private List<LearningOutcome> learningOutcomes = new List<LearningOutcome>();

    protected override void OnInitialized()
    {
        // Örnek veri oluşturma
        GenerateSampleData();
        CalculateAverages();
        CalculateSuccessDistribution();
        GenerateLearningOutcomes();
    }

    private void GenerateSampleData()
    {
        var random = new Random();

        for (int i = 1; i <= 25; i++)
        {
            var student = new Student
            {
                RowNumber = i,
                StudentNumber = $"2024{i:D3}",
                FirstName = $"Öğrenci{i}",
                LastName = $"Soyad{i}",
                QuestionScores = new List<double>()
            };

            // Rastgele soru puanları oluştur
            for (int j = 0; j < examInfo.QuestionCount; j++)
            {
                student.QuestionScores.Add(random.Next(0,10));
            }

            student.TotalScore = student.QuestionScores.Sum();
            student.Status = GetStudentStatus(student.TotalScore);
            students.Add(student);
        }
    }

    private void CalculateAverages()
    {
        questionAverages = new List<double>();
        for (int i = 0; i < examInfo.QuestionCount; i++)
        {
            questionAverages.Add(Math.Round(students.Average(s => s.QuestionScores[i]), 2));
        }
        classAverage = Math.Round(students.Average(s => s.TotalScore), 2);
    }

    private void CalculateSuccessDistribution()
    {
        successDistribution = new SuccessDistribution
        {
            Gecmez = students.Count(s => s.TotalScore < 40),
            Gecer = students.Count(s => s.TotalScore >= 40 && s.TotalScore < 55),
            Orta = students.Count(s => s.TotalScore >= 55 && s.TotalScore < 70),
            Iyi = students.Count(s => s.TotalScore >= 70 && s.TotalScore < 85),
            PekIyi = students.Count(s => s.TotalScore >= 85)
        };
    }

    private void GenerateLearningOutcomes()
    {
        learningOutcomes = new List<LearningOutcome>
        {
            new LearningOutcome { Code = "MAT.4.1.1", Description = "Doğal sayıları okur, yazar ve sayı doğrusu üzerinde gösterir.", SuccessScore = 3.2 },
            new LearningOutcome { Code = "MAT.4.1.2", Description = "Doğal sayılarla toplama işlemini yapar.", SuccessScore = 2.8 },
            new LearningOutcome { Code = "MAT.4.1.3", Description = "Doğal sayılarla çıkarma işlemini yapar.", SuccessScore = 2.1 },
            new LearningOutcome { Code = "MAT.4.1.4", Description = "Doğal sayılarla çarpma işlemini yapar.", SuccessScore = 1.9 },
            new LearningOutcome { Code = "MAT.4.1.5", Description = "Doğal sayılarla bölme işlemini yapar.", SuccessScore = 1.6 }
        };
    }

    private string GetStudentStatus(double totalScore)
    {
        if (totalScore >= 85) return "Pek İyi";
        if (totalScore >= 70) return "İyi";
        if (totalScore >= 55) return "Orta";
        if (totalScore >= 40) return "Geçer";
        return "Geçmez";
    }

    private string GetRowBackgroundClass(double score)
    {
        if (score >= 85) return "table-success";
        if (score >= 70) return "table-primary";
        if (score >= 55) return "table-info";
        if (score >= 40) return "table-warning";
        return "table-danger";
    }

    private string GetScoreBadgeClass(double score)
    {
        if (score >= 4.0) return "bg-success";
        if (score >= 3.0) return "bg-primary";
        if (score >= 2.0) return "bg-info";
        if (score >= 1.0) return "bg-warning";
        return "bg-danger";
    }

    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Pek İyi" => "bg-success",
            "İyi" => "bg-primary",
            "Orta" => "bg-info",
            "Geçer" => "bg-warning",
            "Geçmez" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private string GetOutcomeRowClass(double score)
    {
        if (score < 2.0) return "table-danger";
        if (score < 2.5) return "table-warning";
        if (score < 3.0) return "table-info";
        if (score < 3.5) return "table-primary";
        return "table-success";
    }

    private string GetOutcomeBadgeClass(double score)
    {
        if (score < 2.0) return "bg-danger";
        if (score < 2.5) return "bg-warning";
        if (score < 3.0) return "bg-info";
        if (score < 3.5) return "bg-primary";
        return "bg-success";
    }

    private string GetOutcomeStatus(double score)
    {
        if (score < 2.0) return "Yetersiz";
        if (score < 2.5) return "Gelişmeli";
        if (score < 3.0) return "Yeterli";
        if (score < 3.5) return "İyi";
        return "Çok İyi";
    }

    private string GetPerformanceLevel(double average)
    {
        if (average >= 85) return "çok yüksek";
        if (average >= 70) return "yüksek";
        if (average >= 55) return "orta";
        if (average >= 40) return "düşük";
        return "çok düşük";
    }

    private string GetTopQuestions()
    {
        var topQuestions = questionAverages
            .Select((avg, index) => new { Index = index + 1, Average = avg })
            .OrderByDescending(x => x.Average)
            .Take(3)
            .Select(x => x.Index.ToString());

        return string.Join(", ", topQuestions);
    }

    private string GetWeakQuestions()
    {
        var weakQuestions = questionAverages
            .Select((avg, index) => new { Index = index + 1, Average = avg })
            .OrderBy(x => x.Average)
            .Take(3)
            .Select(x => x.Index.ToString());

        return string.Join(", ", weakQuestions);
    }

    private string GetRecommendations()
    {
        var recommendations = new List<string>();

        if (classAverage < 50)
        {
            recommendations.Add("Temel kavramların tekrar edilmesi önerilir.");
        }

        if (successDistribution.Gecmez > 5)
        {
            recommendations.Add("Bireysel destekleme çalışmaları planlanmalıdır.");
        }

        if (learningOutcomes.Count(x => x.SuccessScore < 2.0) > 2)
        {
            recommendations.Add("Kazanım odaklı ek çalışmalar yapılmalıdır.");
        }

        return recommendations.Any() ? string.Join(" ", recommendations) : "Genel olarak başarılı bir sınav performansı gösterilmiştir.";
    }

    private async Task PrintPage()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    // Veri modelleri
    public class ExamInfo
    {
        public string Period { get; set; } = "";
        public string SchoolName { get; set; } = "";
        public string Subject { get; set; } = "";
        public string Grade { get; set; } = "";
        public int QuestionCount { get; set; }
        public string ExamTeacher { get; set; } = "";
        public List<string> ReadingTeachers { get; set; } = new();
        public string Principal { get; set; } = "";
    }

    public class ExamStatistics
    {
        public int AttendeesCount { get; set; }
        public int AbsenteesCount { get; set; }
        public int PassedCount { get; set; }
        public int FailedCount { get; set; }
    }

    public class Student
    {
        public int RowNumber { get; set; }
        public string StudentNumber { get; set; } = "";
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public List<double> QuestionScores { get; set; } = new();
        public double TotalScore { get; set; }
        public string Status { get; set; } = "";
    }

    public class SuccessDistribution
    {
        public int Gecmez { get; set; }
        public int Gecer { get; set; }
        public int Orta { get; set; }
        public int Iyi { get; set; }
        public int PekIyi { get; set; }
    }

    public class LearningOutcome
    {
        public string Code { get; set; } = "";
        public string Description { get; set; } = "";
        public double SuccessScore { get; set; }
    }

}