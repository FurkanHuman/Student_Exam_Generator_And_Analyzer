@using Application.Services.CalculatorFactory

@if (BenefitAnalysis != null)
{
    <div class="row mb-4">
        <div class="col-12">
            <h4 class="mb-3 text-primary">
                <i class="bi bi-target"></i> Kazanım Analizi
            </h4>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 pt-4 pb-3">
                    <h5 class="text-primary mb-0">
                        <i class="bi bi-bar-chart"></i> Sınıf Kazanım Ortalamaları
                    </h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover table-bordered">
                            <thead class="table-dark">
                                <tr>
                                    <th style="width: 150px;">Kazanım Kodu</th>
                                    <th>Açıklama</th>
                                    <th class="text-center" style="width: 120px;">Soru Sayısı</th>
                                    <th class="text-center" style="width: 100px;">Puan (4/4)</th>
                                    <th class="text-center" style="width: 100px;">Yüzde</th>
                                    <th class="text-center" style="width: 120px;">Durum</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var benefit in BenefitAnalysis.ClassAverageBenefits)
                                {
                                    <tr class="@GetBenefitRowClass(benefit.Score)">
                                        <td><strong>@benefit.BenefitCode</strong></td>
                                        <td>@benefit.Description</td>
                                        <td class="text-center">
                                            <span class="badge bg-info">@benefit.TotalQuestions</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge @GetBenefitBadgeClass(benefit.Score) fs-6 px-3 py-2">
                                                @benefit.Score.ToString("F2")
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <div class="progress" style="height: 25px;">
                                                <div class="progress-bar @GetProgressBarClass(benefit.Score)"
                                                     style="width: @benefit.Percentage.ToString("F1")%">
                                                    @benefit.Percentage.ToString("F1")%
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge @GetBenefitBadgeClass(benefit.Score) fs-6 px-3 py-2">
                                                @GetBenefitStatus(benefit.Score)
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 pt-4 pb-3">
                    <h5 class="text-primary mb-0">
                        <i class="bi bi-pie-chart"></i> Kazanım Durum Dağılımı
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row text-center g-3">
                        @foreach (var (status, count) in BenefitAnalysis.BenefitStatusDistribution)
                        {
                            <div class="col-lg col-md-4 col-sm-6">
                                <div class="card border-@GetStatusBorderColor(status) h-100">
                                    <div class="card-body p-4 bg-@GetStatusBorderColor(status) bg-opacity-10">
                                        <div class="mb-3">
                                            <i class="bi @GetStatusIcon(status) text-@GetStatusBorderColor(status)"
                                               style="font-size: 2rem;"></i>
                                        </div>
                                        <h6 class="text-@GetStatusBorderColor(status) mb-2">@status</h6>
                                        <h3 class="mb-0 text-@GetStatusBorderColor(status) fw-bold">@count</h3>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 pt-4 pb-3">
                    <h5 class="text-primary mb-0">
                        <i class="bi bi-people"></i> Öğrenci Bazında Kazanım Analizi
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-sm mb-0">
                            <thead class="table-dark sticky-top">
                                <tr>
                                    <th style="width: 50px;">#</th>
                                    <th style="width: 200px;">Öğrenci</th>
                                    @foreach (var benefit in BenefitAnalysis.ClassAverageBenefits)
                                    {
                                        <th class="text-center" style="width: 80px;">
                                            <small>@benefit.BenefitCode</small>
                                        </th>
                                    }
                                    <th class="text-center bg-warning" style="width: 100px;">Ortalama</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var (student, index) in BenefitAnalysis.StudentAnalyses.Select((s, i) => (s, i + 1)))
                                {
                                    <tr>
                                        <td class="text-center">@index</td>
                                        <td><strong>@student.StudentName</strong></td>
                                        @foreach (var benefitCode in BenefitAnalysis.ClassAverageBenefits.Select(b => b.BenefitCode))
                                        {
                                            var studentBenefit = student.BenefitScores.FirstOrDefault(b => b.BenefitCode == benefitCode);
                                            <td class="text-center">
                                                @if (studentBenefit != null)
                                                {
                                                    <span class="badge @GetBenefitBadgeClass(studentBenefit.Score) fs-7 px-2 py-1">
                                                        @studentBenefit.Score.ToString("F1")
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                        }
                                        <td class="text-center">
                                            <span class="badge @GetBenefitBadgeClass(student.AverageBenefitScore) fs-6 px-3 py-2 fw-bold">
                                                @student.AverageBenefitScore.ToString("F2")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public BenefitAnalysisResultDto? BenefitAnalysis { get; set; }

    private string GetBenefitStatus(double score)
    {
        return score switch
        {
            >= 3.5 => "Çok İyi",
            >= 3.0 => "İyi",
            >= 2.5 => "Yeterli",
            >= 2.0 => "Gelişmeli",
            _ => "Yetersiz"
        };
    }

    private string GetBenefitRowClass(double score)
    {
        return score switch
        {
            >= 3.5 => "table-success",
            >= 3.0 => "table-primary",
            >= 2.5 => "table-info",
            >= 2.0 => "table-warning",
            _ => "table-danger"
        };
    }

    private string GetBenefitBadgeClass(double score)
    {
        return score switch
        {
            >= 3.5 => "bg-success text-white",
            >= 3.0 => "bg-primary text-white",
            >= 2.5 => "bg-info text-white",
            >= 2.0 => "bg-warning text-dark",
            _ => "bg-danger text-white"
        };
    }

    private string GetProgressBarClass(double score)
    {
        return score switch
        {
            >= 3.5 => "bg-success",
            >= 3.0 => "bg-primary",
            >= 2.5 => "bg-info",
            >= 2.0 => "bg-warning",
            _ => "bg-danger"
        };
    }

    private string GetStatusBorderColor(string status)
    {
        return status switch
        {
            "Çok İyi" => "success",
            "İyi" => "primary",
            "Yeterli" => "info",
            "Gelişmeli" => "warning",
            "Yetersiz" => "danger",
            _ => "secondary"
        };
    }

    private string GetStatusIcon(string status)
    {
        return status switch
        {
            "Çok İyi" => "bi-trophy-fill",
            "İyi" => "bi-star-fill",
            "Yeterli" => "bi-check-circle-fill",
            "Gelişmeli" => "bi-arrow-up-circle-fill",
            "Yetersiz" => "bi-x-circle-fill",
            _ => "bi-question-circle"
        };
    }
}