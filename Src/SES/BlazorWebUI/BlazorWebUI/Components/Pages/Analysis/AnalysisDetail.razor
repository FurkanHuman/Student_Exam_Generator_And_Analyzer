@page "/Analysis/{Id:int}"
@layout FullScreenLayout
@rendermode InteractiveServer
@using Application.Features.Analyses.Queries.GetByIdAnalysisGetResponsiblePersonnel
@using Application.Features.Analyses.Queries.GetByIdAnalysisLessonPassingScore
@using Application.Services.Analyses
@using Application.Services.CalculatorFactory
@using BlazorWebUI.Components.Layout
@using BlazorWebUI.Components.Pages.Analysis.Charts

<PageTitle>Analiz Detayı - @Id</PageTitle>

<div class="container-fluid py-4 print-container">
    @if (isLoading)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p>Analiz verileri sırayla yükleniyor...</p>
        </div>
    }
    else
    {
        <AnalysisGeneralIstatistic Statistics="generalStatistics" />
        <AnalysisDetailTable DetailTableData="detailTableData" PassingScore="passingScore" />
        <AnalysisQuestionAveragesStatistics QuestionAverages="questionAverages" />
        <AnalysisSuccessDistribution SuccessDistribution="successDistribution" />
        <AnalysisChartsPage AdvancedData="advancedStatisticsData"
                            ClusteredStudents="clusteredStudents"
                            RadarData="radarData" />
        <AnalysisBenefitTable BenefitAnalysis="benefitAnalysisResult" />
        <AnalysisAIInsights SuccessDistribution="successDistribution" QuestionAverages="questionAverages" AIResponse="Beklemede kalın şuan AI ile görüşmelerimiz Sürüyor..."/>
        <AnalysisResponsiblePersonnel ResponsiblePersonnel="responsiblePersonnel" />
        <div class="row d-print-none">
            <div class="col-12 text-center">
                <button class="btn btn-primary btn-lg" @onclick="PrintPage">
                    <i class="bi bi-printer"></i> Yazdır
                </button>
            </div>
        </div>
    }
</div>

@code
{
    [Parameter]
    public int Id { get; set; }

    [Inject]
    private IJSRuntime JSRuntime { get; set; } = default!;

    [Inject]
    private IMediator Mediator { get; set; } = default!;

    [Inject]
    private AnalysisComputationEngine analysisCalculatorFactory { get; set; } = default!;


    private AnalysisGeneralExamStatisticsCounters? generalStatistics;
    private IList<AnalysisDetailTableDto>? detailTableData;
    private Dictionary<int, double>? questionAverages;
    private SuccessDistribution? successDistribution;
    private AdvancedStatisticsData? advancedStatisticsData;
    private List<List<StudentPerformanceDto>>? clusteredStudents;
    private BenefitAnalysisResultDto? benefitAnalysisResult;
    private BenefitRadarResultDto? radarData;
    private GetByIdAnalysisGetResponsiblePersonnelResponse? responsiblePersonnel;
    
    private int passingScore;

    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;

            passingScore = await Mediator.Send(new GetByIdAnalysisLessonPassingScoreQuery { Id = Id });

            generalStatistics = await analysisCalculatorFactory.GeneralStatsCalculator.CalculateAsync(Id);

            detailTableData = await analysisCalculatorFactory.DetailTableCalculator.CalculateAsync(Id);

            questionAverages = await analysisCalculatorFactory.QuestionAveragesCalculator.CalculateAsync(Id);

            successDistribution = await analysisCalculatorFactory.SuccessDistributionCalculator.CalculateAsync(Id);

            advancedStatisticsData = await analysisCalculatorFactory.AdvancedChartsCalculator.CalculateAsync(Id);

            clusteredStudents = await analysisCalculatorFactory.ClusteringCalculator.CalculateAsync(Id);

            benefitAnalysisResult = await analysisCalculatorFactory.BenefitAnalysisCalculator.CalculateAsync(Id);

            radarData = await analysisCalculatorFactory.RadarCalculator.CalculateAsync(Id);

            benefitAnalysisResult = await BenefitAnalysisCalculator.CalculateAsync(Id);

            responsiblePersonnel = await Mediator.Send(new GetByIdAnalysisGetResponsiblePersonnelQuery { Id = Id });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Analiz yüklenirken hata: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task PrintPage()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }
}