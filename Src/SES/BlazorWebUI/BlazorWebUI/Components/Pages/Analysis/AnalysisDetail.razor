@page "/Analysis/{Id:int}"
@layout FullScreenLayout
@rendermode InteractiveServer
@using Application.Services.Analyses
@using BlazorWebUI.Components.Layout
@using Application.Services.CalculatorFactory

<PageTitle>Analiz Detayı - @Id</PageTitle>

<div class="container-fluid py-4 print-container">
    <AnalysisGeneralIstatistic Statistics="generalStatistics" />

    <AnalysisDetailTable DetailTableData="detailTableData" />

    <AnalysisQuestionAveragesStatistics QuestionAverages="questionAverages" />

    <AnalysisSuccessDistribution SuccessDistribution="successDistribution" />
    <AnalysisAdvancedCharts AdvancedData="advancedStatisticsData"/>


    <div class="row d-print-none">
        <div class="col-12 text-center">
            <button class="btn btn-primary btn-lg" @onclick="PrintPage">
                <i class="bi bi-printer"></i> Yazdır
            </button>
        </div>
    </div>
</div>

@code
{
    [Parameter]
    public int Id { get; set; }

    // Injected JS Runtime for printing
    [Inject]
    private IJSRuntime JSRuntime { get; set; } = default!;

    // Injected Calculators
    [Inject]
    private IAnalysisCalculatorFactory<AnalysisGeneralExamStatisticsCounters> GeneralStatsCalculator { get; set; } = default!;

    [Inject]
    private IAnalysisCalculatorFactory<IList<AnalysisDetailTableDto>> DetailTableCalculator { get; set; } = default!;

    [Inject]
    private IAnalysisCalculatorFactory<Dictionary<int, double>> QuestionAveragesCalculator { get; set; } = default!;

    [Inject]
    private IAnalysisCalculatorFactory<SuccessDistribution> SuccessDistributionCalculator { get; set; } = default!;

    [Inject]
    private IAnalysisCalculatorFactory<AdvancedStatisticsData> AdvancedChartsCalculator { get; set; } = default!;

    // Data containers
    private AnalysisGeneralExamStatisticsCounters? generalStatistics;
    private IList<AnalysisDetailTableDto>? detailTableData;
    private Dictionary<int, double>? questionAverages;
    private SuccessDistribution? successDistribution;
    private AdvancedStatisticsData? advancedStatisticsData;

    private ICollection<string> statusesBrigde = new List<string>();

    protected override async Task OnInitializedAsync()
    {
        try
        {

            generalStatistics = await GeneralStatsCalculator.CalculateAsync(Id);

            detailTableData = await DetailTableCalculator.CalculateAsync(Id);

            questionAverages = await QuestionAveragesCalculator.CalculateAsync(Id);

            successDistribution = await SuccessDistributionCalculator.CalculateAsync(Id);

            advancedStatisticsData = await AdvancedChartsCalculator.CalculateAsync(Id);
        }
        catch (Exception ex)
        {
            // Error handling
            Console.WriteLine($"Error loading analysis: {ex.Message}");
        }
    }

    private async Task PrintPage()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    private void BrigdeMethod(ICollection<string> args) => statusesBrigde = args;
}
<style>
    @@media print {
        .d-print-none {
            display: none !important;
        }

        .print-container {
            max-width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        .card {
            break-inside: avoid;
            page-break-inside: avoid;
        }

        .table {
            font-size: 12px;
        }

        .badge {
            color: #000 !important;
            border: 1px solid #000;
        }
    }

    @@media (max-width: 25rem) {
        .table-responsive {
            font-size: 12px;
        }
    }
</style>