@using Application.Services.CalculatorFactory

@if (SuccessDistribution != null)
{
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 pt-4 pb-3">
                    <h5 class="text-primary mb-0">
                        <i class="bi bi-pie-chart-fill"></i> Başarı Dağılımı
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row text-center g-3">
                        <div class="col-lg col-md-4 col-sm-6">
                            <div class="card border-danger h-100">
                                <div class="card-body p-4 bg-danger bg-opacity-10">
                                    <div class="mb-3">
                                        <i class="bi bi-x-circle-fill text-danger" style="font-size: 2rem;"></i>
                                    </div>
                                    <h6 class="text-danger mb-2">Geçmez</h6>
                                    <h3 class="mb-0 text-danger fw-bold">@SuccessDistribution.Fail</h3>
                                    <small class="text-muted">
                                        %@GetPercentage(SuccessDistribution.Fail)
                                    </small>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg col-md-4 col-sm-6">
                            <div class="card border-warning h-100">
                                <div class="card-body p-4 bg-warning bg-opacity-10">
                                    <div class="mb-3">
                                        <i class="bi bi-dash-circle-fill text-warning" style="font-size: 2rem;"></i>
                                    </div>
                                    <h6 class="text-warning mb-2">Geçer</h6>
                                    <h3 class="mb-0 text-warning fw-bold">@SuccessDistribution.Pass</h3>
                                    <small class="text-muted">
                                        %@GetPercentage(SuccessDistribution.Pass)
                                    </small>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg col-md-4 col-sm-6">
                            <div class="card border-info h-100">
                                <div class="card-body p-4 bg-info bg-opacity-10">
                                    <div class="mb-3">
                                        <i class="bi bi-record-circle-fill text-info" style="font-size: 2rem;"></i>
                                    </div>
                                    <h6 class="text-info mb-2">Orta</h6>
                                    <h3 class="mb-0 text-info fw-bold">@SuccessDistribution.Average</h3>
                                    <small class="text-muted">
                                        %@GetPercentage(SuccessDistribution.Average)
                                    </small>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg col-md-4 col-sm-6">
                            <div class="card border-primary h-100">
                                <div class="card-body p-4 bg-primary bg-opacity-10">
                                    <div class="mb-3">
                                        <i class="bi bi-star-fill text-primary" style="font-size: 2rem;"></i>
                                    </div>
                                    <h6 class="text-primary mb-2">İyi</h6>
                                    <h3 class="mb-0 text-primary fw-bold">@SuccessDistribution.Good</h3>
                                    <small class="text-muted">
                                        %@GetPercentage(SuccessDistribution.Good)
                                    </small>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg col-md-4 col-sm-6">
                            <div class="card border-success h-100">
                                <div class="card-body p-4 bg-success bg-opacity-10">
                                    <div class="mb-3">
                                        <i class="bi bi-trophy-fill text-success" style="font-size: 2rem;"></i>
                                    </div>
                                    <h6 class="text-success mb-2">Pek İyi</h6>
                                    <h3 class="mb-0 text-success fw-bold">@SuccessDistribution.VeryGood</h3>
                                    <small class="text-muted">
                                        %@GetPercentage(SuccessDistribution.VeryGood)
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code
{
    [Parameter]
    public SuccessDistribution? SuccessDistribution { get; set; }

    private string GetPercentage(int count)
    {
        if (SuccessDistribution == null) return "0";

        int total = SuccessDistribution.Fail +
                   SuccessDistribution.Pass +
                   SuccessDistribution.Average +
                   SuccessDistribution.Good +
                   SuccessDistribution.VeryGood;

        return total > 0 ? ((count * 100.0) / total).ToString("F1") : "0";
    }
}
