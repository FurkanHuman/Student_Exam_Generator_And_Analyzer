@using Application.Services.CalculatorFactory

@if (QuestionAverages != null)
{
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title text-primary mb-3">📈 Soru Başına Sınıf Ortalaması</h5>
                    <div class="row">
                        @foreach (KeyValuePair<int, double> avg in QuestionAverages)
                        {
                            <div class="col-md-2 col-sm-3 col-4 mb-2">
                                <div class="text-center">
                                    <small class="text-muted">Soru @(avg.Key)</small>
                                    <div class="badge bg-info fs-5 px-2 py-1 d-block">
                                        @avg.Value.ToString("F2")
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <hr />
                    <div class="text-center">
                        <h6 class="mb-1">Sınıf Ortalaması</h6>
                        <span class="badge bg-info fs-3 px-4 py-3">@QuestionAverages.Values.Sum().ToString("F2")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code
{
    [Parameter]
    public Dictionary<int, double>? QuestionAverages { get; set; }
}