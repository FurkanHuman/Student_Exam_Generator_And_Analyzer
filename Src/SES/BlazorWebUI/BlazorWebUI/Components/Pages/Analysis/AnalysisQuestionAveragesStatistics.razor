@using Application.Services.CalculatorFactory

@if (QuestionAverages != null && QuestionAverages.Any())
{
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 pt-4 pb-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <h5 class="text-primary mb-3">
                            <i class="bi bi-graph-up-arrow"></i> Soru Başına Sınıf Ortalaması
                        </h5>
                        <span class="badge bg-info text-white fs-6">
                            @QuestionAverages.Count Soru
                        </span>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        @foreach (var (key, value) in QuestionAverages.OrderBy(x => x.Key))
                        {
                            <div class="col-xl-2 col-lg-3 col-md-4 col-sm-4 col-6">
                                <div class="text-center p-3 rounded bg-light hover-scale">
                                    <div class="text-muted small mb-2">
                                        <i class="bi bi-question-circle"></i> Soru @key
                                    </div>
                                    <div class="badge @GetScoreBadgeClass(value) fs-5 px-3 py-2 w-100">
                                        @value.ToString("F2")
                                    </div>
                                    <div class="progress mt-2" style="height: 0.25rem;">
                                        <div class="progress-bar @GetProgressBarClass(value)"
                                             style="width: @((value / 10.0 * 100).ToString("F0"))%">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <hr class="my-4" />

                    <div class="text-center">
                        <h6 class="text-muted mb-3">
                            <i class="bi bi-star-fill text-warning"></i> Sınıf Ortalaması
                        </h6>
                        <div class="d-inline-block">
                            <span class="badge @GetScoreBadgeClass(QuestionAverages.Values.Sum()) fs-2 px-5 py-3">
                                @QuestionAverages.Values.Sum().ToString("F2")
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code
{
    [Parameter]
    public Dictionary<int, double>? QuestionAverages { get; set; }

    private string GetScoreBadgeClass(double score)
    {
        return score switch
        {
            >= 8 => "bg-success text-white",
            >= 6 => "bg-primary text-white",
            >= 4 => "bg-info text-white",
            >= 2 => "bg-warning text-dark",
            _ => "bg-danger text-white"
        };
    }

    private string GetProgressBarClass(double score)
    {
        return score switch
        {
            >= 8 => "bg-success",
            >= 6 => "bg-primary",
            >= 4 => "bg-info",
            >= 2 => "bg-warning",
            _ => "bg-danger"
        };
    }
}

<style>
    .hover-scale {
        transition: transform 0.2s ease;
    }

        .hover-scale:hover {
            transform: scale(1.05);
        }

    .card-header {
        background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
    }
</style>