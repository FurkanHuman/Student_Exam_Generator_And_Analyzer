@using Application.Services.CalculatorFactory
@inject IAnalysisCalculatorFactory<Dictionary<int, double>> CalculatorFactory
@if (isLoading)
{
    <div class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Yükleniyor...</span>
        </div>
    </div>
}
else if (analysisData != null)
{
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title text-primary mb-3">📈 Soru Başına Sınıf Ortalaması</h5>
                    <div class="row">
                        @foreach (KeyValuePair<int, double> avg in analysisData)
                        {
                            <div class="col-md-2 col-sm-3 col-4 mb-2">
                                <div class="text-center">
                                    <small class="text-muted">Soru @(avg.Key)</small>
                                    <div class="badge bg-info fs-5 px-2 py-1 d-block">
                                        @avg.Value.ToString("F2")
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <hr />
                    <div class="text-center">
                        <h6 class="mb-1">Sınıf Ortalaması</h6>
                        <span class="badge bg-info fs-3 px-4 py-3">@analysisData.Values.Sum().ToString("F2")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title text-primary mb-3">🎯 Sınıf Başarı Tablosu</h5>
                    <div class="row text-center">
                        <div class="col-md-2 col-sm-4 col-6 mb-3">
                            <div class="p-3 bg-danger text-white rounded">
                                <h6>Geçmez</h6>
                                <h4>@successDistribution.Fail</h4>
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-4 col-6 mb-3">
                            <div class="p-3 bg-warning text-white rounded">
                                <h6>Geçer</h6>
                                <h4>@successDistribution.Pass</h4>
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-4 col-6 mb-3">
                            <div class="p-3 bg-info text-white rounded">
                                <h6>Orta</h6>
                                <h4>@successDistribution.Average</h4>
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-4 col-6 mb-3">
                            <div class="p-3 bg-primary text-white rounded">
                                <h6>İyi</h6>
                                <h4>@successDistribution.Good</h4>
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-4 col-6 mb-3">
                            <div class="p-3 bg-success text-white rounded">
                                <h6>Pek İyi</h6>
                                <h4>@successDistribution.VeryGood</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else if (!isLoading && errorMessage != null)
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}

@code
{
    [Parameter]
    public int AnalysisId { get; set; }

    private Dictionary<int, double> analysisData;
    private SuccessDistribution successDistribution = new();
    private bool isLoading = true;
    private string? errorMessage;


    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            analysisData = await CalculatorFactory.CalculateAsync(AnalysisId);
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = $"Analiz bulunamadı: {ex.Message}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Veri yüklenirken hata oluştu: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SuccessDistributionBuilder(ICollection<string> statuses)
    {
        successDistribution.Fail = statuses.Count(s => s == "Geçmez");
        successDistribution.Pass = statuses.Count(s => s == "Geçer");
        successDistribution.Average = statuses.Count(s => s == "Orta");
        successDistribution.Good = statuses.Count(s => s == "İyi");
        successDistribution.VeryGood = statuses.Count(s => s == "Pek İyi");
    }

    public class SuccessDistribution
    {
        public int Fail { get; set; }
        public int Pass { get; set; }
        public int Average { get; set; }
        public int Good { get; set; }
        public int VeryGood { get; set; }
    }
}