@using ApexCharts

<div class="card">
    <div class="card-header">
        <h3>Soru Zorluk Matrisi</h3>
        <p class="text-muted">Kırmızı = Zor, Yeşil = Kolay</p>
    </div>
    <div class="card-body">
        <ApexChart TItem="HeatmapData"
                   Title="Soru Başarı Oranları"
                   Height="400">

            <ApexPointSeries TItem="HeatmapData"
                             Items="HeatmapDataPoints"
                             Name="Başarı Oranı"
                             SeriesType="SeriesType.Heatmap"
                             XValue="@(e => e.QuestionNumber)"
                             YValue="@(e => (decimal)e.SuccessRate)" />
        </ApexChart>
    </div>
    <div class="card-footer">
        <div class="d-flex justify-content-between">
            <span><span style="color: #dc3545;">■</span> Çok Zor (0-40%)</span>
            <span><span style="color: #ffc107;">■</span> Orta (41-70%)</span>
            <span><span style="color: #28a745;">■</span> Kolay (71-100%)</span>
        </div>
    </div>
</div>

@code {
    [Parameter] public Dictionary<int, double> QuestionAverages { get; set; } = new();
    [Parameter] public int MaxScore { get; set; } = 10;

    private List<HeatmapData> HeatmapDataPoints { get; set; } = new();

    protected override void OnParametersSet()
    {
        CalculateHeatmap();
    }

    private void CalculateHeatmap()
    {
        if (!QuestionAverages.Any()) return;

        HeatmapDataPoints = QuestionAverages.Select(kvp => new HeatmapData
        {
            QuestionNumber = $"Soru {kvp.Key}",
            SuccessRate = Math.Round((kvp.Value / MaxScore) * 100, 2)
        }).ToList();
    }

    public class HeatmapData
    {
        public string QuestionNumber { get; set; } = string.Empty;
        public double SuccessRate { get; set; }
    }
}