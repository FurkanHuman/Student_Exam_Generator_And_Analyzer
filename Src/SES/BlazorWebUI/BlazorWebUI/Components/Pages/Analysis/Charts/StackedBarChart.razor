@using ApexCharts
@using Application.Services.CalculatorFactory

<div class="card">
    <div class="card-header">
        <h3>Cevap Durumu Dağılımı</h3>
        <p class="text-muted">Her soru için doğru/yanlış/boş/kısmi doğru oranları</p>
    </div>
    <div class="card-body">
        <ApexChart TItem="AnswerDistribution"
                   Title="Soru Bazında Cevap Analizi"
                   Height="500">

            <ApexPointSeries TItem="AnswerDistribution"
                             Items="CorrectAnswers"
                             Name="Doğru"
                             SeriesType="SeriesType.Bar"
                             XValue="@(e => e.QuestionNumber)"
                             YValue="@(e => (decimal)e.Percentage)"
                             Color="#28a745" />

            <ApexPointSeries TItem="AnswerDistribution"
                             Items="WrongAnswers"
                             Name="Yanlış"
                             SeriesType="SeriesType.Bar"
                             XValue="@(e => e.QuestionNumber)"
                             YValue="@(e => (decimal)e.Percentage)"
                             Color="#dc3545" />

            <ApexPointSeries TItem="AnswerDistribution"
                             Items="BlankAnswers"
                             Name="Boş"
                             SeriesType="SeriesType.Bar"
                             XValue="@(e => e.QuestionNumber)"
                             YValue="@(e => (decimal)e.Percentage)"
                             Color="#6c757d" />

            <ApexPointSeries TItem="AnswerDistribution"
                             Items="PartialAnswers"
                             Name="Kısmi Doğru"
                             SeriesType="SeriesType.Bar"
                             XValue="@(e => e.QuestionNumber)"
                             YValue="@(e => (decimal)e.Percentage)"
                             Color="#ffc107" />
        </ApexChart>
    </div>
</div>

@code {
    [Parameter]
    public List<QuestionAnswerStatsDto> QuestionStats { get; set; } = new();

    private List<AnswerDistribution> CorrectAnswers { get; set; } = new();
    private List<AnswerDistribution> WrongAnswers { get; set; } = new();
    private List<AnswerDistribution> BlankAnswers { get; set; } = new();
    private List<AnswerDistribution> PartialAnswers { get; set; } = new();

    protected override void OnParametersSet()
    {
        CalculateDistributions();
    }

    private void CalculateDistributions()
    {
        if (!QuestionStats.Any()) return;

        CorrectAnswers = QuestionStats.Select(q => new AnswerDistribution
        {
            QuestionNumber = $"S{q.QuestionOrder}",
            Percentage = CalculatePercentage(q.CorrectCount, q.TotalStudents)
        }).ToList();

        WrongAnswers = QuestionStats.Select(q => new AnswerDistribution
        {
            QuestionNumber = $"S{q.QuestionOrder}",
            Percentage = CalculatePercentage(q.WrongCount, q.TotalStudents)
        }).ToList();

        BlankAnswers = QuestionStats.Select(q => new AnswerDistribution
        {
            QuestionNumber = $"S{q.QuestionOrder}",
            Percentage = CalculatePercentage(q.BlankCount, q.TotalStudents)
        }).ToList();

        PartialAnswers = QuestionStats.Select(q => new AnswerDistribution
        {
            QuestionNumber = $"S{q.QuestionOrder}",
            Percentage = CalculatePercentage(q.PartialCount, q.TotalStudents)
        }).ToList();
    }

    private double CalculatePercentage(int count, int total)
    {
        return total == 0 ? 0 : Math.Round((count * 100.0) / total, 2);
    }

    public class AnswerDistribution
    {
        public string QuestionNumber { get; set; } = string.Empty;
        public double Percentage { get; set; }
    }
}
