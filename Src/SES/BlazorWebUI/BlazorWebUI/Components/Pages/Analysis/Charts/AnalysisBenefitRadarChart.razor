@using ApexCharts
@using Application.Services.CalculatorFactory

<div class="card">
    <div class="card-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h3>Kazanım Radar Analizi</h3>
                <p class="text-muted mb-0">
                    @if (ShowClassAverage)
                    {
                        <span>Sınıf ortalaması gösteriliyor</span>
                    }
                    else if (SelectedStudent != null)
                    {
                        <span>@SelectedStudent.StudentName - Ortalama: @SelectedStudent.AverageScore.ToString("F2")</span>
                    }
                </p>
            </div>
            <div class="btn-group">
                <button class="btn btn-sm @(ShowClassAverage ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => ShowClassAverageChart()">
                    Sınıf Ortalaması
                </button>
                @if (RadarData?.StudentRadars.Any() == true)
                {
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-primary dropdown-toggle"
                                type="button"
                                data-bs-toggle="dropdown">
                            Öğrenci Seç
                        </button>
                        <ul class="dropdown-menu" style="max-height: 300px; overflow-y: auto;">
                            @foreach (var student in RadarData.StudentRadars.OrderBy(s => s.StudentName))
                            {
                                <li>
                                    <a class="dropdown-item @(SelectedStudent?.StudentId == student.StudentId ? "active" : "")" @onclick="() => ShowStudentChart(student)">
                                        @student.StudentName
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="card-body">
        @if (CurrentRadarData == null)
        {
            <div class="alert alert-info">
                Veri bulunamadı.
            </div>
        }
        else
        {
            <ApexChart TItem="RadarPoint"
                       Title="@CurrentRadarData.Label"
                       Height="500">

                <ApexPointSeries TItem="RadarPoint"
                                 Items="ChartDataPoints"
                                 Name="Kazanım Skoru"
                                 SeriesType="SeriesType.Radar"
                                 XValue="@(e => e.Category)"
                                 YValue="@(e => (decimal?)e.Value)" />
            </ApexChart>
            <div class="mt-4">
                <h5>📊 Kazanım Detayları:</h5>
                <div class="table-responsive">
                    <table class="table table-sm table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Kazanım Kodu</th>
                                <th class="text-center">Skor (4/4)</th>
                                <th class="text-center">Yüzde</th>
                                <th class="text-center">Durum</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < CurrentRadarData.Categories.Count; i++)
                            {
                                var category = CurrentRadarData.Categories[i];
                                var value = CurrentRadarData.Values[i];
                                var percentage = (value / CurrentRadarData.MaxValue) * 100;

                                <tr>
                                    <td><strong>@category</strong></td>
                                    <td class="text-center">
                                        <span class="badge @GetBadgeClass(value) fs-6 px-2 py-1">
                                            @value.ToString("F2")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="progress" style="height: 20px;">
                                            <div class="progress-bar @GetProgressBarClass(value)"
                                                 style="width: @percentage.ToString("F0")%">
                                                @percentage.ToString("F0")%
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @GetBadgeClass(value) fs-6 px-2 py-1">
                                            @GetStatus(value)
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (!ShowClassAverage && SelectedStudent != null)
                {
                    <div class="alert alert-info mt-3">
                        <h6><i class="bi bi-graph-up"></i> Sınıf Ortalaması ile Karşılaştırma:</h6>
                        <div class="row">
                            @for (int i = 0; i < SelectedStudent.Categories.Count; i++)
                            {
                                var category = SelectedStudent.Categories[i];
                                var studentValue = SelectedStudent.Values[i];
                                var classValue = RadarData?.ClassAverageRadar.Values[i] ?? 0;
                                var diff = studentValue - classValue;
                                var diffColor = diff >= 0 ? "success" : "danger";
                                var diffIcon = diff >= 0 ? "bi-arrow-up" : "bi-arrow-down";

                                <div class="col-md-4 mb-2">
                                    <small>
                                        <strong>@category:</strong>
                                        <span class="text-@diffColor ms-2">
                                            <i class="bi @diffIcon"></i>
                                            @Math.Abs(diff).ToString("F2")
                                        </span>
                                    </small>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public BenefitRadarResultDto? RadarData { get; set; }

    private RadarChartData? CurrentRadarData { get; set; }
    private StudentRadarData? SelectedStudent { get; set; }
    private bool ShowClassAverage { get; set; } = true;
    private List<RadarPoint> ChartDataPoints { get; set; } = new();

    protected override void OnParametersSet()
    {
        if (RadarData?.ClassAverageRadar != null && ShowClassAverage)
        {
            ShowClassAverageChart();
        }
    }

    private void ShowClassAverageChart()
    {
        ShowClassAverage = true;
        SelectedStudent = null;
        CurrentRadarData = RadarData?.ClassAverageRadar;
        UpdateChartData();
    }

    private void ShowStudentChart(StudentRadarData student)
    {
        ShowClassAverage = false;
        SelectedStudent = student;
        CurrentRadarData = student;
        UpdateChartData();
    }

    private void UpdateChartData()
    {
        if (CurrentRadarData == null) return;

        ChartDataPoints = new List<RadarPoint>();
        for (int i = 0; i < CurrentRadarData.Categories.Count; i++)
        {
            ChartDataPoints.Add(new RadarPoint
            {
                Category = CurrentRadarData.Categories[i],
                Value = CurrentRadarData.Values[i]
            });
        }
    }

    private string GetBadgeClass(double score)
    {
        return score switch
        {
            >= 3.5 => "bg-success text-white",
            >= 3.0 => "bg-primary text-white",
            >= 2.5 => "bg-info text-white",
            >= 2.0 => "bg-warning text-dark",
            _ => "bg-danger text-white"
        };
    }

    private string GetProgressBarClass(double score)
    {
        return score switch
        {
            >= 3.5 => "bg-success",
            >= 3.0 => "bg-primary",
            >= 2.5 => "bg-info",
            >= 2.0 => "bg-warning",
            _ => "bg-danger"
        };
    }

    private string GetStatus(double score)
    {
        return score switch
        {
            >= 3.5 => "Çok İyi",
            >= 3.0 => "İyi",
            >= 2.5 => "Yeterli",
            >= 2.0 => "Gelişmeli",
            _ => "Yetersiz"
        };
    }

    public class RadarPoint
    {
        public string Category { get; set; } = string.Empty;
        public double Value { get; set; }
    }
}