@using Application.Services.CalculatorFactory
@inject IJSRuntime JS

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-0 pt-4 pb-3">
        <h5 class="text-primary mb-0">Başarı Dağılımı - Box Plot</h5>
        <p class="text-muted">Sınıfın puan dağılımı (Min, Q1, Medyan, Q3, Max)</p>
    </div>
    <div class="card-body">
        <div id="@ChartContainerId" style="min-height: 400px;"></div>
    </div>
</div>

@code {
    [Parameter]
    public List<StudentScoreDto> StudentScores { get; set; } = new();

    private string ChartContainerId { get; set; } = "boxplot-" + Guid.NewGuid().ToString();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (StudentScores.Any())
        {
            await DrawChart();
        }
    }

    private async Task DrawChart()
    {
        try
        {
            var scores = StudentScores.Select(s => (double)s.TotalScore).OrderBy(s => s).ToList();

            if (scores.Count < 5) return;

            double min = scores.First();
            double q1 = Percentile(scores, 25);
            double median = Percentile(scores, 50);
            double q3 = Percentile(scores, 75);
            double max = scores.Last();

            var chartData = new List<object>
            {
                new
                {
                    x = "Sınıf Geneli",
                    y = new[] { min, q1, median, q3, max }
                }
            };

            var jsonData = System.Text.Json.JsonSerializer.Serialize(chartData);

            await JS.InvokeVoidAsync("renderCustomBoxPlot", ChartContainerId, jsonData, "Puan Dağılımı");
        }
        catch (Exception ex)
        {

            Console.WriteLine($"BoxPlot Render Error: {ex.Message}");
        }
    }

    private double Percentile(List<double> sequence, double percentile)
    {
        int n = sequence.Count;
        if (n == 0) return 0;

        double position = (n - 1) * percentile / 100.0;
        int lower = (int)Math.Floor(position);
        int upper = (int)Math.Ceiling(position);

        if (lower == upper) return sequence[lower];
        return sequence[lower] + (position - lower) * (sequence[upper] - sequence[lower]);
    }
}