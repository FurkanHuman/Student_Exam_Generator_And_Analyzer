@using ApexCharts
@using Application.Services.CalculatorFactory

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-0 pt-4 pb-3">
        <h5 class="text-primary mb-0">Öğrenci Kümeleme Analizi</h5>
        <p class="text-muted">K-Means Grupları</p>
    </div>
    <div class="card-body">
        @if (ClusterGroups.Any())
        {
            <ApexChart TItem="ClusterPoint"
                       Title="Öğrenci Kümeleri"
                       Height="500">

                @foreach (var cluster in ClusterGroups)
                {
                    <ApexPointSeries TItem="ClusterPoint"
                                     Items="cluster.Points"
                                     Name="@cluster.Name"
                                     SeriesType="SeriesType.Scatter"
                                     XValue="@(e => (decimal)e.TotalScore)"
                                     YValue="@(e => (decimal)e.BlankRate)" />
                }
            </ApexChart>

            <div class="mt-3">
                <h5 class="mb-3">Küme Özellikleri:</h5>
                <ul>
                    @foreach (var cluster in ClusterGroups)
                    {
                        <li>
                            <strong>@cluster.Name</strong>: @cluster.Points.Count öğrenci
                            <span class="text-muted">
                                (Ort. Puan: @cluster.AverageScore.ToString("F2"),
                                Ort. Boş: %@cluster.AverageBlankRate.ToString("F1"))
                            </span>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</div>

@code {

    [Parameter]
    public List<List<StudentPerformanceDto>>? ClusteredData { get; set; }

    private List<ClusterGroup> ClusterGroups { get; set; } = new();

    protected override void OnParametersSet()
    {
        MapClusters();
    }

    private void MapClusters()
    {
        if (ClusteredData == null || !ClusteredData.Any()) return;

        ClusterGroups = ClusteredData.Select((cluster, index) => new ClusterGroup
        {
            Name = GetClusterName(index),
            Points = cluster.Select(s => new ClusterPoint
            {
                StudentId = s.StudentId,
                StudentName = s.StudentName,
                TotalScore = s.TotalScore,
                BlankRate = s.BlankRate
            }).ToList(),
            AverageScore = cluster.Any() ? cluster.Average(s => s.TotalScore) : 0,
            AverageBlankRate = cluster.Any() ? cluster.Average(s => s.BlankRate) : 0
        }).ToList();
    }

    private string GetClusterName(int index)
    {
        return index switch
        {
            0 => "🟢 Yüksek Performans",
            1 => "🟡 Orta Performans",
            2 => "🟠 Düşük Performans",
            3 => "🔴 Risk Grubu",
            _ => $"Küme {index + 1}"
        };
    }

    public class ClusterPoint
    {
        public int StudentId { get; set; }
        public string StudentName { get; set; } = string.Empty;
        public double TotalScore { get; set; }
        public double BlankRate { get; set; }
    }

    public class ClusterGroup
    {
        public string Name { get; set; } = string.Empty;
        public List<ClusterPoint> Points { get; set; } = new();
        public double AverageScore { get; set; }
        public double AverageBlankRate { get; set; }
    }
}