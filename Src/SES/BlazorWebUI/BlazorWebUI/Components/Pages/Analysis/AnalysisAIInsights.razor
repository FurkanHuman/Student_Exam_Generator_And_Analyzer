@using Application.Services.AIService.Models
@using Application.Services.CalculatorFactory

@if (aIAnalysisResponse != null)
{
    <!-- Main AI Analysis Container -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <!-- Header Section -->
                <div class="card-header bg-white border-0 py-4">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <h4 class="text-primary mb-0">
                            <i class="bi bi-robot"></i> Yapay Zeka Analizi
                        </h4>
                        <!-- Quick Stats Badges -->
                        <div class="d-flex gap-2 flex-wrap">
                            <span class="badge bg-light text-dark border px-3 py-2">
                                <i class="bi bi-cpu"></i> @aIAnalysisResponse.AIModelVersion
                            </span>
                            <span class="badge bg-primary px-3 py-2">
                                <i class="bi bi-shield-check"></i> @aIAnalysisResponse.GeneralEvaluation.ConfidenceScore.ToString("P0")
                            </span>
                            <span class="badge bg-success px-3 py-2">
                                <i class="bi bi-speedometer2"></i> @aIAnalysisResponse.GeneralEvaluation.PerformanceLevel
                            </span>
                            <span class="badge bg-light text-muted border px-3 py-2">
                                <i class="bi bi-calendar-check"></i> @aIAnalysisResponse.GeneratedAt.ToString("dd.MM.yyyy HH:mm")
                            </span>
                        </div>
                    </div>
                </div>
                <div class="card-body p-4">
                    <!-- General Evaluation Section -->
                    <section class="mb-5">
                        <h5 class="text-primary mb-4">
                            <i class="bi bi-clipboard-data"></i> Genel Değerlendirme
                        </h5>
                        <div class="card border-0 bg-light">
                            <div class="card-body p-4">
                                <!-- Summary -->
                                <div class="mb-4">
                                    <h6 class="text-secondary mb-2">
                                        <i class="bi bi-file-text"></i> Özet
                                    </h6>
                                    <p class="mb-0" style="white-space: pre-wrap; line-height: 1.8;">@aIAnalysisResponse.GeneralEvaluation.Summary</p>
                                </div>
                                <!-- Comparison to Norm -->
                                <div class="mb-4">
                                    <h6 class="text-secondary mb-2">
                                        <i class="bi bi-bar-chart"></i> Norm Karşılaştırması
                                    </h6>
                                    <p class="mb-0" style="line-height: 1.8;">@aIAnalysisResponse.GeneralEvaluation.ComparisonToNorm</p>
                                </div>
                                <!-- Key Findings -->
                                <div>
                                    <h6 class="text-secondary mb-3">
                                        <i class="bi bi-lightbulb"></i> Temel Bulgular
                                    </h6>
                                    <div class="row g-2">
                                        @foreach (string finding in aIAnalysisResponse.GeneralEvaluation.KeyFindings)
                                        {
                                            <div class="col-12">
                                                <div class="d-flex align-items-start p-2 rounded bg-white">
                                                    <i class="bi bi-check-circle-fill text-success me-2 mt-1"></i>
                                                    <span>@finding</span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <!-- SWOT Analysis Section -->
                    <section class="mb-5">
                        <h5 class="text-primary mb-4">
                            <i class="bi bi-diagram-3"></i> SWOT Analizi
                        </h5>
                        <div class="row g-3">
                            <!-- Strengths -->
                            <div class="col-lg-6">
                                <div class="card border-0 h-100 shadow-sm">
                                    <div class="card-header bg-success bg-opacity-10 border-0">
                                        <h6 class="mb-0 text-success">
                                            <i class="bi bi-star-fill"></i> Güçlü Yönler
                                        </h6>
                                    </div>
                                    <div class="card-body">
                                        <ul class="list-unstyled mb-0">
                                            @foreach (string strength in aIAnalysisResponse.Analysis.Strengths)
                                            {
                                                <li class="mb-2 d-flex align-items-start">
                                                    <i class="bi bi-plus-circle text-success me-2 mt-1"></i>
                                                    <span>@strength</span>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <!-- Weaknesses -->
                            <div class="col-lg-6">
                                <div class="card border-0 h-100 shadow-sm">
                                    <div class="card-header bg-danger bg-opacity-10 border-0">
                                        <h6 class="mb-0 text-danger">
                                            <i class="bi bi-exclamation-triangle-fill"></i> Zayıf Yönler
                                        </h6>
                                    </div>
                                    <div class="card-body">
                                        <ul class="list-unstyled mb-0">
                                            @foreach (string weakness in aIAnalysisResponse.Analysis.Weaknesses)
                                            {
                                                <li class="mb-2 d-flex align-items-start">
                                                    <i class="bi bi-dash-circle text-danger me-2 mt-1"></i>
                                                    <span>@weakness</span>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <!-- Opportunities -->
                            <div class="col-lg-6">
                                <div class="card border-0 h-100 shadow-sm">
                                    <div class="card-header bg-info bg-opacity-10 border-0">
                                        <h6 class="mb-0 text-info">
                                            <i class="bi bi-lightbulb-fill"></i> Fırsatlar
                                        </h6>
                                    </div>
                                    <div class="card-body">
                                        <ul class="list-unstyled mb-0">
                                            @foreach (string opportunity in aIAnalysisResponse.Analysis.Opportunities)
                                            {
                                                <li class="mb-2 d-flex align-items-start">
                                                    <i class="bi bi-arrow-up-circle text-info me-2 mt-1"></i>
                                                    <span>@opportunity</span>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <!-- Threats -->
                            <div class="col-lg-6">
                                <div class="card border-0 h-100 shadow-sm">
                                    <div class="card-header bg-warning bg-opacity-10 border-0">
                                        <h6 class="mb-0 text-warning">
                                            <i class="bi bi-shield-exclamation"></i> Tehditler
                                        </h6>
                                    </div>
                                    <div class="card-body">
                                        <ul class="list-unstyled mb-0">
                                            @foreach (string threat in aIAnalysisResponse.Analysis.Threats)
                                            {
                                                <li class="mb-2 d-flex align-items-start">
                                                    <i class="bi bi-exclamation-circle text-warning me-2 mt-1"></i>
                                                    <span>@threat</span>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <!-- Student Behavior Analysis Section -->
                    <section class="mb-5">
                        <h5 class="text-primary mb-4">
                            <i class="bi bi-person-check"></i> Öğrenci Davranış Analizi
                        </h5>
                        <!-- Overall Behavior Pattern -->
                        <div class="card border-0 bg-light mb-3">
                            <div class="card-body">
                                <h6 class="text-secondary mb-2">
                                    <i class="bi bi-graph-up"></i> Genel Davranış Kalıbı
                                </h6>
                                <p class="mb-0">@aIAnalysisResponse.StudentBehavior.OverallBehaviorPattern</p>
                            </div>
                        </div>
                        <div class="row g-3">
                            <!-- Observed Patterns -->
                            <div class="col-lg-6">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-body">
                                        <h6 class="text-secondary mb-3">
                                            <i class="bi bi-eye-fill"></i> Gözlemlenen Kalıplar
                                        </h6>
                                        <ul class="list-unstyled mb-0">
                                            @foreach (string pattern in aIAnalysisResponse.StudentBehavior.ObservedPatterns)
                                            {
                                                <li class="mb-2 d-flex align-items-start">
                                                    <i class="bi bi-dot text-primary me-2 fs-4"></i>
                                                    <span>@pattern</span>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <!-- Strategic Behavior -->
                            <div class="col-lg-6">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-body">
                                        <h6 class="text-secondary mb-3">
                                            <i class="bi bi-bullseye"></i> Stratejik Davranış
                                        </h6>
                                        <div class="mb-2">
                                            <strong class="text-muted small">Stratejik Öğrenci Sayısı:</strong>
                                            <span class="ms-2">@aIAnalysisResponse.StudentBehavior.StrategicBehavior.StrategicStudentCount</span>
                                        </div>
                                        <div class="mb-2">
                                            <strong class="text-muted small">Strateji:</strong>
                                            <p class="mb-0 ms-2">@aIAnalysisResponse.StudentBehavior.StrategicBehavior.StrategyDescription</p>
                                        </div>
                                        <div class="mb-2">
                                            <strong class="text-muted small">Etkililik:</strong>
                                            <span class="badge @(aIAnalysisResponse.StudentBehavior.StrategicBehavior.IsEffective ? "bg-success" : "bg-warning") ms-2">
                                                @(aIAnalysisResponse.StudentBehavior.StrategicBehavior.IsEffective ? "Etkili" : "Geliştirilmeli")
                                            </span>
                                        </div>
                                        <div>
                                            <strong class="text-muted small">Öneri:</strong>
                                            <p class="mb-0 ms-2">@aIAnalysisResponse.StudentBehavior.StrategicBehavior.Recommendation</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Risk Indicators -->
                        <div class="card border-0 shadow-sm mt-3 bg-warning bg-opacity-10">
                            <div class="card-body">
                                <h6 class="text-warning mb-3">
                                    <i class="bi bi-exclamation-triangle-fill"></i> Risk Faktörleri
                                </h6>
                                <div class="row mb-2">
                                    <div class="col-md-6">
                                        <strong class="text-muted small">Risk Altındaki Öğrenci:</strong>
                                        <span class="ms-2">@aIAnalysisResponse.StudentBehavior.RiskIndicators.StudentsAtRisk</span>
                                    </div>
                                    <div class="col-md-6">
                                        <strong class="text-muted small">Ciddiyet Seviyesi:</strong>
                                        <span class="ms-2">@aIAnalysisResponse.StudentBehavior.RiskIndicators.SeverityLevel</span>
                                    </div>
                                </div>
                                <div>
                                    <strong class="text-muted small d-block mb-2">Belirlenen Riskler:</strong>
                                    <ul class="mb-0">
                                        @foreach (string risk in aIAnalysisResponse.StudentBehavior.RiskIndicators.IdentifiedRisks)
                                        {
                                            <li>@risk</li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </section>
                    <!-- Teaching Recommendations Section -->
                    <section class="mb-5">
                        <h5 class="text-primary mb-4">
                            <i class="bi bi-book"></i> Öğretim Önerileri
                        </h5>
                        <div class="row g-3 mb-3">
                            <!-- Immediate Actions -->
                            <div class="col-lg-4">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-header bg-danger bg-opacity-10 border-0">
                                        <h6 class="mb-0 text-danger">
                                            <i class="bi bi-lightning-charge-fill"></i> Acil Eylemler
                                        </h6>
                                    </div>
                                    <div class="card-body">
                                        <ul class="list-unstyled mb-0">
                                            @foreach (string action in aIAnalysisResponse.Recommendations.ImmediateActions)
                                            {
                                                <li class="mb-2 d-flex align-items-start">
                                                    <i class="bi bi-caret-right-fill text-danger me-2 mt-1"></i>
                                                    <span class="small">@action</span>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <!-- Short Term Goals -->
                            <div class="col-lg-4">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-header bg-warning bg-opacity-10 border-0">
                                        <h6 class="mb-0 text-warning">
                                            <i class="bi bi-calendar-week-fill"></i> Kısa Vadeli Hedefler
                                        </h6>
                                    </div>
                                    <div class="card-body">
                                        <ul class="list-unstyled mb-0">
                                            @foreach (string goal in aIAnalysisResponse.Recommendations.ShortTermGoals)
                                            {
                                                <li class="mb-2 d-flex align-items-start">
                                                    <i class="bi bi-caret-right-fill text-warning me-2 mt-1"></i>
                                                    <span class="small">@goal</span>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <!-- Long Term Strategies -->
                            <div class="col-lg-4">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-header bg-success bg-opacity-10 border-0">
                                        <h6 class="mb-0 text-success">
                                            <i class="bi bi-calendar-range-fill"></i> Uzun Vadeli Stratejiler
                                        </h6>
                                    </div>
                                    <div class="card-body">
                                        <ul class="list-unstyled mb-0">
                                            @foreach (string strategy in aIAnalysisResponse.Recommendations.LongTermStrategies)
                                            {
                                                <li class="mb-2 d-flex align-items-start">
                                                    <i class="bi bi-caret-right-fill text-success me-2 mt-1"></i>
                                                    <span class="small">@strategy</span>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Differentiation Suggestions -->
                        <div class="card border-0 bg-light">
                            <div class="card-body">
                                <h6 class="text-secondary mb-3">
                                    <i class="bi bi-layers-fill"></i> Farklılaştırma Önerileri
                                </h6>
                                <ul class="mb-0">
                                    @foreach (string suggestion in aIAnalysisResponse.Recommendations.DifferentiationSuggestions)
                                    {
                                        <li class="mb-2">@suggestion</li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </section>
                    <!-- Question-Based Analysis Section -->
                    <section class="mb-5">
                        <h5 class="text-primary mb-4">
                            <i class="bi bi-question-circle"></i> Soru Bazlı Analizler
                        </h5>
                        <div class="accordion" id="questionInsightsAccordion">
                            @foreach (QuestionInsight insight in aIAnalysisResponse.QuestionInsights)
                            {
                                <div class="accordion-item border-0 shadow-sm mb-2">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button collapsed" type="button"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#collapse@insight.QuestionOrder">
                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                                <strong>Soru @insight.QuestionOrder</strong>
                                                @if (insight.RequiresReview)
                                                {
                                                    <span class="badge bg-danger">Gözden Geçirilmeli</span>
                                                }
                                                <span class="badge bg-secondary">@insight.DifficultyAssessment</span>
                                            </div>
                                        </button>
                                    </h2>
                                    <div id="collapse@insight.QuestionOrder"
                                         class="accordion-collapse collapse"
                                         data-bs-parent="#questionInsightsAccordion">
                                        <div class="accordion-body">
                                            <!-- Performance Analysis -->
                                            <div class="mb-3">
                                                <h6 class="text-secondary">
                                                    <i class="bi bi-graph-up"></i> Performans Analizi
                                                </h6>
                                                <p class="mb-0">@insight.PerformanceAnalysis</p>
                                            </div>
                                            <div class="row">
                                                <!-- Common Mistakes -->
                                                <div class="col-lg-6">
                                                    <h6 class="text-danger">
                                                        <i class="bi bi-x-circle"></i> Yaygın Hatalar
                                                    </h6>
                                                    <ul class="small">
                                                        @foreach (string mistake in insight.CommonMistakes)
                                                        {
                                                            <li>@mistake</li>
                                                        }
                                                    </ul>
                                                </div>
                                                <!-- Improvement Suggestions -->
                                                <div class="col-lg-6">
                                                    <h6 class="text-success">
                                                        <i class="bi bi-plus-circle"></i> Gelişim Önerileri
                                                    </h6>
                                                    <ul class="small">
                                                        @foreach (string suggestion in insight.ImprovementSuggestions)
                                                        {
                                                            <li>@suggestion</li>
                                                        }
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </section>
                    <!-- Benefit Analysis Section -->
                    <section class="mb-5">
                        <h5 class="text-primary mb-4">
                            <i class="bi bi-trophy"></i> Kazanım Analizleri
                        </h5>
                        <div class="row g-3">
                            @foreach (BenefitInsight benefit in aIAnalysisResponse.BenefitInsights.OrderBy(b => b.PriorityLevel))
                            {
                                <div class="col-lg-6">
                                    <div class="card border-0 shadow-sm h-100">
                                        <div class="card-header bg-primary bg-opacity-10 border-0">
                                            <div class="d-flex justify-content-between align-items-center text-primary">
                                                <strong>@benefit.BenefitCode</strong>
                                                <span class="badge bg-light text-dark">Öncelik: @benefit.PriorityLevel</span>
                                            </div>
                                        </div>
                                        <div class="card-body">
                                            <div class="mb-3">
                                                <strong class="text-muted small">Hakimiyet Seviyesi:</strong>
                                                <span class="badge bg-info ms-2">@benefit.MasteryLevel</span>
                                            </div>
                                            <p class="small mb-3">@benefit.Analysis</p>
                                            <div>
                                                <strong class="text-muted small d-block mb-2">Öğretim Stratejileri:</strong>
                                                <ul class="small mb-0">
                                                    @foreach (string strategy in benefit.TeachingStrategies)
                                                    {
                                                        <li>@strategy</li>
                                                    }
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </section>
                    <!-- Intervention Strategies Section -->
                    <section>
                        <h5 class="text-primary mb-4">
                            <i class="bi bi-clipboard-pulse"></i> Müdahale Stratejileri
                        </h5>
                        @foreach (InterventionStrategy intervention in aIAnalysisResponse.Interventions)
                        {
                            <div class="card border-0 shadow-sm mb-3">
                                <div class="card-header bg-warning bg-opacity-10 border-0">
                                    <div class="d-flex justify-content-between align-items-center text-warning">
                                        <strong>Hedef Grup: @intervention.TargetGroup</strong>
                                        <span class="badge bg-dark">@intervention.AffectedStudentCount Öğrenci</span>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="row g-4">
                                        <!-- Interventions -->
                                        <div class="col-lg-6">
                                            <h6 class="text-secondary mb-3">
                                                <i class="bi bi-gear-fill"></i> Müdahaleler
                                            </h6>
                                            <ul class="small mb-0">
                                                @foreach (string specific in intervention.SpecificInterventions)
                                                {
                                                    <li class="mb-2">@specific</li>
                                                }
                                            </ul>
                                        </div>
                                        <!-- Details -->
                                        <div class="col-lg-6">
                                            <div class="mb-3">
                                                <strong class="text-muted small">Zaman Çizelgesi:</strong>
                                                <p class="mb-0">@intervention.Timeline</p>
                                            </div>
                                            <div class="mb-3">
                                                <strong class="text-muted small">Sorumlu:</strong>
                                                <p class="mb-0">@intervention.ResponsibleParty</p>
                                            </div>
                                            @if (intervention.SuccessIndicators.Count > 0)
                                            {
                                                <div>
                                                    <strong class="text-muted small d-block mb-2">Başarı Göstergeleri:</strong>
                                                    <ul class="small mb-0">
                                                        @foreach (string indicator in intervention.SuccessIndicators)
                                                        {
                                                            <li>@indicator</li>
                                                        }
                                                    </ul>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </section>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- Empty State -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="bi bi-robot text-muted" style="font-size: 5rem;"></i>
                    <h4 class="text-primary mt-4 mb-3">Yapay Zeka Analizi Bekleniyor</h4>
                    <p class="text-muted mb-0 mx-auto" style="max-width: 500px;">
                        Şu anda yapay zekâ analizi bulunmuyor. Sistem hazır durumda,
                        analiz tamamlandığında sonuçlar burada görüntülenecektir.
                    </p>
                </div>
            </div>
        </div>
    </div>
}

@code
{
    [Parameter]
    public AIAnalysisResponse? aIAnalysisResponse { get; set; }
}