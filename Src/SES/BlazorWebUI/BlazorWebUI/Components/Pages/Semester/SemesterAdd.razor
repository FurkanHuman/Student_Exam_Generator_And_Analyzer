@page "/SemesterAdd"
@rendermode InteractiveServer
@using Application.Features.Semesters.Commands.Create
@using Application.Features.Semesters.Queries.GetList
@using BlazorWebUI.Client.Pages.Styles
@using NArchitecture.Core.Application.Responses

<PageTitle>Dönem Ekle</PageTitle>

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h3 class="mb-0">
                        <i class="bi bi-calendar-plus me-2"></i>Dönem Ekle
                    </h3>
                </div>
                <div class="card-body">
                    @if (_isSuccess)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle me-2"></i>
                            <strong>Başarılı!</strong> Dönem başarıyla eklendi.
                            <button type="button" class="btn-close" @onclick="() => _isSuccess = false"></button>
                        </div>
                    }

                    @if (_isLoading)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-warning" role="status">
                                <span class="visually-hidden">Yükleniyor...</span>
                            </div>
                        </div>
                    }

                    <EditForm method="post" OnValidSubmit="Submit" Model="_semesterForm" FormName="SemesterAddForm">
                        <DataAnnotationsValidator />
                        <AntiforgeryToken />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">
                                    <i class="bi bi-calendar-check me-1"></i>Başlangıç Tarihi
                                </label>
                                <InputDate class="form-control"
                                           @bind-Value="_semesterForm.BeginSemesterDate"
                                           min="1920-01-01" />
                                <div class="form-text">
                                    <i class="bi bi-lightbulb me-1"></i>
                                    Dönemin başlangıç tarihini seçiniz
                                </div>
                                <ValidationMessage For="@(() => _semesterForm.BeginSemesterDate)" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">
                                    <i class="bi bi-calendar-x me-1"></i>Bitiş Tarihi
                                </label>
                                <InputDate class="form-control"
                                           @bind-Value="_semesterForm.EndSemesterDate"
                                           min="1920-01-01" />
                                <div class="form-text">
                                    <i class="bi bi-lightbulb me-1"></i>
                                    Dönemin bitiş tarihini seçiniz
                                </div>
                                <ValidationMessage For="@(() => _semesterForm.EndSemesterDate)" />
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold">
                                    <i class="bi bi-tag me-1"></i>Dönem Adı
                                </label>
                                <InputText type="text" class="form-control"
                                           @bind-Value="_semesterForm.Name"
                                           placeholder="Örn: Güz Dönemi, Bahar Dönemi, Yaz Okulu" />
                                <div class="form-text">
                                    <i class="bi bi-lightbulb me-1"></i>
                                    Döneme açıklayıcı bir isim veriniz
                                </div>
                                <ValidationMessage For="@(() => _semesterForm.Name)" />
                            </div>

                            @if (ShowPreview())
                            {
                                <div class="col-12">
                                    <div class="card border-warning">
                                        <div class="card-body">
                                            <h6 class="card-title">
                                                <i class="bi bi-eye me-1"></i>Dönem Önizleme
                                            </h6>
                                            <div class="row">
                                                <div class="col-md-12">
                                                    <p class="mb-2">
                                                        <strong>Dönem Adı:</strong>
                                                        <span class="text-primary">@_semesterForm.Name</span>
                                                    </p>
                                                    <p class="mb-2">
                                                        <strong>Tarih Aralığı:</strong>
                                                        @_semesterForm.BeginSemesterDate.ToString("dd/MM/yyyy") -
                                                        @_semesterForm.EndSemesterDate.ToString("dd/MM/yyyy")
                                                    </p>
                                                    <p class="mb-0">
                                                        <strong>Süre:</strong>
                                                        @CalculateDuration() gün
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            @if (_semesterForm.EndSemesterDate < _semesterForm.BeginSemesterDate)
                            {
                                <div class="col-12">
                                    <div class="alert alert-danger" role="alert">
                                        <i class="bi bi-exclamation-triangle me-2"></i>
                                        Bitiş tarihi başlangıç tarihinden önce olamaz!
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <button type="button" class="btn btn-secondary" @onclick="ResetForm">
                                <i class="bi bi-arrow-counterclockwise me-1"></i>Sıfırla
                            </button>
                            <button type="submit" class="btn btn-warning" disabled="@(!CanSubmit())">
                                <i class="bi bi-save me-1"></i>Kaydet
                            </button>
                        </div>

                        <ValidationSummary class="mt-3" />
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-list-ul me-2"></i>Kayıtlı Dönemler
                    </h5>
                </div>
                <div class="card-body">
                    @if (!_previousSemesters.Items.Any())
                    {
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                            <p class="mt-2">Henüz dönem kaydı bulunmuyor</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-sm">
                                <thead class="table-light">
                                    <tr>
                                        <th>Dönem</th>
                                        <th>Tarih Aralığı</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var semester in _previousSemesters.Items.OrderByDescending(s => s.BeginSemesterDate).Take(10))
                                    {
                                        var isRecent = semester.EndSemesterDate >= DateOnly.FromDateTime(DateTime.Now);
                                        <tr class="@(isRecent ? "table-warning" : "")">
                                            <td>
                                                <strong>@semester.Name</strong>
                                                @if (isRecent)
                                                {
                                                    <span class="badge bg-success ms-1">
                                                        <i class="bi bi-check-circle"></i> Aktif
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <small>
                                                    @semester.BeginSemesterDate.ToString("dd/MM/yy") -
                                                    @semester.EndSemesterDate.ToString("dd/MM/yy")
                                                </small>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (_previousSemesters.Items.Count > 10)
                        {
                            <div class="text-center mt-2">
                                <small class="text-muted">
                                    Son 10 dönem gösteriliyor (Toplam: @_previousSemesters.Items.Count)
                                </small>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<ModalDialog @ref="_modalStatus" Title="Dönem Eklendi">
    <div class="text-center py-3">
        <i class="bi bi-check-circle text-success" style="font-size: 4rem;"></i>
        <h5 class="mt-3">Dönem Başarıyla Eklendi</h5>
        <div class="card bg-light mt-3">
            <div class="card-body">
                <p class="mb-2">
                    <strong>Dönem Adı:</strong>
                    <span class="text-primary">@_semesterForm.Name</span>
                </p>
                <p class="mb-2">
                    <strong>Başlangıç:</strong>
                    @_semesterForm.BeginSemesterDate.ToString("dd/MM/yyyy")
                </p>
                <p class="mb-0">
                    <strong>Bitiş:</strong>
                    @_semesterForm.EndSemesterDate.ToString("dd/MM/yyyy")
                </p>
            </div>
        </div>
    </div>
    <div class="d-flex justify-content-center gap-2 mt-3">
        <button class="btn btn-warning" @onclick="CloseModalAndReset">
            <i class="bi bi-plus-circle me-1"></i>Yeni Dönem Ekle
        </button>
        <button class="btn btn-outline-primary" @onclick="() => _modalStatus.Close()">
            Kapat
        </button>
    </div>
</ModalDialog>

@inject IMediator _IMediator

@code {
    [SupplyParameterFromForm]
    private SemesterForm _semesterForm { get; set; } = new();

    private GetListResponse<GetListSemesterListItemDto> _previousSemesters = new();
    private ModalDialog _modalStatus { get; set; } = new();
    private bool _isSuccess = false;
    private bool _isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;

            // Default tarih ayarları
            _semesterForm.BeginSemesterDate = DateOnly.FromDateTime(DateTime.Now.Date);
            _semesterForm.EndSemesterDate = DateOnly.FromDateTime(DateTime.Now.Date.AddMonths(6));

            var getListSemesterQuery = new GetListSemesterQuery
            {
                PageRequest = new() { PageIndex = 0, PageSize = int.MaxValue }
            };

            _previousSemesters = await _IMediator.Send(getListSemesterQuery);
        }
        finally
        {
            _isLoading = false;
        }

        await base.OnInitializedAsync();
    }

    private async Task Submit()
    {
        try
        {
            _isLoading = true;

            var semesterCommand = new CreateSemesterCommand
            {
                Name = _semesterForm.Name,
                BeginSemesterDate = _semesterForm.BeginSemesterDate,
                EndSemesterDate = _semesterForm.EndSemesterDate
            };

            var result = await _IMediator.Send(semesterCommand);

            _previousSemesters.Items = _previousSemesters.Items.Append(new GetListSemesterListItemDto
            {
                Id = result.Id,
                Name = result.Name,
                BeginSemesterDate = result.BeginSemesterDate,
                EndSemesterDate = result.EndSemesterDate
            }).ToList();

            _isSuccess = true;
            _modalStatus.Open();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Dönem ekleme hatası: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ResetForm()
    {
        _semesterForm = new()
        {
            BeginSemesterDate = DateOnly.FromDateTime(DateTime.Now.Date),
            EndSemesterDate = DateOnly.FromDateTime(DateTime.Now.Date.AddMonths(6))
        };
    }

    private void CloseModalAndReset()
    {
        _modalStatus.Close();
        ResetForm();
    }

    private bool CanSubmit()
    {
        return !string.IsNullOrWhiteSpace(_semesterForm.Name) &&
               _semesterForm.EndSemesterDate >= _semesterForm.BeginSemesterDate &&
               !_isLoading;
    }

    private bool ShowPreview()
    {
        return !string.IsNullOrWhiteSpace(_semesterForm.Name) &&
               _semesterForm.BeginSemesterDate != default &&
               _semesterForm.EndSemesterDate != default;
    }

    private int CalculateDuration()
    {
        return (_semesterForm.EndSemesterDate.ToDateTime(TimeOnly.MinValue) -
                _semesterForm.BeginSemesterDate.ToDateTime(TimeOnly.MinValue)).Days;
    }

    private class SemesterForm
    {
        public string Name { get; set; } = string.Empty;
        public DateOnly BeginSemesterDate { get; set; }
        public DateOnly EndSemesterDate { get; set; }
    }
}