@page "/SemesterAdd"
@using Application.Features.Semesters.Commands.Create
@using Application.Features.Semesters.Queries.GetList
@using BlazorWebUI.Client.Pages.Styles
@using NArchitecture.Core.Application.Responses
<PageTitle>Dönem ekle</PageTitle>
<h3>Dönem Ekle</h3>

<div class="input-group mb-3">
    
    <EditForm method="post" OnValidSubmit="Submit" Model="_semesterForm" FormName="SemesterAddForm">

        <DataAnnotationsValidator />
        <ValidationSummary />
        <AntiforgeryToken />

        <div class="input-group mb-3" style="width:15rem;">

            <label class="input-group-text">
                Dönem Başlangıc Tarihi :
                <InputDate id="BDate" EnableMinMax="true" Min="1920-01-01" Placeholder="Tarih Giriniz:" @bind-Value="_semesterForm.BeginSemesterDate" />
            </label>
        </div>

        <div class="input-group mb-3" style="width:15rem;">
            <label class="input-group-text">
                Dönem Bitiş Tarihi :
                <InputDate id="EDate" EnableMinMax="true" Min="1920-01-01" Placeholder="Tarih Giriniz:" @bind-Value="_semesterForm.EndSemesterDate" />
            </label>
        </div>

        <div class="mb-3" style="width:15rem;">
            <label class="input-group-text">
                Dönem Adı :
                <InputText type="Text" class="form-control" id="SName" @bind-Value="_semesterForm.Name" />
            </label>
        </div>

        <div class="mb-3" style="width:15rem;">
            <button type="submit" class="btn btn-primary">Kaydet</button>
        </div>

    </EditForm>
</div>

<br />

<br />

<table class="table table-striped">
    <thead>
        <tr>
            <th scope="col">Dönem Adı</th>
            <th scope="col">Başlangıç Tarihi</th>
            <th scope="col">Bitiş Tarihi</th>
        </tr>
    </thead>
    <tbody>

        @foreach (GetListSemesterListItemDto semester in _previousSemesters.Items)
        {
            <tr>
                <td>@semester.Name</td>
                <td>@semester.BeginSemesterDate</td>
                <td>@semester.EndSemesterDate</td>
            </tr>
        }
    </tbody>
</table>

<ModalDialog @ref="_modalStatus" Title="Eklendi">
    <div style="background-color: #d4edda; color: #155724; padding: 1rem; border-radius: 0.25rem;">
        <p>Dönem başarıyla eklendi</p>
        <p>
            <strong>Başlangıç Tarihi:</strong> @(_semesterForm.BeginSemesterDate.ToString("dd/MM/yyyy"))<br />
            <strong>Bitiş Tarihi:</strong> @(_semesterForm.EndSemesterDate.ToString("dd/MM/yyyy"))<br />
            <strong>Dönem Adı:</strong> @_semesterForm.Name<br />
        </p>
        <button class="btn btn-primary" @onclick="() => _modalStatus.Close()">Kapat</button>
    </div>
</ModalDialog>

@inject IMediator _IMediator

@code {
    [SupplyParameterFromForm]
    private SemesterForm _semesterForm { get; set; } = new();

    GetListResponse<GetListSemesterListItemDto> _previousSemesters = new();

    private ModalDialog _modalStatus { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        _semesterForm.BeginSemesterDate = DateOnly.FromDateTime(DateTime.Now.Date);
        _semesterForm.EndSemesterDate = DateOnly.FromDateTime(DateTime.Now.Date.AddMonths(3));

        GetListSemesterQuery getListSemesterQuery = new();
        getListSemesterQuery.PageRequest = new() { PageIndex = 0, PageSize = int.MaxValue };
        _previousSemesters = await _IMediator.Send(getListSemesterQuery);

        await base.OnInitializedAsync();
    }

    private async Task Submit()
    {
        CreateSemesterCommand semesterCommand = new()
            {
                Name = _semesterForm.Name,
                BeginSemesterDate = _semesterForm.BeginSemesterDate,
                EndSemesterDate = _semesterForm.EndSemesterDate
            };

        CreatedSemesterResponse result = await _IMediator.Send(semesterCommand);

        _modalStatus.Open();
    }

    private class SemesterForm
    {
        public string Name { get; set; } = string.Empty;
        public DateOnly BeginSemesterDate { get; set; }
        public DateOnly EndSemesterDate { get; set; }
    }
}
