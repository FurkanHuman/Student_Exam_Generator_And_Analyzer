@page "/SemesterAdd"
@using Application.Features.Semesters.Commands.Create
@using Application.Features.Semesters.Queries.GetList
@using NArchitecture.Core.Application.Responses
<PageTitle>Dönem ekle</PageTitle>
<h3>Dönem Ekle</h3>

<div class="input-group mb-3">
    
    <EditForm method="post" OnValidSubmit="Submit" Model="semesterForm" FormName="SemesterAddForm">

        <DataAnnotationsValidator />
        <ValidationSummary />
        <AntiforgeryToken />

        <div class="input-group mb-3" style="width:15rem;">

            <label class="input-group-text">
                Dönem Başlangıc Tarihi :
                <InputDate id="BDate" EnableMinMax="true" Min="1920-01-01" Placeholder="Tarih Giriniz:" @bind-Value="semesterForm.BeginSemesterDate" />
            </label>
        </div>

        <div class="input-group mb-3" style="width:15rem;">
            <label class="input-group-text">
                Dönem Bitiş Tarihi :
                <InputDate id="EDate" EnableMinMax="true" Min="1920-01-01" Placeholder="Tarih Giriniz:" @bind-Value="semesterForm.EndSemesterDate" />
            </label>
        </div>

        <div class="mb-3" style="width:15rem;">
            <label class="input-group-text">
                Dönem Adı :
                <InputText type="Text" class="form-control" id="SName" @bind-Value="semesterForm.Name" />
            </label>
        </div>

        <div class="mb-3" style="width:15rem;">
            <button type="submit" class="btn btn-primary">Kaydet</button>
        </div>

    </EditForm>
</div>

<br />

<br />

<table class="table table-striped">
    <thead>
        <tr>
            <th scope="col">Dönem Adı</th>
            <th scope="col">Başlangıç Tarihi</th>
            <th scope="col">Bitiş Tarihi</th>
        </tr>
    </thead>
    <tbody>

        @foreach (GetListSemesterListItemDto semester in prewSemester.Items)
        {
            <tr>
                <td>@semester.Name</td>
                <td>@semester.BeginSemesterDate</td>
                <td>@semester.EndSemesterDate</td>
            </tr>
        }
    </tbody>
</table>

@inject IMediator _IMediator

@code {
    [SupplyParameterFromForm]
    private SemesterForm semesterForm { get; set; } = new();

    GetListResponse<GetListSemesterListItemDto> prewSemester = new();

    protected override async Task OnInitializedAsync()
    {
        semesterForm.BeginSemesterDate = DateOnly.FromDateTime(DateTime.Now.Date);
        semesterForm.EndSemesterDate = DateOnly.FromDateTime(DateTime.Now.Date.AddMonths(6));

        GetListSemesterQuery getListSemesterQuery = new();
        getListSemesterQuery.PageRequest = new() { PageIndex = 0, PageSize = int.MaxValue };
        prewSemester = await _IMediator.Send(getListSemesterQuery);

        await base.OnInitializedAsync();
    }

    private async Task Submit()
    {
        CreateSemesterCommand semesterCommand = new()
            {
                Name = semesterForm.Name,
                BeginSemesterDate = semesterForm.BeginSemesterDate,
                EndSemesterDate = semesterForm.EndSemesterDate
            };

        CreatedSemesterResponse result = await _IMediator.Send(semesterCommand);
    }

    private class SemesterForm
    {
        public string Name { get; set; } = string.Empty;
        public DateOnly BeginSemesterDate { get; set; }
        public DateOnly EndSemesterDate { get; set; }
    }
}
