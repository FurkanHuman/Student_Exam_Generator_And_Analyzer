@using Application.Features.Exams.Queries.GetListExamByLessonId
@using Application.Features.Lessons.Queries.GetListLessonQueryBySemesterId
@using Application.Features.Semesters.Queries.GetLatestSemesterId
@using NArchitecture.Core.Application.Responses

@rendermode InteractiveServer
@inject IMediator _mediator

@code
{
    [Parameter]
    public bool IsVisible { get; set; } = false;

    [Parameter]
    public EventCallback<IEnumerable<GetListExamByLessonIdDto>> OnExamsSelected { get; set; }

    private int? _selectedLessonId { get; set; }
    private DateOnly? _selectedDate { get; set; }
    private HashSet<DateOnly> _examDates { get; set; } = new();
    private GetListResponse<GetListExamByLessonIdDto> _getListExamsByLesson { get; set; } = new();
    private GetListResponse<GetListLessonQueryBySemesterIdDto> _getListLessons { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        int currentSemesterId = await _mediator.Send(new GetLatestSemesterIdQuery());

        _getListLessons = await _mediator.Send(new GetListLessonQueryBySemesterIdQuery() { SemesterId = currentSemesterId });

        await base.OnInitializedAsync();
    }

    private async Task SelectLesson(int lessonId)
    {
        _selectedLessonId = lessonId;
        _getListExamsByLesson = await _mediator.Send(new GetListExamByLessonIdQuery() { LessonId = lessonId });
        _examDates = new HashSet<DateOnly>(_getListExamsByLesson.Items.Select(e => e.ExamDate)).ToHashSet();
        StateHasChanged();
    }

    private async Task SelectDate(DateOnly date)
    {
        _selectedDate = date;
        _getListExamsByLesson.Items = _getListExamsByLesson.Items.Where(e => e.ExamDate == date).ToList();
        await OnExamsSelected.InvokeAsync(_getListExamsByLesson.Items);
        IsVisible = true;
        StateHasChanged();
    }
}

@if (IsVisible)
{
    <div class="form-control">
        <div class="btn-group m-2">
            <button class="btn btn-secondary btn-lg dropdown-toggle" type="button" data-bs-toggle="dropdown">
                @(_selectedLessonId.HasValue? _getListLessons.Items.FirstOrDefault(s => s.Id == _selectedLessonId)?.LessonName : "Ders Seç")
            </button>
            <ul class="dropdown-menu">
                @foreach (var lessonDto in _getListLessons.Items)
                {
                    <li @onclick="() => SelectLesson(lessonDto.Id)" class="dropdown-item">@($"{lessonDto.LessonName}")</li>
                }
            </ul>
        </div>


        @if (_examDates.Count > 0)
        {
            <div class="btn-group m-2">
                <button class="btn btn-secondary btn-lg dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    @(_selectedDate.HasValue? _examDates.FirstOrDefault(s => s == _selectedDate) : "Tarih Seç")
                </button>
                <ul class="dropdown-menu">
                    @foreach (DateOnly examDate in _examDates)
                    {
                        <li @onclick="() => SelectDate(examDate)" class="dropdown-item">@($"{examDate.ToString("dd-MM-yyyy")}")</li>
                    }
                </ul>
            </div>
        }
    </div>
}
