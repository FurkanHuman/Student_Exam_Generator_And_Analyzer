@page "/CreateExam"
@using Application.Features.QuizQuestions.Queries.GetByLessonId
@using Application.Features.Semesters.Queries.GetList
@using Application.Features.StudentClasses.Queries.GetList
@using AutoMapper
@using BlazorWebUI.Client.Pages.Styles
@using BlazorWebUI.Client.Pages.Styles.QQ
@using BlazorWebUI.Components.Pages.QuizQuestion
@using NArchitecture.Core.Application.Requests
@using NArchitecture.Core.Application.Responses
@rendermode InteractiveServer
@inject IMediator _mediator
@inject IMapper _mapper

@code
{
    private bool isChecked { get; set; } = false;

    private bool isZeroStage { get; set; } = true;
    private bool isFirstStage { get; set; } = false;
    private bool isSecondStage { get; set; } = false;
    private bool isThirdStage { get; set; } = false;

    private bool isRandomizeQuestions { get; set; } = false;
    private bool isRandomizeOptions { get; set; } = false;

    private int SelectedClass { get; set; }
    private int SelectedExamNumber { get; set; }
    private int SemesterId { get; set; }

    private int ExamScore { get; set; } = 100;
    private string FooterNote { get; set; } = string.Empty;


    private IEnumerable<int> getClassesForAges { get; set; } = [];
    private GetListResponse<GetListSemesterListItemDto> semesterList = new();


    private IList<QQBodyDto> _loadedQQ { get; set; } = [];
    private IList<QQBodyDto> _selectedQQ { get; set; } = [];

    private IList<Ordering> _orderedQQ { get; set; } = [];

    private ExamInfo ExamRequaredInfo { get; set; } = new();
    private ICollection<CheckboxItem<int>> CheckboxItemsForClasses { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        PageRequest pageRequest = new PageRequest() { PageIndex = 0, PageSize = int.MaxValue };

        GetListResponse<GetListStudentClassListItemDto> getClasses = await _mediator.Send(new GetListStudentClassQuery() { PageRequest = pageRequest });

        semesterList = await _mediator.Send(new GetListSemesterQuery(){PageRequest=pageRequest});
        getClassesForAges = getClasses.Items.Select(sc => sc.ClassAge).Distinct().ToList();

        await base.OnInitializedAsync();
    }

    private void ToggleQuestInList(bool isSelected, QQBodyDto qQBody)
    {
        if (isSelected)
            _selectedQQ.Add(qQBody);
        else
            _selectedQQ.Remove(qQBody);
    }

    private void LoadAPool(IList<GetByLessonIdQuizQuestionListItemDto> getByQuizzes)
    {
        _loadedQQ = _mapper.Map<IList<QQBodyDto>>(getByQuizzes);
        isZeroStage = false;
        isFirstStage = true;
    }

    private void FirstStageHandle(MouseEventArgs args)
    {
        isFirstStage = false;
        isSecondStage = true;
    }

    private void SecondStageHandle(MouseEventArgs args)
    {
        _orderedQQ = _selectedQQ.Select((x, i) => new Ordering() { QQId = x.Id, Order = i }).ToList();

        isSecondStage = false;
        isThirdStage = true;
    }

    private void ThirdStageHandle(MouseEventArgs args)
    {
        isThirdStage = false;

        // note: anlık dönem al otomatik
    }

    private string getSecondStageButtonText()
    {
        if (!isRandomizeQuestions)
            return "Soru Sırasını Düzenle";
        return "Sınav Oluştur";
    }

    private class Ordering
    {
        public int QQId { get; set; }
        public int Order { get; set; }
    }

    private class ExamInfo
    {
        public string ExamName { get; set; } = string.Empty;

        public string? FooterNote { get; set; }


        public string? ExamScoreStr { get; set; }

        public int SemesterId { get; set; }

        public int LessonId { get; set; }

        public int SchoolId { get; set; }

        public int RefrenceBenefitId { get; set; }
    }
}

@*
tasarım 3 bölümden olacak.
    1. exam için gerekli bilgiler.
    2. soru havuzundan soruları seçme.
    3. tasarım soruların sırasını belirleme.

1. bölüm: * tamamen yanlış. gereken vertiler altaki gibi ama sadece dönem ve ders seçimi yapılacak. diğerleri otomatik gelecek

    - sınav adı
    - alt not (footer note)
    - puan 
    - puan metinsel (opsiyonel)
    - ders
    - dönem
    - öğrenciler (direkt sınıf yani)
    - okul
    - reference benefit (yani kazanım tablosu)
    - exam code randomizer için seed code
    - sınavın toplam puanı (şuanlık 100 de sabitlenecek). textbox ile değiştirilebilir olacak.
    - sınav öğretmenleri ekle.

2. bölüm:
    - soru havuzunu seçme
    - soru havuzundan soru seçme
    - soruların puanlarını belirleme ama var olan skor ile max skor arasında olabilir.

3. bölüm:
    - seçilen soruları sıralama

sınavı oluştur butonuna basıldığında aksiyon zamanı.

*@


<h3>Sınav Oluştur</h3>
<p>Soru havuzunu seçtikten sonra önce soruları belirleyin, ardından soruların sırasını düzenleyin. Eğer bir sıra belirtmezseniz, fazladan seçtiğiniz sorular rastgele yerleştirilecektir.</p>

@if (isZeroStage)
{
    <QuizPoolLoader OnQQList="LoadAPool" />
}

@if (isFirstStage)
{
    //sınıf secçimi ekle  o döneme ait

    <div class="form-control container p-3 bg-light shadow-sm rounded">

        <div class="input-group mb-3" style="width:12rem;">
            <label class="input-group-text">Sınav Puanı: </label>
            <InputNumber type="Text" class="form-control conversion" id="name" @bind-Value="ExamScore" disabled="true" />
        </div>

        <div class="input-group mb-3" style="width:15rem;">
            <label class="input-group-text">Alt Not: </label>
            <InputText type="Text" class="form-control conversion" id="name" @bind-Value="FooterNote" />
        </div>

        <div class="input-group mb-3" style="width:15rem;">
            <label class="input-group-text">Dönem Seçiniz:</label>
            <InputSelect class="form-select" id="principalSG" @bind-Value="SemesterId">
                <option selected>Seçiniz...</option>
                @foreach (GetListSemesterListItemDto? semester in semesterList.Items)
                {
                    <option value="@semester.Id">@semester.BeginSemesterDate @semester.EndSemesterDate @semester.Name </option>
                }
            </InputSelect>
        </div>

        <div class="input-group mb-3" style="width:15rem;">
            <label class="input-group-text">sınav sınıfları</label>
            <InputSelect class="form-select" @bind-Value="SelectedClass">
                <option selected>Seçiniz...</option>
                @foreach (int age in getClassesForAges)
                {
                    <option value="@age">@($"{age}. Sınıflar")</option>
                }
            </InputSelect>
        </div>

        <div class="input-group mb-3" style="width:15rem;">
            <label class="input-group-text">sınav sınıfları</label>
            <InputSelect class="form-select" @bind-Value="SelectedExamNumber">
                <option selected>Seçiniz...</option>
                @for (int examNumber = 1; examNumber != 10; examNumber++)
                {
                    <option value="@examNumber">@($"{examNumber}. yazılı")</option>
                }
            </InputSelect>
        </div>

        <div class="form-check form-check-inline">
            <InputCheckbox class="form-check-input" type="checkbox" id="inlineCheckbox1" @bind-value="isRandomizeQuestions" />
            <label class="form-check-label" for="inlineCheckbox1">Soruları karıştır.</label>
        </div>

        <div class="form-check form-check-inline">
            <InputCheckbox class="form-check-input" type="checkbox" id="inlineCheckbox2" @bind-value="isRandomizeOptions" />
            <label class="form-check-label" for="inlineCheckbox2">Seçenekleri karıştır.</label>
        </div>
@* 
        <div class="form-check form-check-inline">
            <InputCheckbox class="form-check-input" type="checkbox" id="inlineCheckbox3" @bind-value="isRandomizeOptions" />
            <label class="form-check-label" for="inlineCheckbox3">Optik kodlama ekle.</label>
        </div>

        <div class="form-check form-check-inline">
            <InputCheckbox class="form-check-input" type="checkbox" id="inlineCheckbox4" @bind-value="isRandomizeOptions" />
            <label class="form-check-label" for="inlineCheckbox4">Standart Seçenekler.</label>
        </div>

        <div class="form-check form-check-inline">
            <InputCheckbox class="form-check-input" type="checkbox" id="inlineCheckbox5" @bind-value="isRandomizeOptions" />
            <label class="form-check-label" for="inlineCheckbox5">.</label>
        </div>

        <div class="form-check form-check-inline">
            <InputCheckbox class="form-check-input" type="checkbox" id="inlineCheckbox6" @bind-value="isRandomizeOptions" />
            <label class="form-check-label" for="inlineCheckbox6">.</label>
        </div> *@

        <button class="btn btn-primary" @onclick="FirstStageHandle">İleri</button>

    </div>
}

@if (isSecondStage)
{
    <div class="form-control">
        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
            <button class="btn btn-primary" @onclick="SecondStageHandle">@getSecondStageButtonText()</button>
        </div>

        @foreach (QQBodyDto quest in _loadedQQ)
        {
            <div class="container p-3 my-5 d-flex align-items-start bg-light shadow-sm rounded">
                <InputCheckbox class="form-check-input fs-3 me-3 mt-1" type="checkbox" id="flexCheckDefault" ValueChanged="(e) => ToggleQuestInList(e,quest)" ValueExpression="() => isChecked" />
                <div class="flex-grow-1 p-3 bg-white rounded border shadow-sm">
                    <QQView QQBody="quest" />
                </div>
            </div>
        }
    </div>
}

@if (isThirdStage)
{
    <div class="form-control">

        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
            <button class="btn btn-primary" @onclick="ThirdStageHandle">Sınav Oluştur</button>
        </div>

        @foreach (Ordering q in _orderedQQ.OrderBy(q => q.Order == 0 ? int.MaxValue : q.Order))
        {
            <div class="container p-3 my-5 d-flex align-items-start bg-light shadow-sm rounded">
                <InputNumber class="form-control me-3 text-center" min="0" @bind-Value="q.Order" style="width:5rem" />
                <div class="flex-grow-1 p-3 bg-white rounded border shadow-sm">
                    <QQView QQBody="_selectedQQ.First(qq => qq.Id == q.QQId)" />
                </div>
            </div>
        }
    </div>
}

