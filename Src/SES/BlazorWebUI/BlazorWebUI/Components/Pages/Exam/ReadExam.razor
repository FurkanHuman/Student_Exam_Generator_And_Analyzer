@page "/ReadExam"
@using Application.Features.Exams.Queries.GetListExamByLessonId
@using Application.Features.QuizQuestions.Queries.GetQuizQuestionsByIds
@using Application.Features.StudentExamAnswers.Commands.Create
@using Application.Features.Students.Queries.GetStudentsByIds
@using Application.Services.PdfFactory.CreateExamPdf.DTOs
@using Application.Services.PdfFactory.CreateExamPdf.Helpers
@using Application.Services.Personels
@using AutoMapper
@using BlazorWebUI.Client.Pages.Styles
@using BlazorWebUI.Client.Pages.Styles.QQ
@using Domain.Entities
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using NArchitecture.Core.Application.Responses
@using System.Text.Json
@using System.Security.Claims

@rendermode InteractiveServer
@attribute [Authorize(policy: "ReadExam")]
@inject IMediator _mediator
@inject IMapper _mapper
@inject IPersonelService _personelService
@inject UserManager<ApplicationUser> _userManager
@inject AuthenticationStateProvider _authStateProvider

<ExamLoader OnExamsSelected="LoadExamFromLoader" IsVisible="_isvisibleForLoader" />

@if (!_lockDown)
{
    <div class="container-fluid mt-4">
        <div class="row">

            <div class="col-lg-4 col-md-12 mb-4">
                <div class="sticky-top" style="top: 1rem;">
                    <div class="card shadow-sm">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                Normal
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label for="studentSelect" class="form-label fw-bold">Öğrenci Seçimi</label>
                                <InputSelect id="studentSelect" class="form-select form-select-lg" TValue="int" @bind-Value="_selectedStudentId" @oninput="SelectStudent">
                                    <option value="0" disabled>Lütfen bir öğrenci seçiniz...</option>
                                    @if (_students?.Items != null)
                                    {
                                        @foreach (GetStudentsByIdsListItemDto student in _students.Items)
                                        {
                                            <option value="@student.Id">@($"{student.SchoolNumber} - {student.Name} {student.SurName}")</option>
                                        }
                                    }
                                </InputSelect>
                            </div>

                            <hr />

                            @if (_selectedStudent != null)
                            {
                                <div class="text-center">
                                    <h6 class="card-subtitle mb-2 text-muted">Seçili Öğrenci</h6>
                                    <p class="fs-5 fw-bold text-danger">@($"{_selectedStudent.SchoolNumber} - {_selectedStudent.Name} {_selectedStudent.SurName}")</p>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning text-center" role="alert">
                                    Henüz bir öğrenci seçilmedi.
                                </div>
                            }

                            <div class="mt-3 mb-3">
                                <label for="examEvaStatus" class="form-label fw-bold">Sınav Durumu</label>
                                <InputSelect id="examEvaStatus" class="form-select form-select-lg " TValue="byte" @bind-Value="_examEvaluationStatus" @oninput="SelectExamStatus">
                                    @foreach (KeyValuePair<byte, string> examEvaStatus in QQStatic.ExamEvaluationStatusTUR)
                                    {
                                        <option value="@examEvaStatus.Key">@examEvaStatus.Value</option>
                                    }

                                </InputSelect>

                            </div>

                        </div>
                        <div class="card-footer bg-light text-end">
                            <button class="btn btn-success btn-lg w-100" @onclick="SaveExam" disabled="@(_selectedStudentId == 0)">
                                Cevapları Kaydet
                            </button>
                        </div>
                    </div>
                </div>
            </div>


            <div class="col-lg-8 col-md-12">
                @if (_selectedStudentId != 0 && _quizQuestionsListForExamByOrdered.Any())
                {
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="mb-0">
                            Sınav Soruları
                        </h4>
                        <span class="badge bg-secondary rounded-pill fs-6">Toplam @_quizQuestionsListForExamByOrdered.Count Soru</span>
                    </div>

                    @foreach (QQBodyDto qq in _quizQuestionsListForExamByOrdered)
                    {
                        _questionOrder++;
                        <div class="mb-4">
                            <QuestionAnswerInput @key="@($"question_{qq.Id}_{_selectedStudentId}")"
                                                 QuestionData="qq"
                                                 OnQAnswer="(answer) => QuestionAnswerHandler(answer, qq.Id)"
                                                 IsCustomScore="false"
                                                 Seed="_golablSeed"
                                                 QuestionOrder="_questionOrder"
                                                 ExistingAnswer="@GetExistingAnswer(qq.Id)" />
                        </div>
                    }
                }

                else if (_selectedStudentId != 0)
                {
                    <div class="alert alert-info mt-4">
                        Bu öğrenci için gösterilecek soru bulunmuyor.
                    </div>
                }
            </div>

        </div>
    </div>
}

<ModalDialog @ref="_modalOfSaving" Title="İşlem Başarılı!">
    <div class="alert alert-success d-flex flex-column align-items-center p-4" role="alert">
        <h4 class="alert-heading">Harika!</h4>
        <p>Öğrencinin cevapları başarıyla kayıt edildi.</p>
        <hr>
        <p class="mb-0">Sıradaki öğrenciye geçmek için tıklayınız.</p>
        <button class="btn btn-primary mt-3" @onclick="NextStudent">
            Sonraki Öğrenci
        </button>
    </div>
</ModalDialog>


@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private ModalDialog _modalOfSaving { get; set; } = default!;

    private bool _isvisibleForLoader { get; set; } = true;
    private bool _lockDown { get; set; } = true;
    private byte _examEvaluationStatus { get; set; } = 0;
    private int _selectedStudentId { get; set; } = 0;
    private int _golablSeed { get; set; } = 0;
    private int _questionOrder { get; set; } = 0;

    private Guid _personelGuid;
    private Guid _tempPersonelId; 
    private bool _personelLoaded = false; 

    private GetStudentsByIdsListItemDto _selectedStudent { get; set; } = default!;
    private GetListExamByLessonIdDto _selectedExam { get; set; } = default!;
    private ExamInfo _selectedExamInfo { get; set; } = default!;

    private IEnumerable<GetListExamByLessonIdDto> _exams { get; set; } = [];
    private IEnumerable<QQBodyDto> _quizQuestionsList { get; set; } = [];
    private IList<QQBodyDto> _quizQuestionsListForExamByOrdered { get; set; } = [];
    private IList<QuestionAnswerDto> _questionAnswers { get; set; } = [];

    private GetListResponse<GetStudentsByIdsListItemDto> _students { get; set; } = default!;
    private GetListResponse<GetQuizQuestionsByIdsListItemDto> _quizQuestions { get; set; } = default!;
    protected override async Task OnInitializedAsync()
    {
        AuthenticationState authState = await _authStateProvider.GetAuthenticationStateAsync();
        ClaimsPrincipal userPrincipal = authState.User;

        if (userPrincipal.Identity?.IsAuthenticated == true)
        {
            ApplicationUser? user = await _userManager.GetUserAsync(userPrincipal);
            if (user != null && user.PersonelId != Guid.Empty)
                _tempPersonelId = user.PersonelId;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_personelLoaded && _tempPersonelId != Guid.Empty)
        {
            _personelLoaded = true;
            try
            {
                Personel? personel = await _personelService.GetByIdAsync(_tempPersonelId);
                if (personel != null)
                {
                    _personelGuid = personel.Id;
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error: {ex.Message}");
            }
        }
    }

    private async Task LoadExamFromLoader(IEnumerable<GetListExamByLessonIdDto> args)
    {
        if (args == null || !args.Any())
            return;
        _exams = args;
        IEnumerable<int> QuestionIds = _exams.SelectMany(x => x.QuizQuestionsIds).ToHashSet();
        IEnumerable<int> StudentIds = _exams.Select(x => x.StudentId).ToHashSet();


        _quizQuestions = await _mediator.Send(new GetQuizQuestionsByIdsQuery() { Ids = QuestionIds });
        _students = await _mediator.Send(new GetStudentsByIdsQuery() { Ids = StudentIds });

        _quizQuestionsList = _mapper.Map<IEnumerable<QQBodyDto>>(_quizQuestions.Items);

        _isvisibleForLoader = false;
        _lockDown = false;
        StateHasChanged();
    }

    private void QuestionAnswerHandler(QuestionAnswerDto answer, int id)
    {
        _questionOrder = 0;
        if (answer == null || id <= 0)
            return;

        QuestionAnswerDto? existingAnswer = _questionAnswers.FirstOrDefault(x => x.QuizQuestionId == id);

        if (existingAnswer != null)
        {
            existingAnswer.AnswerText = answer.AnswerText;
            existingAnswer.GivenScore = answer.GivenScore;
            existingAnswer.QuestionOptionId = answer.QuestionOptionId;
            existingAnswer.EvaluationStatus = answer.EvaluationStatus;
        }

        else
        {
            _questionAnswers.Add(new QuestionAnswerDto
            {
                QuizQuestionId = id,
                AnswerText = answer.AnswerText,
                GivenScore = answer.GivenScore,
                QuestionOptionId = answer.QuestionOptionId,
                EvaluationStatus = answer.EvaluationStatus
            });
        }

        _examEvaluationStatus = 1;

    }

    private QuestionAnswerDto? GetExistingAnswer(int questionId)
    {
        return _questionAnswers.FirstOrDefault(x => x.QuizQuestionId == questionId);
    }

    private async Task SaveExam()
    {
        _modalOfSaving.Open();

        CreateStudentExamAnswerCommand cmd = new()
        {
            StudentQuestionAnswers = _mapper.Map<IList<StudentQuestionAnswerDto>>(_questionAnswers),
            ReviewerPersonelId = _personelGuid,
            EvaluationOrigin = 1,
            ExamId = _selectedExam.Id,
            ExamEvaluationStatus = _examEvaluationStatus,
            StudentId = _selectedStudent.Id
        };

        await _mediator.Send(cmd);
    }

    private void PrepareStudentExam(int studentId)
    {
        if (studentId == 0)
        {
            _selectedStudent = default!;
            _quizQuestionsListForExamByOrdered = [];
            _questionAnswers.Clear();
            return;
        }

        _selectedStudent = _students.Items.FirstOrDefault(x => x.Id == studentId, defaultValue: default!);
        _selectedExam = _exams.FirstOrDefault(x => x.StudentId == studentId, default!);

        if (_selectedExam == null) return;

        _questionAnswers.Clear();

        IList<QQBodyDto> qQBodies = _quizQuestionsList.Where(x => _selectedExam.QuizQuestionsIds.Contains(x.Id)).ToList();

        _selectedExamInfo = JsonSerializer.Deserialize<ExamInfo>(_selectedExam.ExamConfigurationStr)!;

        int seed = (int)ExamQQHelper.DecodeBase32String(_selectedExam.ExamCode);
        _golablSeed = seed;

        ExamQQHelper.ShuffleQuizQuestions(ref qQBodies, _selectedExamInfo, seed);
        ExamQQHelper.ShuffleAllQuestionOptions(ref qQBodies, _selectedExamInfo, seed);
        ExamQQHelper.OrderQuizQuestions(qQBodies, _selectedExamInfo, seed);

        _quizQuestionsListForExamByOrdered = qQBodies;
    }

    private void SelectStudent(ChangeEventArgs args)
    {
        string raw = args.Value?.ToString() ?? string.Empty;

        if (int.TryParse(raw, out int value))
            _selectedStudentId = value;
        else
            _selectedStudentId = 0;

        _questionOrder = 0;
        _examEvaluationStatus = 0;
        PrepareStudentExam(_selectedStudentId);
    }

    private void NextStudent()
    {
        if (_students?.Items == null || !_students.Items.Any())
            return;

        IList<int> studentIds = _students.Items.Select(s => s.Id).ToList();
        int currentIndex = studentIds.IndexOf(_selectedStudentId);
        int nextIndex = (currentIndex + 1) % studentIds.Count;
        _selectedStudentId = studentIds[nextIndex];

        _questionOrder = 0;
        _students.Items.Remove(_selectedStudent);
        PrepareStudentExam(_selectedStudentId);
        _modalOfSaving.Close();
        StateHasChanged();
    }

    private void SelectExamStatus(ChangeEventArgs args)
    {
        string raw = args.Value?.ToString() ?? string.Empty;
        if (byte.TryParse(raw, out byte value))
            _examEvaluationStatus = value;
        else
            _examEvaluationStatus = 0;
    }
}