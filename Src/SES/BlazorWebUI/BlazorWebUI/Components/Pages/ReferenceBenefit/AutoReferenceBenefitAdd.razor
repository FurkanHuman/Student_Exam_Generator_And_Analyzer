@page "/Auto/BenefitAdd"
@using Application.Features.Benefits.Commands.MultiCreate
@using Application.Features.Lessons.Queries.GetList
@using Application.Features.ReferenceBenefits.Commands.Create
@using Application.Features.Schools.Queries.GetList
@using Application.Features.Semesters.Queries.GetList
@using Application.Services.PdfReaderService
@using Application.Services.PdfReaderService.Dtos
@using static BlazorWebUI.Client.Pages.Styles.EditContentList
@using BlazorWebUI.Client.Pages.Styles
@using NArchitecture.Core.Application.Responses
@rendermode InteractiveServer

<h3>Otomatik Kazanım Ekleyici</h3>

<EditForm OnValidSubmit="AddAotuBenefit" Model="autoBenefitDto">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <AntiforgeryToken />

    <div class="input-group mb-3" style="width:30rem;">
        <label class="input-group-text">Yıllık Adı :</label>
        <InputText type="text" class="form-control" @bind-Value="autoBenefitDto.Name" />
    </div>

    <div class="input-group mb-3" style="width:30rem;">
        <label class="input-group-text">Okul :</label>
        <InputSelect class="form-select" @bind-Value="autoBenefitDto.SchoolId">
            @foreach (GetListSchoolListItemDto school in SchoolResponse.Items)
            {
                <option value="@school.Id">@school.Name</option>
            }
        </InputSelect>
    </div>

    <div class="input-group mb-3" style="width:30rem;">
        <label class="input-group-text">Yıllık Dönemi :</label>
        <InputSelect class="form-select" @bind-Value="autoBenefitDto.SemesterId">
            @foreach (GetListSemesterListItemDto semester in SemesterResponse.Items)
            {
                <option value="@semester.Id">@semester.BeginSemesterDate @semester.EndSemesterDate @semester.Name</option>
            }
        </InputSelect>
    </div>

    <div class="input-group mb-3" style="width:30rem;">
        <label class="input-group-text">Yıllık Dönem Dersi :</label>
        <InputSelect class="form-select" @bind-Value="autoBenefitDto.LessonId">
            @foreach (GetListLessonListItemDto lesson in lessonResponse.Items)
            {
                <option value="@lesson.Id">  @lesson.LessonName @GetSemesterByIdTosString(lesson.SemesterId) </option>
            }
        </InputSelect>
    </div>

    <div class="input-group mb-3" style="width:30rem;">
        <label class="input-group-text">Yıllık plan Dosyası :</label>
        <InputFile type="file" name="FileFromPdf" class="form-control" accept=".pdf" OnChange="HandleFileSelected" disabled="@IsChecked" />

        <InputCheckbox class="form-check" @bind-Value="IsChecked" style="width:5rem;" />
        <label class="form-check-label">Elle Giriş</label>


    </div>

    <div class="mb-3">
        <button type="submit" class="btn btn-primary text-lg-end" disabled="@(!(IsBenefitsOk && IsSubLearningOk && IsLearningOk))">Kaydet</button>
    </div>

</EditForm>

<br />


<div>
    <div class="btn btn-outline-info" @onclick="Toggle">
        @(IsOpen ? "Kapat" : "Aç")
    </div>
    @*
        Todo: üç farklı gösterriş biçimi. düz metin yapıştırma ve düzenleme yapılacak. textboxarea ile yapılması uygundur bu olması gerekir kesin. 
        ağaç tasarım da olacak: konu, alt konu, kazanım. kendi kod kategorilerinde olamsı planlanmıştır.
    *@

    <div>
        @if (IsOpen)
        {
            <h4>Başlıklar</h4>
            <hr />
            <EditContentList EditContents="EditContentLearning" />
            <hr />

            <div class="input-group mb-3" style="width:30rem;">
                <label class="form-check-label">Başlıkların Doğru Olduğunu Onaylıyorum</label>
                <InputCheckbox class="form-check" @bind-Value="IsLearningOk" style="width:5rem;" />
            </div>

            <h4>Alt Başlıklar</h4>
            <hr />
            <EditContentList EditContents="EditContentSubLearning" />
            <hr>

            <div class="input-group mb-3" style="width:30rem;">
                <label class="form-check-label">Alt Başlıkların Doğru Olduğunu Onaylıyorum</label>
                <InputCheckbox class="form-check" @bind-Value="IsSubLearningOk" style="width:5rem;" />
            </div>


            <h4>Kazanımlar</h4>
            <hr />
            <EditContentList EditContents="EditContentBenefits" />
            <hr>

            <div class="input-group mb-3" style="width:30rem;">
                <label class="form-check-label"> Kazanımların Doğru Olduğunu Onaylıyorum</label>
                <InputCheckbox class="form-check" @bind-Value="IsBenefitsOk" style="width:5rem;" />
            </div>

        }
        else
        {
            <span>Açmak için Dokunun</span>
        }
    </div>

    @*
    <div>
        <InputTextArea />
    </div>
*@

</div>

@inject IPdfReaderService _pdfReaderService
@inject IMediator _mediator

@code {
    [SupplyParameterFromForm]
    private RefBenDto autoBenefitDto { get; set; } = new();

    GetListResponse<GetListLessonListItemDto> lessonResponse = new();
    GetListResponse<GetListSchoolListItemDto> SchoolResponse = new();
    GetListResponse<GetListSemesterListItemDto> SemesterResponse = new();

    private string EditContentPlainText { get; set; } = string.Empty;

    private List<EditContent> GetAllEditContents()
    {
        List<EditContent> allEditContents = [];
        allEditContents.AddRange(EditContentBenefits);
        allEditContents.AddRange(EditContentSubLearning);
        allEditContents.AddRange(EditContentLearning);
        return allEditContents;
    }

    List<EditContent> EditContentBenefits = new();
    List<EditContent> EditContentSubLearning = new();
    List<EditContent> EditContentLearning = new();

    private byte[] fileContent = Array.Empty<byte>();

    private bool IsOpen = false;

    private bool IsBenefitsOk = false;
    private bool IsSubLearningOk = false;
    private bool IsLearningOk = false;

    private bool IsChecked { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        lessonResponse = await _mediator.Send(new GetListLessonQuery()
            {
                PageRequest = new()
                {
                    PageIndex = 0,
                    PageSize = int.MaxValue
                }
            });

        SchoolResponse = await _mediator.Send(new GetListSchoolQuery()
            {
                PageRequest = new()
                {
                    PageIndex = 0,
                    PageSize = int.MaxValue
                }
            });

        SemesterResponse = await _mediator.Send(new GetListSemesterQuery()
            {
                PageRequest = new()
                {
                    PageIndex = 0,
                    PageSize = int.MaxValue
                }
            });
        await base.OnInitializedAsync();
    }

    private async Task AddAotuBenefit()
    {
        List<string> lines = [];

        lines.AddRange(EditContentBenefits.Select(benefit => benefit.Current).Distinct());
        lines.AddRange(EditContentSubLearning.Select(subLearning => subLearning.Current).Distinct());
        lines.AddRange(EditContentLearning.Select(learning => learning.Current).Distinct());

        ReferenceBenefitDto referenceBenefitDto = _pdfReaderService.ProcessReferenceBenefit(lines);

        referenceBenefitDto.RBName = autoBenefitDto.Name;


        referenceBenefitDto.LessonId = autoBenefitDto.LessonId;
        referenceBenefitDto.SemesterId = autoBenefitDto.SemesterId;
        referenceBenefitDto.SchoolId = autoBenefitDto.SchoolId;

        await _mediator.Send(new CreateReferenceBenefitCommand
            {
                ReferenceBenefitDto = referenceBenefitDto
            });
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        IBrowserFile file = e.File;
        if (file == null)
            return;

        using MemoryStream memoryStream = new();

        await file.OpenReadStream().CopyToAsync(memoryStream);
        fileContent = memoryStream.ToArray();
        ICollection<RawBenefitReferenceDto> rawRefBenefits = await _pdfReaderService.GetAllReferenceBenefitsWithAltersDtos(fileContent);
        foreach (RawBenefitReferenceDto rawBenefit in rawRefBenefits)
        {
            if (rawBenefit.Benefits != null)
                EditContentBenefits.AddRange(rawBenefit.Benefits.Select(benefit => new EditContent { Current = benefit }));

            if (rawBenefit.SubLearningAreas != null)
                EditContentSubLearning.AddRange(rawBenefit.SubLearningAreas.Select(subLearning => new EditContent { Current = subLearning }));

            if (rawBenefit.LearningAreas != null)
                EditContentLearning.AddRange(rawBenefit.LearningAreas.Select(learning => new EditContent { Current = learning }));
        }
        IsOpen = true;
    }

    private void Toggle(MouseEventArgs e)
    {
        IsOpen = !IsOpen;
    }

    private void OnCheckboxChanged(ChangeEventArgs e)
    {
        if (e.Value == null)
            return;

        IsChecked = (bool)e.Value;
    }

    private string GetSemesterByIdTosString(int id)
    {
        GetListSemesterListItemDto s = SemesterResponse.Items.First(x => x.Id == id);
        return $"{s.BeginSemesterDate.Year} - {s.EndSemesterDate.Year} {s.Name}";
    }

    private void OnEditContentChanged(ChangeEventArgs e)
    {


    }

    private class RefBenDto
    {
        public string Name { get; set; } = string.Empty;
        public int LessonId { get; set; }
        public int SchoolId { get; set; }
        public int SemesterId { get; set; }
    }
}
