@page "/Auto/BenefitAdd"
@using Application.Features.Benefits.Commands.MultiCreate
@using Application.Features.Lessons.Queries.GetList
@using Application.Features.ReferenceBenefits.Commands.Create
@using Application.Features.Schools.Queries.GetList
@using Application.Features.Semesters.Queries.GetList
@using Application.Services.PdfFactory.PdfReaderService
@using Application.Services.PdfFactory.PdfReaderService.Dtos
@using BlazorWebUI.Client.Pages.Styles
@using NArchitecture.Core.Application.Responses
@using static BlazorWebUI.Client.Pages.Styles.EditContentList
@rendermode InteractiveServer

<h3>Otomatik Kazanım Ekleyici</h3>

<ModalDialog @ref="_modalDialog" Title="Başarılı bir şekilde eklendi">

    <button class="btn btn-primary" @onclick="() => _modalDialog.Close()">Tamam</button>
</ModalDialog>

@if (_isSuccess)
{
    <br />
    <div class="alert alert-success" role="alert">
        Başarıyla eklendi!
    </div>
}

<EditForm OnValidSubmit="AddAutoBenefit" Model="_autoBenefitDto">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <AntiforgeryToken />

    <div class="input-group mb-3" style="width:30rem;">
        <label class="input-group-text">Yıllık Adı :</label>
        <InputText type="text" class="form-control" @bind-Value="_autoBenefitDto.Name" />
    </div>

    <div class="input-group mb-3" style="width:30rem;">
        <label class="input-group-text">Okul :</label>
        <InputSelect class="form-select" @bind-Value="_autoBenefitDto.SchoolId">
            @foreach (GetListSchoolListItemDto school in _schoolResponse.Items)
            {
                <option value="@school.Id">@school.Name</option>
            }
        </InputSelect>
    </div>

    <div class="input-group mb-3" style="width:30rem;">
        <label class="input-group-text">Yıllık Dönemi :</label>
        <InputSelect class="form-select" @bind-Value="_autoBenefitDto.SemesterId">
            @foreach (GetListSemesterListItemDto semester in _semesterResponse.Items)
            {
                <option value="@semester.Id">@semester.BeginSemesterDate @semester.EndSemesterDate @semester.Name</option>
            }
        </InputSelect>
    </div>

    <div class="input-group mb-3" style="width:30rem;">
        <label class="input-group-text">Yıllık Dönem Dersi :</label>
        <InputSelect class="form-select" @bind-Value="_autoBenefitDto.LessonId">
            @foreach (GetListLessonListItemDto lesson in _lessonResponse.Items)
            {
                <option value="@lesson.Id">  @lesson.LessonName @GetSemesterByIdTosString(lesson.SemesterId) </option>
            }
        </InputSelect>
    </div>

    <div class="input-group mb-3" style="width:30rem;">
        <label class="input-group-text">Yıllık plan Dosyası :</label>
        <InputFile type="file" name="FileFromPdf" class="form-control" accept=".pdf" OnChange="HandleFileSelected" disabled="@_isChecked" />

        <InputCheckbox class="form-check" @bind-Value="_isChecked" style="width:5rem;" />
        <label class="form-check-label">Elle Giriş</label>
    </div>

    <div class="mb-3">
        <button type="submit" class="btn btn-primary text-lg-end" disabled="@(!(_isBenefitsOk && _isSubLearningOk && _isLearningOk))">Kaydet</button>
    </div>

</EditForm>

<br />


<div>
    <div class="btn btn-outline-info" @onclick="Toggle">
        @(_isOpen ? "Kapat" : "Aç")
    </div>
    @*
        Todo: üç farklı gösterriş biçimi. düz metin yapıştırma ve düzenleme yapılacak. textboxarea ile yapılması uygundur bu olması gerekir kesin. 
        ağaç tasarım da olacak: konu, alt konu, kazanım. kendi kod kategorilerinde olamsı planlanmıştır.
    *@

    <div>
        @if (_isOpen)
        {
            <h4>Başlıklar</h4>
            <hr />
            <EditContentList EditContents="_editContentLearning" />
            <hr />

            <div class="input-group mb-3" style="width:30rem;">
                <label class="form-check-label">Başlıkların Doğru Olduğunu Onaylıyorum</label>
                <InputCheckbox class="form-check" @bind-Value="_isLearningOk" style="width:5rem;" />
            </div>

            <h4>Alt Başlıklar</h4>
            <hr />
            <EditContentList EditContents="_editContentSubLearning" />
            <hr>

            <div class="input-group mb-3" style="width:30rem;">
                <label class="form-check-label">Alt Başlıkların Doğru Olduğunu Onaylıyorum</label>
                <InputCheckbox class="form-check" @bind-Value="_isSubLearningOk" style="width:5rem;" />
            </div>


            <h4>Kazanımlar</h4>
            <hr />
            <EditContentList EditContents="_editContentBenefits" />
            <hr>

            <div class="input-group mb-3" style="width:30rem;">
                <label class="form-check-label"> Kazanımların Doğru Olduğunu Onaylıyorum</label>
                <InputCheckbox class="form-check" @bind-Value="_isBenefitsOk" style="width:5rem;" />
            </div>

        }
        else
        {
            <span>Açmak için Dokunun</span>
        }
    </div>

    @*
    <div>
        <InputTextArea />
    </div>
*@

</div>

@inject IPdfReaderService _pdfReaderService
@inject IMediator _mediator
@inject NavigationManager _navigationManager

@code {
    [SupplyParameterFromForm]
    private RefBenDto _autoBenefitDto { get; set; } = new();

    GetListResponse<GetListLessonListItemDto> _lessonResponse = new();
    GetListResponse<GetListSchoolListItemDto> _schoolResponse = new();
    GetListResponse<GetListSemesterListItemDto> _semesterResponse = new();
    private string _editContentPlainText { get; set; } = string.Empty;

    ModalDialog _modalDialog { get; set; } = new();

    private List<EditContent> GetAllEditContents()
    {
        List<EditContent> allEditContents = [];
        allEditContents.AddRange(_editContentBenefits);
        allEditContents.AddRange(_editContentSubLearning);
        allEditContents.AddRange(_editContentLearning);
        return allEditContents;
    }

    List<EditContent> _editContentBenefits = new();
    List<EditContent> _editContentSubLearning = new();
    List<EditContent> _editContentLearning = new();

    private byte[] _fileContent = Array.Empty<byte>();

    private bool _isSuccess = false;

    private bool _isOpen = false;

    private bool _isBenefitsOk = false;
    private bool _isSubLearningOk = false;
    private bool _isLearningOk = false;

    private bool _isChecked { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        _lessonResponse = await _mediator.Send(new GetListLessonQuery()
            {
                PageRequest = new()
                {
                    PageIndex = 0,
                    PageSize = int.MaxValue
                }
            });

        _schoolResponse = await _mediator.Send(new GetListSchoolQuery()
            {
                PageRequest = new()
                {
                    PageIndex = 0,
                    PageSize = int.MaxValue
                }
            });

        _semesterResponse = await _mediator.Send(new GetListSemesterQuery()
            {
                PageRequest = new()
                {
                    PageIndex = 0,
                    PageSize = int.MaxValue
                }
            });
        await base.OnInitializedAsync();
    }

    private async Task AddAutoBenefit()
    {
        List<string> lines = [];

        lines.AddRange(_editContentBenefits.Select(benefit => benefit.Current).Distinct());
        lines.AddRange(_editContentSubLearning.Select(subLearning => subLearning.Current).Distinct());
        lines.AddRange(_editContentLearning.Select(learning => learning.Current).Distinct());

        ReferenceBenefitDto referenceBenefitDto = _pdfReaderService.ProcessReferenceBenefit(lines);

        referenceBenefitDto.RBName = _autoBenefitDto.Name;
        referenceBenefitDto.LessonId = _autoBenefitDto.LessonId;
        referenceBenefitDto.SemesterId = _autoBenefitDto.SemesterId;
        referenceBenefitDto.SchoolId = _autoBenefitDto.SchoolId;

        await _mediator.Send(new CreateReferenceBenefitCommand
            {
                ReferenceBenefitDto = referenceBenefitDto
            });

        DisplaySuccessMessage();
        lines.Clear();
        _autoBenefitDto.Name = string.Empty;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        IBrowserFile file = e.File;
        if (file == null)
            return;

        using MemoryStream memoryStream = new();

        await file.OpenReadStream().CopyToAsync(memoryStream);
        _fileContent = memoryStream.ToArray();
        ICollection<RawBenefitReferenceDto> rawRefBenefits = await _pdfReaderService.GetAllReferenceBenefitsWithAltersDtos(_fileContent);
        foreach (RawBenefitReferenceDto rawBenefit in rawRefBenefits)
        {
            if (rawBenefit.Benefits != null)
                _editContentBenefits.AddRange(rawBenefit.Benefits.Select(benefit => new EditContent { Current = benefit }));

            if (rawBenefit.SubLearningAreas != null)
                _editContentSubLearning.AddRange(rawBenefit.SubLearningAreas.Select(subLearning => new EditContent { Current = subLearning }));

            if (rawBenefit.LearningAreas != null)
                _editContentLearning.AddRange(rawBenefit.LearningAreas.Select(learning => new EditContent { Current = learning }));
        }
        _isOpen = true;
    }

    private void DisplaySuccessMessage()
    {
        _modalDialog.Open();
        _editContentBenefits.Clear();
        _editContentSubLearning.Clear();
        _editContentLearning.Clear();
    }

    private void Toggle(MouseEventArgs e)
    {
        _isOpen = !_isOpen;
    }

    private void OnCheckboxChanged(ChangeEventArgs e)
    {
        if (e.Value == null)
            return;

        _isChecked = (bool)e.Value;
    }

    private string GetSemesterByIdTosString(int id)
    {
        GetListSemesterListItemDto s = _semesterResponse.Items.First(x => x.Id == id);
        return $"{s.BeginSemesterDate.Year} - {s.EndSemesterDate.Year} {s.Name}";
    }

    private void OnEditContentChanged(ChangeEventArgs e)
    {


    }

    private class RefBenDto
    {
        public string Name { get; set; } = string.Empty;
        public int LessonId { get; set; }
        public int SchoolId { get; set; }
        public int SemesterId { get; set; }
    }
}
