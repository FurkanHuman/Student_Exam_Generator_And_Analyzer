@page "/Register"
@using Application.Features.Auth.Commands.Register
@using Application.Features.Personels.Commands.Create
@using Application.Services.CookiesService
@using Domain.Entities
@using System.Text
@using Microsoft.AspNetCore.Antiforgery

<AuthorizeView Roles="Admin" Context="RegisterContext">
    <Authorized>
        <PageTitle> Kayıt Et</PageTitle>

        <div class="mb-3" style="width:25rem;">

            <h1>Personel kayıt</h1>
            <h6>sadece personel kayıt</h6>
            <br/>

            <EditForm method="post" OnValidSubmit="RegisterSubmit" Model="_RegisterDto" FormName="RegisterForm">

                <DataAnnotationsValidator />
                <ValidationSummary />
                <AntiforgeryToken />

                <div class="form-floating mb-3">
                    <InputText type="text" class="form-control" id="floatingInput" placeholder="Ad" @bind-Value="_RegisterDto.Name" />
                    <label for="floatingInput">Ad</label>
                </div>

                <div class="form-floating mb-3">
                    <InputText type="text" class="form-control" id="floatingInput" placeholder="Soyad" @bind-Value="_RegisterDto.Surname" />
                    <label for="floatingInput">soyad</label>
                </div>

                <div class="form-floating mb-3">
                    <InputDate class="form-control" id="floatingInput" placeholder="Doğum Tarihi" @bind-Value="_RegisterDto.BirthDate" />
                    <label for="floatingInput">Doğum Tarihi</label>
                </div>

                <div class="form-floating mb-3">
                    <InputText type="text" class="form-control" id="floatingInput" placeholder="name@example.com" @bind-Value="_RegisterDto.Email" />
                    <label for="floatingInput">E posta Adresi</label>
                </div>

                <div class="btn">
                    <button type="submit" class="btn btn-primary text-lg-end">Kayıt Et</button>
                </div>

            </EditForm>

        </div>

    </Authorized>
    <NotAuthorized>
        <PageTitle>Yetkisiz erişim </PageTitle>
        <h3>yetkili değilsiniz </h3>
    </NotAuthorized>
</AuthorizeView>

@inject IMediator _IMediator;
@inject ICookieService _cookieService

@code {
    private string ClientIpAddress;

    [SupplyParameterFromForm]
    private RegisterFormDto _RegisterDto { get; set; } = new();
    private RegisterCommand _RegisterCommand = new();
    protected override async Task OnInitializedAsync()
    {
        ClientIpAddress = await _cookieService.GetIpV4AndIpV6Client();
        await base.OnInitializedAsync();
    }


    private async Task RegisterSubmit()
    {

        _RegisterCommand.UserForRegisterDto = new()
            {
                Email = _RegisterDto.Email,
                Password = CreateRandomPassword(10)
            };
        _RegisterCommand.IpAddress = ClientIpAddress;

        RegisteredResponse response = await _IMediator.Send(_RegisterCommand);

        Guid UserId = response.RefreshToken.User.Id;

        CreatePersonelCommand _createPersonel = new()
            {
                UserId = UserId,
                Name = _RegisterDto.Name,
                SurName = _RegisterDto.Surname,
                BirthDate = _RegisterDto.BirthDate
            };

        CreatedPersonelResponse personel = await _IMediator.Send(_createPersonel);

        return;
    }

    private class RegisterFormDto
    {
        public string Email { get; set; }
        public string Password { get; set; }
        public string Name { get; set; }
        public string Surname { get; set; }
        public DateOnly BirthDate { get; set; } = new(1990, 01, 01);
    }


    private string CreateRandomPassword(int length)
    {
        const string validChars = "+-*/>£#@€%.,ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
        StringBuilder password = new();
        Random random = new();

        for (int i = 0; i < length; i++)
        {
            password.Append(validChars[random.Next(validChars.Length)]);
        }
        password.Append("#1Ap");

        return password.ToString();
    }
}
