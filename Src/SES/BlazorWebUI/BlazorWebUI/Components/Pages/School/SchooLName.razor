@page "/FirstUp/SchoolName"
@rendermode InteractiveServer
@namespace BlazorWebUI.Components.Pages.FirstUp
@using Application.Features.Principals.Queries.GetList
@using Application.Features.Personels.Queries.GetList
@using Application.Features.Schools.Commands.Create
@using Application.Features.Schools.Queries.GetList
@using BlazorWebUI.Client.Pages.Styles
@using Domain.Entities
@using NArchitecture.Core.Application.Requests
@using NArchitecture.Core.Application.Responses


<PageTitle>Okul Ekle</PageTitle>

<h2>Okul Adı</h2>
<h6>burası sadece okul adını düzenlemek için vardır</h6>
<h6>okul adını güncelleyemez, sadece yeni okul adı eklenebilir</h6>
<p></p>

<br />

<div class="input-group mb-3">
    <EditForm method="post" OnValidSubmit="Submit" Model="_schoolNameForm" FormName="SchoolNameForm">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <AntiforgeryToken />

        <div class="input-group mb-3" style="width:35rem;">
            <label class="input-group-text">Okul Adı: </label>
            <InputText type="Text" class="form-control conversion" id="name" style="text-transform:uppercase" @bind-Value="_schoolNameForm.SchoolName" />
        </div>

        <div class="input-group mb-3" style="width:35rem;">
            <label class="input-group-text">Müdür: </label>
            <InputSelect class="form-select" @bind-Value=_schoolNameForm.PrincipalId>
                <option selected>Seçiniz...</option>
                @foreach (GetListPrincipalListItemDto pricipal in _principals.Items)
                {
                    <option value="@pricipal.Id">@pricipal.Name @pricipal.SurName</option>
                }
            </InputSelect>
        </div>

        <div class="input-group-append">
            <button type="submit" class="btn btn-primary">Kaydet</button>
        </div>


    </EditForm>
</div>


<h6>Okulun Önceki adları</h6>
<ul class="list-group" style="width:35rem;">
    @foreach (GetListSchoolListItemDto getListSchoolListItemDto in _previousSchoolNames.Items)
    {
        <li class="list-group-item list-group-item-action  @(_previousSchoolNames.Items.Select(psn=>psn.Id).Max() == getListSchoolListItemDto.Id ? "active" : "")">@getListSchoolListItemDto.Name</li>
    }
</ul>

<ModalDialog @ref="_modalStatus" Title="Eklendi">
    <div style="background-color: #d4edda; color: #155724; padding: 1rem; border-radius: 0.25rem;">
        <p>Okulun adı başarıyla güncellendi</p>
        <p>Okulun şimdiki adı: <strong style="text-transform:uppercase">@_schoolNameForm.SchoolName.ToUpper()</strong> olarak güncellenmiştir.</p>

        <button class="btn btn-primary" @onclick="() => _modalStatus.Close()">Kapat</button>
    </div>
</ModalDialog>

@inject IMediator _IMediator

@code {

    [SupplyParameterFromForm]
    private SchoolNameForm _schoolNameForm { get; set; } = new();

    private GetListResponse<GetListSchoolListItemDto> _previousSchoolNames = new();
    private GetListResponse<GetListPrincipalListItemDto> _principals = new();

    private ModalDialog _modalStatus { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        GetListSchoolQuery getListSchoolQuery = new();
        getListSchoolQuery.PageRequest = new() { PageIndex = 0, PageSize = int.MaxValue };

        var previousSchoolNamesRequest = await _IMediator.Send(getListSchoolQuery);
        _previousSchoolNames = previousSchoolNamesRequest;
        _previousSchoolNames.Items = _previousSchoolNames.Items.OrderByDescending(v => v.Id).ToList();


        GetListPrincipalQuery getListPrincipalQuery = new();
        getListPrincipalQuery.PageRequest = new() { PageIndex = 0, PageSize = int.MaxValue };
        _principals = await _IMediator.Send(getListPrincipalQuery);
        await base.OnInitializedAsync();
    }

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_schoolNameForm.SchoolName))
            return;
        if (_previousSchoolNames.Items.Any(p => p.Name.Contains(_schoolNameForm.SchoolName)))
            return;

        CreateSchoolCommand command = new() { Name = _schoolNameForm.SchoolName.ToUpper(), PrincipalId = _schoolNameForm.PrincipalId };
        CreatedSchoolResponse response = await _IMediator.Send(command);
        _previousSchoolNames.Items.Add(new() { Id = response.Id, Name = response.Name });
        _modalStatus.Open();
    }

    private class SchoolNameForm
    {
        public string SchoolName { get; set; } = string.Empty;
        public int PrincipalId { get; set; }
    }

}
