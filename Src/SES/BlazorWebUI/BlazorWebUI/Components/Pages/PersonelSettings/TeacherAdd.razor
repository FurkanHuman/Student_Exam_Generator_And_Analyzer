@page "/TeacherAdd"
@using Application.Features.Personels.Queries.GetList
@using Application.Features.Schools.Queries.GetList
@using Application.Features.Semesters.Queries.GetList
@using Application.Features.Teachers.Commands.Create
@using Application.Features.Teachers.Queries.GetList
@using NArchitecture.Core.Application.Requests
@using NArchitecture.Core.Application.Responses

<PageTitle>Öğretmen Ekle</PageTitle>
<h1>Öğretmen Ekle</h1>

<br />

<div class="input-group mb-3">
    <EditForm method="post" OnValidSubmit="Submit" Model="_teacherDto" FormName="TeacherAddForm">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <AntiforgeryToken />
        @if (PersonelId == null)
        {
            <div class="input-group mb-3" style="width:35rem;">
                <label class="input-group-text">Öğretmen: </label>
                <InputSelect class="form-select" id="schoolDD" @bind-Value="_teacherDto.PersonelId">
                    <option selected>Seçiniz</option>
                    @foreach (GetListPersonelListItemDto personelItemDto in _getListPersonel.Items)
                    {
                        <option value="@personelItemDto.Id">@personelItemDto.Name @personelItemDto.SurName @personelItemDto.BirthDate </option>
                    }
                </InputSelect>
            </div>
        }
        <div class="input-group mb-3" style="width:35rem;">
            <label class="input-group-text">Dönem: </label>
            <InputSelect class="form-select" id="schoolDD" @bind-Value="_teacherDto.SemesterId">
                <option selected>Seçiniz</option>
                @foreach (GetListSemesterListItemDto semesterListItemDto in _getListSemester.Items)
                {
                    <option value="@semesterListItemDto.Id">@semesterListItemDto.BeginSemesterDate.Year @semesterListItemDto.EndSemesterDate.Year | @semesterListItemDto.Name </option>
                }
            </InputSelect>
        </div>

        <div class="input-group mb-3" style="width:35rem;">
            <label class="input-group-text">Okul: </label>
            <InputSelect class="form-select" id="schoolDD" @bind-Value="_teacherDto.SchoolId">
                <option selected value="0">Otomatik</option>
                @foreach (GetListSchoolListItemDto getListSchooltemDto in _getListSchool.Items)
                {
                    <option value="@getListSchooltemDto.Id">@getListSchooltemDto.Name</option>
                }
            </InputSelect>
        </div>

        <div class="input-group-append">
            <button type="submit" class="btn btn-primary">Ekle</button>
        </div>

    </EditForm>
</div>

@inject IMediator _Mediator

@code {
    [SupplyParameterFromForm]
    private TeacherAddDto _teacherDto { get; set; } = new();

    [Parameter]
    public Guid? PersonelId { get; set; }

    [Parameter]
    public EventCallback TriggerEvent { get; set; }

    private GetListResponse<GetListPersonelListItemDto> _getListPersonel = new();
    private GetListResponse<GetListSchoolListItemDto> _getListSchool = new();
    private GetListResponse<GetListSemesterListItemDto> _getListSemester = new();

    protected override async Task OnInitializedAsync()
    {
        if (PersonelId == null)
        {
            GetListPersonelQuery listPersonelQuery = new();
            listPersonelQuery.PageRequest = new() { PageIndex = 0, PageSize = int.MaxValue };
            _getListPersonel = await _Mediator.Send(listPersonelQuery);
        }

        GetListSchoolQuery listSchoolQuery = new();
        listSchoolQuery.PageRequest = new() { PageIndex = 0, PageSize = int.MaxValue };
        _getListSchool = await _Mediator.Send(listSchoolQuery);

        GetListSemesterQuery listSemesterQuery = new();
        listSemesterQuery.PageRequest = new() { PageIndex = 0, PageSize = int.MaxValue };
        _getListSemester = await _Mediator.Send(listSemesterQuery);

        await base.OnInitializedAsync();
    }

    private async Task Submit()
    {
        if (_teacherDto.SchoolId == 0)
            _teacherDto.SchoolId = _getListSchool.Items.Last().Id;

        if (PersonelId != null)
            _teacherDto.PersonelId = PersonelId.Value;

        CreateTeacherCommand teacherCommand = new() { PersonelId = _teacherDto.PersonelId, SchoolId = _teacherDto.SchoolId, SemesterId = _teacherDto.SemesterId };
        CreatedTeacherResponse teacherResponse = await _Mediator.Send(teacherCommand);
        await TriggerEvent.InvokeAsync();
    }

    private class TeacherAddDto
    {
        public Guid PersonelId { get; set; }
        public int SchoolId { get; set; }
        public int SemesterId { get; set; }
    }
}