@page "/TeacherAdd"
@using Application.Features.Personels.Queries.GetList
@using Application.Features.Schools.Queries.GetList
@using Application.Features.Semesters.Queries.GetList
@using Application.Features.Teachers.Commands.Create
@using Application.Features.Teachers.Queries.GetList
@using NArchitecture.Core.Application.Requests
@using NArchitecture.Core.Application.Responses

<PageTitle>Öğretmen Ekle</PageTitle>


<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h3 class="mb-0">
                        <i class="bi bi-person-plus me-2"></i>Öğretmen Ekle
                    </h3>
                </div>
                <div class="card-body">
                    @if (_isSuccess)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle me-2"></i>
                            <strong>Başarılı!</strong> Öğretmen başarıyla eklendi.
                            <button type="button" class="btn-close" @onclick="() => _isSuccess = false"></button>
                        </div>
                    }

                    @if (_isLoading)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-success" role="status">
                                <span class="visually-hidden">Yükleniyor...</span>
                            </div>
                            <p class="mt-3 text-muted">Öğretmen ekleniyor...</p>
                        </div>
                    }

                    <EditForm method="post" OnValidSubmit="Submit" Model="_teacherDto" FormName="TeacherAddForm">
                        <DataAnnotationsValidator />
                        <AntiforgeryToken />

                        <div class="row g-3">
                            @if (PersonelId == null)
                            {
                                <div class="col-12">
                                    <label class="form-label fw-semibold">
                                        <i class="bi bi-person me-1"></i>Personel
                                    </label>
                                    <InputSelect class="form-select" @bind-Value="_teacherDto.PersonelId">
                                        <option value="@Guid.Empty">Personel seçiniz...</option>
                                        @foreach (var personel in _getListPersonel.Items)
                                        {
                                            <option value="@personel.Id">
                                                @personel.Name @personel.SurName (@personel.BirthDate.ToString("dd/MM/yyyy"))
                                            </option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => _teacherDto.PersonelId)" />

                                    @if (_selectedPersonel != null)
                                    {
                                        <div class="card bg-light mt-2">
                                            <div class="card-body py-2">
                                                <small>
                                                    <i class="bi bi-info-circle me-1"></i>
                                                    <strong>Seçilen:</strong> @_selectedPersonel.Name @_selectedPersonel.SurName
                                                </small>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">
                                    <i class="bi bi-calendar-range me-1"></i>Dönem
                                </label>
                                <InputSelect class="form-select" @bind-Value="_teacherDto.SemesterId">
                                    <option value="0">Dönem seçiniz...</option>
                                    @foreach (var semester in _getListSemester.Items)
                                    {
                                        <option value="@semester.Id">
                                            @semester.Name (@semester.BeginSemesterDate.Year - @semester.EndSemesterDate.Year)
                                        </option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => _teacherDto.SemesterId)" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">
                                    <i class="bi bi-building me-1"></i>Okul
                                </label>
                                <InputSelect class="form-select" @bind-Value="_teacherDto.SchoolId">
                                    <option value="0">Otomatik (Son eklenen okul)</option>
                                    @foreach (var school in _getListSchool.Items)
                                    {
                                        <option value="@school.Id">@school.Name</option>
                                    }
                                </InputSelect>
                                <div class="form-text">
                                    <i class="bi bi-lightbulb me-1"></i>
                                    "Otomatik" seçeneği sistemdeki son eklenen okulu kullanır
                                </div>
                            </div>

                            @if (ShowSelectionSummary())
                            {
                                <div class="col-12">
                                    <div class="card border-success">
                                        <div class="card-body">
                                            <h6 class="card-title">
                                                <i class="bi bi-clipboard-check me-1"></i>Seçim Özeti
                                            </h6>
                                            <div class="row">
                                                @if (PersonelId != null || _teacherDto.PersonelId != Guid.Empty)
                                                {
                                                    <div class="col-md-4">
                                                        <p class="mb-1"><small class="text-muted">Personel</small></p>
                                                        <p class="mb-0">
                                                            @if (_selectedPersonel != null)
                                                            {
                                                                <strong>@_selectedPersonel.Name @_selectedPersonel.SurName</strong>
                                                            }
                                                        </p>
                                                    </div>
                                                }
                                                @if (_teacherDto.SemesterId > 0)
                                                {
                                                    <div class="col-md-4">
                                                        <p class="mb-1"><small class="text-muted">Dönem</small></p>
                                                        <p class="mb-0">
                                                            <strong>@GetSemesterName(_teacherDto.SemesterId)</strong>
                                                        </p>
                                                    </div>
                                                }
                                                @if (_teacherDto.SchoolId >= 0)
                                                {
                                                    <div class="col-md-4">
                                                        <p class="mb-1"><small class="text-muted">Okul</small></p>
                                                        <p class="mb-0">
                                                            <strong>@GetSchoolName(_teacherDto.SchoolId)</strong>
                                                        </p>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <button type="button" class="btn btn-secondary" @onclick="ResetForm">
                                <i class="bi bi-arrow-counterclockwise me-1"></i>Sıfırla
                            </button>
                            <button type="submit" class="btn btn-success" disabled="@(!CanSubmit())">
                                <i class="bi bi-plus-circle me-1"></i>Ekle
                            </button>
                        </div>

                        <ValidationSummary class="mt-3" />
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@inject IMediator _Mediator

@code {
    [SupplyParameterFromForm]
    private TeacherAddDto _teacherDto { get; set; } = new();

    [Parameter]
    public Guid? PersonelId { get; set; }

    [Parameter]
    public EventCallback TriggerEvent { get; set; }

    private GetListResponse<GetListPersonelListItemDto> _getListPersonel = new();
    private GetListResponse<GetListSchoolListItemDto> _getListSchool = new();
    private GetListResponse<GetListSemesterListItemDto> _getListSemester = new();

    private GetListPersonelListItemDto? _selectedPersonel;
    private bool _isSuccess = false;
    private bool _isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;

            var tasks = new List<Task>();

            if (PersonelId == null)
            {
                var personelTask = _Mediator.Send(new GetListPersonelQuery
                {
                    PageRequest = new() { PageIndex = 0, PageSize = int.MaxValue }
                });
                tasks.Add(personelTask.ContinueWith(t => _getListPersonel = t.Result));
            }

            var schoolTask = _Mediator.Send(new GetListSchoolQuery
            {
                PageRequest = new() { PageIndex = 0, PageSize = int.MaxValue }
            });
            tasks.Add(schoolTask.ContinueWith(t => _getListSchool = t.Result));

            var semesterTask = _Mediator.Send(new GetListSemesterQuery
            {
                PageRequest = new() { PageIndex = 0, PageSize = int.MaxValue }
            });
            tasks.Add(semesterTask.ContinueWith(t => _getListSemester = t.Result));

            await Task.WhenAll(tasks);
        }
        finally
        {
            _isLoading = false;
        }

        await base.OnInitializedAsync();
    }

    protected override void OnParametersSet()
    {
        if (_teacherDto.PersonelId != Guid.Empty)
        {
            _selectedPersonel = _getListPersonel.Items.FirstOrDefault(p => p.Id == _teacherDto.PersonelId);
        }
    }

    private async Task Submit()
    {
        try
        {
            _isLoading = true;

            if (_teacherDto.SchoolId == 0)
                _teacherDto.SchoolId = _getListSchool.Items.LastOrDefault()?.Id ?? 0;

            if (PersonelId != null)
                _teacherDto.PersonelId = PersonelId.Value;

            var teacherCommand = new CreateTeacherCommand
            {
                PersonelId = _teacherDto.PersonelId,
                SchoolId = _teacherDto.SchoolId,
                SemesterId = _teacherDto.SemesterId
            };

            var teacherResponse = await _Mediator.Send(teacherCommand);

            _isSuccess = true;
            await TriggerEvent.InvokeAsync();

            if (PersonelId == null)
            {
                ResetForm();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Öğretmen ekleme hatası: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ResetForm()
    {
        _teacherDto = new();
        _selectedPersonel = null;
        _isSuccess = false;
    }

    private bool CanSubmit()
    {
        var hasPersonel = PersonelId != null || _teacherDto.PersonelId != Guid.Empty;
        return hasPersonel &&
               _teacherDto.SemesterId > 0 &&
               !_isLoading;
    }

    private bool ShowSelectionSummary()
    {
        return (PersonelId != null || _teacherDto.PersonelId != Guid.Empty) &&
               (_teacherDto.SemesterId > 0 || _teacherDto.SchoolId >= 0);
    }

    private string GetSemesterName(int id)
    {
        var semester = _getListSemester.Items.FirstOrDefault(s => s.Id == id);
        return semester != null
            ? $"{semester.Name} ({semester.BeginSemesterDate.Year}-{semester.EndSemesterDate.Year})"
            : "";
    }

    private string GetSchoolName(int id)
    {
        if (id == 0) return "Otomatik (Son eklenen okul)";
        var school = _getListSchool.Items.FirstOrDefault(s => s.Id == id);
        return school?.Name ?? "";
    }

    private class TeacherAddDto
    {
        public Guid PersonelId { get; set; }
        public int SchoolId { get; set; }
        public int SemesterId { get; set; }
    }
}