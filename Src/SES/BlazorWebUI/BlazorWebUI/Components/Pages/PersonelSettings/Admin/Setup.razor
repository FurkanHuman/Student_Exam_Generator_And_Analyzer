@page "/Admin/Setup"
@rendermode InteractiveServer

@using Application.Services.Personels
@using BlazorWebUI.Client.Pages.Styles
@using Domain.Entities
@using Microsoft.AspNetCore.Identity
@using System.Security.Cryptography
@using System.Security.Claims
@using System.Net
@using System.Text
@using Net.Codecrete.QrCodeGenerator
@using System.Globalization
@using System.Text.Encodings.Web


<PageTitle>Sistem Kurulumu</PageTitle>

@if (!_isInitialized)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 100vh;">
        <div class="text-center">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;"></div>
            <p class="mt-3">Kontrol ediliyor...</p>
        </div>
    </div>
}
else if (!_isSetupRequired)
{
    <div class="d-flex justify-content-center align-items-center vh-100">
        <div class="card shadow text-center w-100" style="max-width: 32rem;">
            <div class="card-body py-5">
                <i class="bi bi-shield-check text-success" style="font-size: 5rem;"></i>
                <h3 class="mt-3">Sistem Zaten Kurulu</h3>
                <p class="text-muted">Ana sayfaya yönlendiriliyorsunuz...</p>
            </div>
        </div>
    </div>
}

else if (_setupCompleted)
{
    <div class="d-flex justify-content-center align-items-center vh-100">
        <div class="card shadow text-center w-100" style="max-width: 32rem;">
            <div class="card-body py-5">
                <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
                <h3 class="mt-3">Kurulum Tamamlandı!</h3>
                <p class="text-muted">Giriş sayfasına yönlendiriliyorsunuz...</p>
                <div class="spinner-border text-primary mt-3"></div>
            </div>
        </div>
    </div>
}

else
{
    <div class="container-fluid d-flex justify-content-center align-items-center">
        <div class="col-12 col-lg-10 col-xl-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-danger text-white py-4">
                    <div class="text-center">
                        <i class="bi bi-shield-lock-fill" style="font-size: 3rem;"></i>
                        <h2 class="mt-2 mb-0">Sistem İlk Kurulum</h2>
                        <p class="mb-0 mt-2">Admin Hesabı ve 2FA Yapılandırması</p>
                    </div>
                </div>

                <div class="card-body p-4">
                    @if (_isLoading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;"></div>
                            <p class="mt-3 text-muted fs-5">@_loadingMessage</p>
                        </div>
                    }

                    else if (!_is2FAConfigured)
                    {
                        <div class="row">
                            <!--Left: Admin info-->
                            <div class="col-md-6 border-end">
                                <div class="alert alert-danger">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                    <strong>ÖNEMLİ:</strong> Bu bilgileri güvenli bir yere kaydedin!
                                </div>

                                <div class="mb-4">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-envelope-fill me-2"></i>Kullanıcı Adı
                                    </label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" value="@_adminEmail" readonly />
                                        <button class="btn btn-outline-secondary" @onclick="() => CopyToClipboard(_adminEmail)"
                                                title="Kopyala">
                                            <i class="bi bi-clipboard"></i>
                                        </button>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-key-fill me-2"></i>Şifre
                                    </label>
                                    <div class="input-group">
                                        <input type="@ShowPassword(_showPassword)"
                                               class="form-control font-monospace fs-5" value="@_generatedPassword" readonly />
                                        <button class="btn btn-outline-secondary" @onclick="TogglePasswordVisibility"
                                                title="Göster/Gizle">
                                            <i class="bi @ShowPasswordEye(_showPassword)"></i>
                                        </button>
                                        <button class="btn btn-outline-secondary"
                                                @onclick="() => CopyToClipboard(_generatedPassword)" title="Kopyala">
                                            <i class="bi bi-clipboard"></i>
                                        </button>
                                    </div>
                                    <small class="text-muted">
                                        <i class="bi bi-shield-check"></i> Otomatik oluşturuldu (16 karakter)
                                    </small>
                                </div>

                                @if (_clipboardCopied)
                                {
                                    <div class="alert alert-success alert-dismissible fade show">
                                        <i class="bi bi-check-circle me-2"></i>Panoya kopyalandı!
                                    </div>
                                }
                            </div>

                            <!-- Right: 2FA -->
                            <div class="col-md-6">
                                <div class="alert alert-warning">
                                    <i class="bi bi-shield-lock-fill me-2"></i>
                                    <strong>2FA Zorunlu:</strong> Güvenlik için gereklidir.
                                </div>

                                @if (string.IsNullOrEmpty(_qrSvgGraphicsPath))
                                {
                                    <div class="text-center py-4">
                                        <div class="spinner-border text-primary"></div>
                                        <p class="mt-2 text-muted">QR kod hazırlanıyor...</p>
                                    </div>
                                }
                                else
                                {
                                    <!-- QR code -->
                                    <div class="text-center mb-3">
                                        <div class="d-inline-block p-3 bg-white border rounded">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="300" height="300"
                                                 viewBox="0 0 @_qrSize @_qrSize">
                                                <rect width="@_qrSize" height="@_qrSize" fill="white" />
                                                <path d="@_qrSvgGraphicsPath" fill="black" />
                                            </svg>
                                        </div>
                                    </div>

                                    <!-- Manuel code -->
                                    <div class="mb-3">
                                        <label class="form-label small fw-bold">Manuel Kod:</label>
                                        <div class="input-group input-group-sm">
                                            <input type="text" class="form-control font-monospace" value="@_sharedKey" readonly />
                                            <button class="btn btn-outline-secondary" @onclick="() => CopyToClipboard(_sharedKey)">
                                                <i class="bi bi-clipboard"></i>
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Verify code -->
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">
                                            <i class="bi bi-key me-2"></i>Doğrulama Kodu
                                        </label>
                                        <div class="input-group">
                                            <input type="text" class="form-control form-control-lg text-center font-monospace"
                                                   @bind="_verificationCode" @bind:event="oninput" placeholder="000000" maxlength="6"
                                                   style="letter-spacing: 0.5rem;" />
                                            <button class="btn btn-success btn-lg" @onclick="Verify2FACode"
                                                    disabled="@Verify2FAEnableIfCodeValidation">
                                                <i class="bi bi-check-circle"></i>
                                            </button>
                                        </div>
                                        @if (!string.IsNullOrEmpty(_verificationError))
                                        {
                                            <div class="text-danger mt-2">
                                                <i class="bi bi-x-circle me-1"></i>@_verificationError
                                            </div>
                                        }
                                    </div>

                                    <!-- Application Recommendations-->
                                    <div class="alert alert-info mb-0">
                                        <small>
                                            <strong>Önerilen Uygulamalar:</strong><br />
                                            Google Authenticator, Microsoft Authenticator, Authy
                                        </small>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    else
                    {
                        <!-- Backup Codes -->
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            <strong>2FA Başarıyla Yapılandırıldı!</strong>
                        </div>

                        @if (_recoveryCodes != null && _recoveryCodes.Any())
                        {
                            <div class="card border-warning mb-4">
                                <div class="card-header bg-warning">
                                    <h5 class="mb-0">
                                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Yedek Kodlarınız
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <p class="text-muted">
                                        Telefonunuzu kaybederseniz bu kodlarla giriş yapabilirsiniz.
                                        <strong>Her kod sadece bir kez kullanılabilir.</strong>
                                    </p>

                                    <div class="row g-2 mb-3">
                                        @foreach (var recoveryCode in _recoveryCodes)
                                        {
                                            <div class="col-md-6">
                                                <div class="p-2 bg-light border rounded">
                                                    <code class="fs-6">@recoveryCode</code>
                                                </div>
                                            </div>
                                        }
                                    </div>

                                    <button class="btn btn-sm btn-outline-primary" @onclick="CopyRecoveryCodes">
                                        <i class="bi bi-clipboard me-1"></i>Tüm Kodları Kopyala
                                    </button>

                                    <div class="alert alert-danger mt-3 mb-0">
                                        <i class="bi bi-exclamation-octagon-fill me-2"></i>
                                        <strong>Bu kodları güvenli bir yere kaydedin!</strong>
                                        Bu sayfa kapatıldıktan sonra tekrar göremezsiniz.
                                    </div>
                                </div>
                            </div>

                            <div class="form-check mb-3 bg-warning-subtle ">
                                <input class="form-check-input" type="checkbox" @bind="_recoveryCodesSaved" id="confirmCheck">
                                <label class="form-check-label" for="confirmCheck">
                                    <strong> Yedek kodlarımı güvenli bir yere kaydettim </strong>
                                </label>
                            </div>

                            <button class="btn btn-success btn-lg w-100" @onclick="CompleteSetup"
                                    disabled="@RecoveryCodesSaved">
                                <i class="bi bi-check-circle me-2"></i>Kurulumu Tamamla
                            </button>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}

@inject UserManager<ApplicationUser> _userManager
@inject UrlEncoder UrlEncoder
@inject RoleManager<IdentityRole<Guid>> _roleManager
@inject NavigationManager _navigationManager
@inject IUserStore<ApplicationUser> _userStore
@inject IPersonelService _personelService
@inject IHttpContextAccessor _httpContextAccessor
@inject ILogger<Setup> _logger
@inject IJSRuntime _jsRuntime

@code {
    private const string AuthenticatorUriFormat = $"otpauth://totp/{{0}}:{{1}}?secret={{2}}&issuer={{0}}&digits=6";
    private readonly string[] _roles = ["admin", "authorized", "unauthorized", "director", "assistant_director", "teacher", "head_teacher", "officer"];

    private string _generatedPassword = string.Empty;
    private readonly string _adminEmail = "admin@root";
    private Guid _adminGuid = Guid.NewGuid();
    private Guid _adminPersonelGuid = Guid.NewGuid();

    private bool _isInitialized = false;
    private bool _isSetupRequired = false;
    private bool _setupCompleted = false;
    private bool _isLoading = false;
    private string _loadingMessage = string.Empty;
    private bool _showPassword = false;
    private bool _clipboardCopied = false;
    private int _qrSize;

    // 2FA related
    private bool _is2FAConfigured = false;
    private string _qrSvgGraphicsPath = string.Empty;
    private string _sharedKey = string.Empty;
    private string _verificationCode = string.Empty;
    private string _verificationError = string.Empty;
    private IEnumerable<string>? _recoveryCodes;
    private bool _recoveryCodesSaved = false;
    private ApplicationUser? _createdAdminUser;

    protected override async Task OnInitializedAsync()
    {
        _isSetupRequired = await IsSetupRequiredAsync();
        _isInitialized = true;

        if (!_isSetupRequired)
        {
            LogUnauthorizedAccess();
            _navigationManager.NavigateTo("/", forceLoad: true);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _isSetupRequired && !_isLoading && !_is2FAConfigured)
            await StartSetup();
    }

    private async Task<bool> IsSetupRequiredAsync()
    {
        if (!_userManager.Users.Any())
            return true;

        var admins = await _userManager.GetUsersInRoleAsync("admin");
        return !admins.Any();
    }

    private async Task StartSetup()
    {
        try
        {
            _isLoading = true;
            _loadingMessage = "Roller oluşturuluyor...";
            StateHasChanged();
            await Task.Delay(500);

            foreach (var role in _roles)
                if (!await _roleManager.RoleExistsAsync(role))
                    await _roleManager.CreateAsync(new IdentityRole<Guid>(role));

            _loadingMessage = "Admin hesabı oluşturuluyor...";
            StateHasChanged();            
            await Task.Delay(500);

            _generatedPassword = GenerateSecurePassword(16);
            await CreateAdminUser();

            _loadingMessage = "2FA yapılandırılıyor...";
            StateHasChanged();
            await Task.Delay(500);

            await LoadAuthenticatorKey();

            _isLoading = false;
            StateHasChanged();
            await Task.Delay(500);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Setup Starting Error");
            _loadingMessage = $"HATA: {ex.Message}";
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task CreateAdminUser()
    {
        var adminUser = CreateUser();
        adminUser.Id = _adminGuid;
        adminUser.PersonelId = _adminPersonelGuid;

        await _userStore.SetUserNameAsync(adminUser, _adminEmail, CancellationToken.None);
        var emailStore = GetEmailStore();
        await emailStore.SetEmailAsync(adminUser, _adminEmail, CancellationToken.None);
        await emailStore.SetEmailConfirmedAsync(adminUser, true, CancellationToken.None);

        var result = await _userManager.CreateAsync(adminUser, _generatedPassword);
        if (result.Succeeded)
        {
            await _userManager.AddToRoleAsync(adminUser, "admin");
            await AddPersonel(adminUser.Id);
            _createdAdminUser = adminUser;
            LogAdminCreation();
        }
    }

    private async Task<Personel> AddPersonel(Guid userId)
    {
        var personel = new Personel
        {
            UserId = userId,
            Id = _adminPersonelGuid,
            Name = "Admin",
            SurName = "Administrator",
            BirthDate = DateOnly.FromDateTime(DateTime.UtcNow),
            CreatedDate = DateTime.UtcNow
        };

        return await _personelService.AddAsync(personel);
    }

    private async Task LoadAuthenticatorKey()
    {
        if (_createdAdminUser == null) return;

        var unformattedKey = await _userManager.GetAuthenticatorKeyAsync(_createdAdminUser);
        if (string.IsNullOrEmpty(unformattedKey))
        {
            await _userManager.ResetAuthenticatorKeyAsync(_createdAdminUser);
            unformattedKey = await _userManager.GetAuthenticatorKeyAsync(_createdAdminUser);
        }

        _sharedKey = FormatKey(unformattedKey!);
        var email = await _userManager.GetEmailAsync(_createdAdminUser);
        var authenticatorUri = GenerateQrCodeUri(email!, unformattedKey!);
        var qr = QrCode.EncodeText(authenticatorUri, QrCode.Ecc.Medium);
        _qrSize = qr.Size;
        _qrSvgGraphicsPath = qr.ToGraphicsPath();
    }

    private async Task Verify2FACode()
    {
        if (_createdAdminUser == null)
            return;

        _verificationError = string.Empty;

        var verificationCode = _verificationCode.Replace(" ", string.Empty).Replace("-", string.Empty);
        var is2faTokenValid = await _userManager.VerifyTwoFactorTokenAsync(
            _createdAdminUser,
            _userManager.Options.Tokens.AuthenticatorTokenProvider,
            verificationCode);

        if (!is2faTokenValid)
        {
            _verificationError = "Doğrulama kodu geçersiz. Lütfen tekrar deneyin.";
            return;
        }

        await _userManager.SetTwoFactorEnabledAsync(_createdAdminUser, true);

        var userId = await _userManager.GetUserIdAsync(_createdAdminUser);
        _logger.LogInformation("User with ID '{UserId}' has enabled 2FA with an authenticator app.", userId);

        if (await _userManager.CountRecoveryCodesAsync(_createdAdminUser) == 0)
            _recoveryCodes = await _userManager.GenerateNewTwoFactorRecoveryCodesAsync(_createdAdminUser, 10);

        _is2FAConfigured = true;
        StateHasChanged();
    }

    private async Task CopyRecoveryCodes()
    {
        if (_recoveryCodes == null)
            return;

        var codes = string.Join("\n", _recoveryCodes);
        await CopyToClipboard(codes);
    }

    private async Task CompleteSetup()
    {
        if (!_recoveryCodesSaved || !_is2FAConfigured)
            return;

        _setupCompleted = true;
        StateHasChanged();

        await Task.Delay(1500);
        _navigationManager.NavigateTo("/Account/Login", forceLoad: true);
    }


    private async Task CopyToClipboard(string text)
    {
        try
        {
            await _jsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
            _clipboardCopied = true;
            StateHasChanged();

            await Task.Delay(2000);
            _clipboardCopied = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Clipboard copy error");
        }
    }

    private static string GenerateSecurePassword(int length)
    {
        const string upperCase = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        const string lowerCase = "abcdefghijklmnopqrstuvwxyz";
        const string digits = "0123456789";
        const string specialChars = "!@#$%^&*()_-+=<>?";

        using var rng = RandomNumberGenerator.Create();
        var password = new char[length];

        password[0] = upperCase[GetSecureRandomNumber(rng, upperCase.Length)];
        password[1] = lowerCase[GetSecureRandomNumber(rng, lowerCase.Length)];
        password[2] = digits[GetSecureRandomNumber(rng, digits.Length)];
        password[3] = specialChars[GetSecureRandomNumber(rng, specialChars.Length)];

        string allChars = upperCase + lowerCase + digits + specialChars;
        for (int i = 4; i < length; i++)
            password[i] = allChars[GetSecureRandomNumber(rng, allChars.Length)];

        return new string(password.OrderBy(x => GetSecureRandomNumber(rng, 1000)).ToArray());
    }

    private static int GetSecureRandomNumber(RandomNumberGenerator rng, int max)
    {
        var bytes = new byte[4];
        rng.GetBytes(bytes);
        return (int)(BitConverter.ToUInt32(bytes, 0) % max);
    }

    private string FormatKey(string unformattedKey)
    {
        var result = new StringBuilder();
        int currentPosition = 0;

        while (currentPosition + 4 < unformattedKey.Length)
        {
            result.Append(unformattedKey.AsSpan(currentPosition, 4)).Append(' ');
            currentPosition += 4;
        }

        if (currentPosition < unformattedKey.Length)
            result.Append(unformattedKey.AsSpan(currentPosition));

        return result.ToString().ToLowerInvariant();
    }

    private string GenerateQrCodeUri(string email, string unformattedKey)
    {
        return string.Format(
            CultureInfo.InvariantCulture,
            AuthenticatorUriFormat,
            UrlEncoder.Encode("Microsoft.AspNetCore.Identity.UI"), //note: here is refactored to use a constant app name for conf or db? starts with admin or root?
            UrlEncoder.Encode(email),
            unformattedKey);
    }

    private ApplicationUser CreateUser()
    {
        try
        {
            return Activator.CreateInstance<ApplicationUser>();
        }

        catch
        {
            throw new InvalidOperationException($"Can't create an instance of '{nameof(ApplicationUser)}'.");
        }
    }

    private IUserEmailStore<ApplicationUser> GetEmailStore()
    {
        if (!_userManager.SupportsUserEmail)
            throw new NotSupportedException("The default UI requires a user store with email support.");

        return (IUserEmailStore<ApplicationUser>)_userStore;
    }


    private string GetRequestLog()
    {
        var context = _httpContextAccessor.HttpContext;
        if (context == null) return "HttpContext is null";

        var remoteIp = context.Connection.RemoteIpAddress;

        string ipInfo = IpInfo(remoteIp);
        bool isHttps = context.Request.IsHttps;
        bool isAuthenticated = context.User.Identity?.IsAuthenticated ?? false;
        string userAgent = context.Request.Headers["User-Agent"].ToString() ?? "Unknown";
        string method = context.Request.Method;
        string path = context.Request.Path;
        string authType = isAuthenticated ? string.Join(',', context.User.Claims.Where(c => c.Type == "amr").Select(c => c.Value)) : "Unknown";

        return $"IP: {ipInfo} | Browser: {userAgent} | HTTPS: {isHttps} | Method: {method} | Path: {path} | Auth: {isAuthenticated} | Type: {authType}";
    }

    private string IpInfo(IPAddress? remoteIp)
    {
        string? ipv4 = null;
        string? ipv6 = null;

        if (remoteIp != null)
        {
            if (remoteIp.IsIPv4MappedToIPv6)
            {
                ipv4 = remoteIp.MapToIPv4().ToString();
                ipv6 = remoteIp.ToString();
            }

            else if (remoteIp.AddressFamily == System.Net.Sockets.AddressFamily.InterNetwork)
                ipv4 = remoteIp.ToString();

            else if (remoteIp.AddressFamily == System.Net.Sockets.AddressFamily.InterNetworkV6)
                ipv6 = remoteIp.ToString();
        }

        return $"IPv4: {ipv4 ?? "N/A"} | IPv6: {ipv6 ?? "N/A"}";
    }

    private void LogUnauthorizedAccess() => _logger.LogCritical("Setup page unauthorized access attempt.\n",  GetRequestLog());
    private void LogAdminCreation() => _logger.LogWarning("Setup page created admin user.\n", GetRequestLog());
    private void TogglePasswordVisibility() => _showPassword = !_showPassword;
    private bool Verify2FAEnableIfCodeValidation() => string.IsNullOrWhiteSpace(_verificationCode) || _verificationCode.Length != 6;
    private bool RecoveryCodesSaved() => !_recoveryCodesSaved;
    private string ShowPassword(bool showPaasword) => showPaasword ? "text" : "password";
    private string ShowPasswordEye(bool showPassword) => showPassword ? " bi-eye-slash" : "bi-eye";
}