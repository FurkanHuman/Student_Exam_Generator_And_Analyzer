@using Application.Services.Personels
@using BlazorWebUI.Client.Pages.Styles
@using Domain.Entities
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@attribute [Authorize(Roles = "admin,director")]
@page "/Admin/Panel"
@rendermode InteractiveServer

@inject UserManager<ApplicationUser> _userManager
@inject RoleManager<IdentityRole<Guid>> _roleManager
@inject IPersonelService _personelService

@code
{
    private IEnumerable<ApplicationUser> _users = [];
    private IEnumerable<Personel> _personels = [];
    private IEnumerable<Personel> _discardPersonels = [];
     
    private IEnumerable<IdentityRole<Guid>> _availableRoles = [];
    private readonly Dictionary<Guid, IList<string>> _userRoles = [];

    private ApplicationUser _selectedUser { get; set; } = new();
    private Personel? _selectedPersonel { get; set; } = new();

    private Guid _selectedPersonelGuid { get; set; } = Guid.Empty;

    private ModalDialog _modalDialogRoleAssign { get; set; } = new();
    private ModalDialog _modalDialogDeleteUser { get; set; } = new();
    private ModalDialog _modalDialogTeacherAdd { get; set; } = new();
    private ModalDialog _modalDialogPersonelChange { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        _users = _userManager.Users.ToList();
        _availableRoles = _roleManager.Roles.ToList();
        _availableRoles = RemoveAdmin(_availableRoles);

        var __personels = await _personelService.GetListAsync(withDeleted: true);
        _personels = __personels!.Items;

        _discardPersonels = _personels.Where(p => p.UserId == Guid.Empty).ToList();

        foreach (ApplicationUser user in _users)
            _userRoles.Add(user.Id, await _userManager.GetRolesAsync(user));
    }

    private IEnumerable<IdentityRole<Guid>> RemoveAdmin(IEnumerable<IdentityRole<Guid>> roles)
    {
        return roles.Where(r => r.Name != "admin");
    }

    private async Task AddRoleAsync(ApplicationUser user, IdentityRole<Guid> role)
    {
        if (!await _roleManager.RoleExistsAsync(role.Name!))
            await _roleManager.CreateAsync(new IdentityRole<Guid>(role.Name!));

        await _userManager.AddToRoleAsync(user, role.Name!);

        _userRoles[user.Id] = await _userManager.GetRolesAsync(user);
        StateHasChanged();
    }

    private async Task RemoveRoleAsync(ApplicationUser user, IdentityRole<Guid> role)
    {
        await _userManager.RemoveFromRoleAsync(user, role.Name!);

        _userRoles[user.Id] = await _userManager.GetRolesAsync(user);
        StateHasChanged();
    }

    private async Task ChangeUserAndPersonelAsync(ApplicationUser user, Guid pId, Personel personel)
    {
        var inactivePersonel = _discardPersonels.FirstOrDefault(p => p.Id == pId);
        if (inactivePersonel == null)
        {
            _modalDialogPersonelChange.Close();
            StateHasChanged();
            return;
        }

        inactivePersonel.DeletedDate = null;
        inactivePersonel.UserId = user.Id;

        personel.UserId = Guid.Empty;

        user.PersonelId = inactivePersonel.Id;

        await _personelService.UpdateAsync(inactivePersonel);
        await _personelService.DeleteAsync(personel);
        await _userManager.UpdateAsync(user);
        await _userManager.AddToRoleAsync(user, "unauthorized");
        _users = _userManager.Users.ToList();

        _modalDialogPersonelChange.Close();
        StateHasChanged();
    }

    private async Task DeleteUserAsync(ApplicationUser user, Personel personel)
    {
        personel.UserId = Guid.Empty;
        personel.User = null;
        if (_userRoles[user.Id].Contains("admin"))
        {
            _modalDialogDeleteUser.Close();
            StateHasChanged();
            return;
        }
        await _personelService.DeleteAsync(personel);
        await _userManager.DeleteAsync(user);

        _users = _userManager.Users.ToList();
        var _personels = await _personelService.GetListAsync(withDeleted: true);
        this._personels = _personels!.Items;

        _modalDialogDeleteUser.Close();
        StateHasChanged();
    }

    private async Task AddTeacherAsync()
    {
        await Task.CompletedTask;
    }

    private bool IsUserInRole(ApplicationUser user, string roleName)
    {
        return _userRoles.GetValueOrDefault(user.Id, new List<string>()).Contains(roleName);
    }
}

<PageTitle>Admin Paneli</PageTitle>

<h3>DİKKAT</h3>

<p>Burada yapacağınız ayarlara dikkat ediniz</p>

<table class="table">
    <thead>
        <tr>
            <th>Personel Ad Soyad</th>
            <th>Email</th>
            <th>Roller</th>
            <th>Aksiyonlar</th>
        </tr>
    </thead>
    <tbody>
        @foreach (ApplicationUser user in _users)
        {
            Personel? personel = _personels.FirstOrDefault(p => p.UserId == user.Id);
            <tr>
                <td>@personel?.Name @personel?.SurName</td>
                <td>@user?.Email</td>
                <td>
                    @foreach (string role in _userRoles.GetValueOrDefault(user!.Id, new List<string>()))
                    {
                        <span style="font-size:1rem;" class="badge rounded-pill text-bg-warning">@role</span>
                    }
                </td>
                <td>
                    <button class="btn btn-primary" @onclick="() => {_selectedUser = user; _modalDialogRoleAssign.Open();}">Rolleri Düzenle</button>
                    <button class="btn btn-primary" @onclick="() => {_selectedPersonel=personel; _modalDialogTeacherAdd.Open();}">Öğretmen olarak ekle</button>
                    <button class="btn btn-danger" disabled>Şifreyi sıfırla</button>
                    <button class="btn btn-danger" disabled>2 Faktorlü Doğrulamayı sil</button>
                    <button class="btn btn-danger" @onclick="() => {_selectedUser = user; _selectedPersonel=personel!; _modalDialogDeleteUser.Open();}">Kullanıcıyı sil</button>
                    <button class="btn btn-primary" @onclick="() => {_selectedUser = user; _selectedPersonel = personel!; _modalDialogPersonelChange.Open();}">Personel Ata</button>
                </td>
            </tr>
        }
    </tbody>
</table>

<ModalDialog @ref="_modalDialogDeleteUser" Title="Kullanıcı Sil">

    <p>DİKKAT Kullanıcıyı silmek istediğinize emin misiniz?</p>
    <p>silinen kullanıcıya ait personel bilgileri saklanacaktır. Silinemez</p>
    <p>seçilen kullanıcı: <strong>@_selectedUser.Email</strong></p>

    <button class="btn btn-danger" @onclick="() => DeleteUserAsync(_selectedUser, _selectedPersonel!)">Sil</button>

    <button class="btn btn-primary" @onclick="() => _modalDialogDeleteUser.Close()">Kapat</button>
</ModalDialog>

<ModalDialog @ref="_modalDialogTeacherAdd">
    <TeacherAdd PersonelId="@_selectedPersonel?.Id" TriggerEvent="_modalDialogTeacherAdd.Close" />
</ModalDialog>

<ModalDialog @ref="_modalDialogRoleAssign" Title="Atanan Roller">
    <p>DİKKAT Rol planlamasını dikkatli yapınız!!!</p>
    <p>seçilen kullanıcı: <strong>@_selectedUser.Email</strong></p>
    <table class="table">
        <thead>
            <tr>
                <th>Role</th>
                <th>Aksiyonlar</th>
            </tr>
        </thead>
        <tbody>
            @foreach (IdentityRole<Guid> role in _availableRoles)
            {
                <tr>
                    <td>@role.Name</td>
                    <td>
                        <button class="btn btn-success" @onclick="() => AddRoleAsync(_selectedUser, role)" disabled="@(IsUserInRole(_selectedUser, role.Name!))">Ekle</button>
                        <button class="btn btn-danger" @onclick="() =>  RemoveRoleAsync(_selectedUser, role)" disabled="@(!IsUserInRole(_selectedUser, role.Name!))">Sil</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <button class="btn btn-primary" @onclick="() => _modalDialogRoleAssign.Close()">Kapat</button>
</ModalDialog>

<ModalDialog @ref="_modalDialogPersonelChange" Title="Personel değiştir">
    <div style="width:35rem;">
        <p>DİKKAT Personel değiştirmek istediğinize emin misiniz?</p>
        <p>seçilen kullanıcı: <strong>@_selectedUser.Email</strong></p>

        <label class="input-group-text">!Personeller: </label>
        <InputSelect class="form-select" @bind-Value="_selectedPersonelGuid">
            <option selected>Seçiniz</option>
            @foreach (Personel? personel in _discardPersonels)
            {
                <option value="@personel.Id">@personel.Name @personel.SurName @personel.BirthDate </option>
            }
        </InputSelect>
    </div>

    <button class="btn btn-danger" @onclick="() => ChangeUserAndPersonelAsync(_selectedUser,_selectedPersonelGuid, _selectedPersonel!)">Değiştir</button>
    <button class="btn btn-primary" @onclick="() => _modalDialogPersonelChange.Close()">Kapat</button>
</ModalDialog>
