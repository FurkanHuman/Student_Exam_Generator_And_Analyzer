@page "/Setup"
@rendermode InteractiveServer

@using Application.Services.Personels
@using BlazorWebUI.Client.Pages.Styles
@using Domain.Entities
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using System.Security.Cryptography
@using System.Security.Claims
@using System.Net

@inject UserManager<ApplicationUser> _userManager
@inject NavigationManager _navigationManager
@inject IUserStore<ApplicationUser> _userStore
@inject IPersonelService _personelService
@inject IHttpContextAccessor _httpContextAccessor
@inject ILogger<Setup> _logger


<ModalDialog @ref="@ModalDialog" Title="Özet">
    <div class="row">
        @if (ModalPage == 1)
        {
            <p><strong>ADMIN Kullanıcı Bilgileri</strong>: LÜTFEN UYGUN BİR ŞEKİLDE KAYIT EDİNİZ</p>
            <p><strong>Email:</strong> @adminEmail</p>
            <p><strong>Şifre:</strong> <code>@generatedPassword</code></p>
            <button class="btn btn-primary" @onclick="NextStep">İki adımlı doğrulamayı aç</button>
        }

        else if (ModalPage==2)
        {
            <p><strong>Lütfen 2 Adımlı doğrulamayı açın</strong></p>
            <button class="btn btn-success" @onclick="CompleteSetup">Bitir</button>
        }

        else
        {
            <p>Hata oluştu! Lütfen tekrar deneyiniz.</p>
            <button class="btn btn-danger" @onclick="Reload">Yeniden Dene</button>
        }
    </div>
</ModalDialog>

@code {
    private ModalDialog ModalDialog { get; set; } = new();

    private string generatedPassword = "";
    private readonly string adminEmail = "admin@root";
    private Guid AdminGuid = Guid.NewGuid();
    private Guid AdminPersonelGuid = Guid.NewGuid();
    private int ModalPage { get; set; } = 1;
    private bool _isSetupRequired = false;

    protected override async Task OnInitializedAsync()
    {
        _isSetupRequired = await IsSetupRequiredAsync();

        if (!_isSetupRequired)
        {
            string log = "Setup page unauthorized access attempt.\n" + Log();
            _logger.LogCritical(log);
            Console.WriteLine(log);
            _navigationManager.NavigateTo("/", forceLoad: true);
        }
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _isSetupRequired)
        {
            string log = "Setup page created admin.\n" + Log();
            _logger.LogWarning(log);
            Console.WriteLine(log);
            generatedPassword = GenerateSecurePassword(12);
            ModalDialog?.Open();
            StateHasChanged();
        }
        return base.OnAfterRenderAsync(firstRender);
    }

    private async Task<bool> IsSetupRequiredAsync()
    {
        bool users = _userManager.Users.Any();
        if (!users) return true;

        ICollection<ApplicationUser>? admins = await _userManager.GetUsersInRoleAsync("admin");
        return !admins.Any();
    }

    private async Task CreateAdminUser()
    {   // part of /Account/Register

        ApplicationUser adminUser = CreateUser();
        adminUser.Id = AdminGuid;
        adminUser.PersonelId = AdminPersonelGuid;

        await _userStore.SetUserNameAsync(adminUser, adminEmail, CancellationToken.None);
        IUserEmailStore<ApplicationUser> emailStore = GetEmailStore();
        await emailStore.SetEmailAsync(adminUser, adminEmail, CancellationToken.None);
        await emailStore.SetEmailConfirmedAsync(adminUser, true, CancellationToken.None);

        IdentityResult? identityResult = await _userManager.CreateAsync(adminUser, generatedPassword);

        if (identityResult.Succeeded)
        {
            await _userManager.AddToRoleAsync(adminUser, "admin");
            await AddPersonel(adminUser.Id);
        }
    }

    private async Task<Personel> AddPersonel(Guid userId)
    {
        var personel = new Personel
            {
                UserId = userId,
                Id = AdminPersonelGuid,
                Name = "Admin",
                SurName = "Administrator",
                CreatedDate = DateTime.UtcNow
            };

        return await _personelService.AddAsync(personel);
    }

    private async Task NextStep()
    {
        await CreateAdminUser();
        ModalPage = 2;
    }

    private void CompleteSetup()
    {
        ModalDialog?.Close();
        _navigationManager.NavigateTo("/", forceLoad: true);
    }

    private void Reload()
    {
        _navigationManager.NavigateTo("/Setup", forceLoad: true);
    }

    private static string GenerateSecurePassword(int length)
    {
        const string upperCase = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        const string lowerCase = "abcdefghijklmnopqrstuvwxyz";
        const string digits = "0123456789";
        const string specialChars = "!@#$%^&*()_-+=<>?";

        Random random = new();
        char[] password = new char[length];

        password[0] = upperCase[random.Next(upperCase.Length)];
        password[1] = lowerCase[random.Next(lowerCase.Length)];
        password[2] = digits[random.Next(digits.Length)];
        password[3] = specialChars[random.Next(specialChars.Length)];

        for (int i = 4; i < length; i++)
        {
            string allChars = upperCase + lowerCase + digits + specialChars;
            password[i] = allChars[random.Next(allChars.Length)];
        }

        return new string(password.OrderBy(x => random.Next()).ToArray());
    }

    private ApplicationUser CreateUser()
    {   // part of /Account/Register
        try
        {
            return Activator.CreateInstance<ApplicationUser>();
        }
        catch
        {
            throw new InvalidOperationException($"Can't create an instance of '{nameof(ApplicationUser)}'. " +
                $"Ensure that '{nameof(ApplicationUser)}' is not an abstract class and has a parameterless constructor.");
        }
    }

    private IUserEmailStore<ApplicationUser> GetEmailStore()
    {
        if (!_userManager.SupportsUserEmail)
        {
            throw new NotSupportedException("The default UI requires a user store with email support.");
        }
        return (IUserEmailStore<ApplicationUser>)_userStore;
    }


    private string Log()
    {
        HttpContext? context = _httpContextAccessor.HttpContext;

        if (context == null)
            return "HttpContext is null";

        IPAddress? remoteIp = context.Connection.RemoteIpAddress;
        string? ips = null;

        if (remoteIp != null)
        {
            if (remoteIp.IsIPv4MappedToIPv6)
                remoteIp = remoteIp.MapToIPv4();

            IPHostEntry hostEntry = Dns.GetHostEntry(remoteIp);
            IEnumerable<string>? ipList = hostEntry.AddressList
                                  .Where(ip => ip.AddressFamily == System.Net.Sockets.AddressFamily.InterNetwork ||
                                               ip.AddressFamily == System.Net.Sockets.AddressFamily.InterNetworkV6)
                                  .Select(ip => ip.ToString());

            ips = string.Join(" | ", ipList);
        }

        if (ips == null)
            ips = "ip not found";

        string? userAgent = context.Request.Headers["User-Agent"].ToString() ?? "Unknown Agent";

        ClaimsPrincipal user = context.User;
        bool isAuthenticated = user.Identity?.IsAuthenticated ?? false;
        string? username = isAuthenticated ? user.Identity?.Name : "Anonymous";
        string? userId = isAuthenticated ? user.Claims.FirstOrDefault(c => c.Type == ClaimTypes.NameIdentifier)?.Value : "Unknown";
        string? roles = string.Join(", ", user.Claims.Where(c => c.Type == ClaimTypes.Role).Select(c => c.Value));
        string? authType = isAuthenticated ? user.Identity?.AuthenticationType : "Unknown";

        bool isHttps = context.Request.IsHttps;
        int localPort = context.Connection.LocalPort;
        int remotePort = context.Connection.RemotePort;

        string method = context.Request.Method;
        string path = context.Request.Path;
        QueryString queryString = context.Request.QueryString;
        string referer = context.Request.Headers["Referer"].ToString();

        IEnumerable<string>? cookies = context.Request.Cookies.Select(c => $"{c.Key}={c.Value}");

        string? language = context.Request.Headers["Accept-Language"].ToString() ?? "Bilinmiyor";

        bool isWebSocketRequest = context.WebSockets.IsWebSocketRequest;

        string host = context.Request.Host.Value;

        return $"HTTP Request Information: \n" +
               $" - IP Addresses: {ips}\n" +
               $" - Browser: {userAgent}" +
               $" - User: {username}" +
               $" - User Id: {userId}" +
               $" - Roles: {roles}" +
               $" - HTTPS: {isHttps}" +
               $" - AUTH: {authType}" +
               $" - Ports: Local({localPort})" +
               $" - Remote({remotePort})" +
               $" - Method: {method}" +
               $" - URL: {path}{queryString}" +
               $" - Referer: {referer}" +
               $" - Language: {language}" +
               $" - WebSocket Supported? {isWebSocketRequest}" +
               $" - Host: {host})\n" +
               $" - Cookies: {string.Join("; \\", cookies)}";
    }
}