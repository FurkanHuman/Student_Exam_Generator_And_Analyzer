 <div class="@CustomCSS">
    <InputText type="@Type" class="form-control" id="floatingInput" placeholder="@PlaceHolder" @bind-Value="BindValue" />
    <label for="floatingInput">@LabelText</label>
</div>

@code {
    [Parameter]
    public string CustomCSS { get; set; } = "form-floating mb-3";
    [Parameter]
    public string? Type { get; set; }
    [Parameter]
    public string? LabelText { get; set; }
    [Parameter]
    public string? PlaceHolder { get; set; }
    [Parameter]
    public string? BindValue { get; set; }
}