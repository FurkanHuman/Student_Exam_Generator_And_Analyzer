@typeparam TKey
<div class="form-control">
    @if (CheckboxItems != null)
    {
        @foreach (var item in CheckboxItems)
        {
            <CheckboxItem Key="@item.Key" DisplayValue="@item.DisplayValue" IsSelected="@item.IsSelected" OnSelectedChanged="(val) => OnItemSelected(item, val)" />
        }
    }
</div>

@code {
    [Parameter]
    public IEnumerable<CheckboxItem<TKey>> CheckboxItems { get; set; } = [];

    [Parameter]
    public EventCallback<CheckboxItem<TKey>> OnSelectedChanged { get; set; }

    private void OnItemSelected(CheckboxItem<TKey> item, bool isSelected)
    {
        item.IsSelected = isSelected;
        OnSelectedChanged.InvokeAsync(item);
    }
}
