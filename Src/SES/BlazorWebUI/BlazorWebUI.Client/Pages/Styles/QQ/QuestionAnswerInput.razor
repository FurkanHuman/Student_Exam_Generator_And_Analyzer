@*
    tek asatır tasarımı soldan sağa:
        soru sırası
        soruya göre cevaplayıcı komponent
            
            notlar: açık uçlu kategorisinde bulunanlarda elle puan girişi olacak. sol üste kopya yada boş gibi seçenekler olacak

                açık uçluda anahtar kelimeye ye (çok tartışmalı: eğer varsa soru içinde anahtar kelimeler işaretlesin yada soruya yazılan cevabı yazsın...???) yada el ile puan girişi

                boşluk doldurmada direkt kelime istenceği için checkboxla işaretleme veya elle puan girişi

                sıralama ve eşlestirme ise sıralamaya göre giriş olacak {A: (textbox girişi)}

                doğru yanlışlarda checkbox ama boş olabilir yani üç durumlu checkboxlar. tabiki seçeneklerde olacak.

                çoktan seçmelide dropdown ile işaretlenen seçenek sadece.

        tam puan butonu
*@
@page "/test"
@rendermode InteractiveAuto
@code {
    private QQBodyDto QQBody { get; set; } = new QQBodyDto()
    {
        Question = "Bu bir test sorusudur.",
        SelectedQType = 11,
        Score = 10,
        MaxScore = 15,
        QuestionOptions = new List<QuestionOptionDto>
        {
            new QuestionOptionDto { OptionText = "A,B,C", IsCorrect = true }
        }
    };

    public QuestionAnswerInput()
    {
        this.qQBody = QQBody;
    }

    [Parameter]
    public int QuestionOrder { get; set; }

    [Parameter]
    public int Score { get; set; }

    [Parameter]
    public QQBodyDto qQBody { get; set; }

    [Parameter]
    public EventCallback<int> OnScoreChanged { get; set; }

    private void HandleScoreChange(int newScore)
    {
        Score = newScore;
        OnScoreChanged.InvokeAsync(newScore);
    }
}

