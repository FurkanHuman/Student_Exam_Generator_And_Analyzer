@*
    tek asatır tasarımı soldan sağa:
        soru sırası
        soruya göre cevaplayıcı komponent
            
            notlar: açık uçlu kategorisinde bulunanlarda elle puan girişi olacak. sol üste kopya yada boş gibi seçenekler olacak

                açık uçluda anahtar kelimeye ye (çok tartışmalı: eğer varsa soru içinde anahtar kelimeler işaretlesin yada soruya yazılan cevabı yazsın...???) yada el ile puan girişi

                boşluk doldurmada direkt kelime istenceği için checkboxla işaretleme veya elle puan girişi

                sıralama ve eşlestirme ise sıralamaya göre giriş olacak {A: (textbox girişi)}

                doğru yanlışlarda checkbox ama boş olabilir yani üç durumlu checkboxlar. tabiki seçeneklerde olacak.

                çoktan seçmelide dropdown ile işaretlenen seçenek sadece.

        tam puan butonu
*@
@page "/test"
@using BlazorWebUI.Client.Pages.Styles.QQ.QuestionAnswerInputs
@rendermode InteractiveAuto
@code {
    private IEnumerable<QuestionOptionDto> QuestionOptions { get; set; } 
    private Guid SelectedOptionId { get; set; }

    private string _keywordList {get; set; } = string.Empty;
    private readonly char[] alphabet = Enumerable.Range('A', 26).Select(c => (char)c).ToArray();

    private bool _isCheckBoxCheckedStatus { get; set; } = false;
    private byte _selectEvaluationStatus { get; set; } = 0;
    private byte _radioForTF { get; set; }

    private int _numberInputByteExpression { get; set; } = 0;

    private readonly IDictionary<byte,string> EvaluationStatusTUR = new Dictionary<byte, string>()
    {
        { 1, "Boş" },
        { 7, "Yanlış" },
        { 8, "Kısmen Doğru" },
        { 9, "Doğru" },
        { 0, "Henüz değerlendirilmedi" },
        { 3, "Alakasız cevap" },
        { 5, "Şüpheli intihal"},
        { 6, "Onaylı intihal" }
    };

    private QQBodyDto openEnded { get; set; } = new QQBodyDto()
    {
        Question = "Bu bir test sorusudur.",
        SelectedQType = 1,
        Score = 10,
        MaxScore = 15,
        QuestionOptions = new List<QuestionOptionDto>
        {
            new QuestionOptionDto { OptionText = "A,B,C", IsCorrect = true }
        }
    };

    private QQBodyDto mChoice { get; set; } = new QQBodyDto()
    {
        Question = "Bu bir test sorusudur.",
        SelectedQType = 4,
        Score = 10,
        MaxScore = 15,
        QuestionOptions = new List<QuestionOptionDto>
        {
            new QuestionOptionDto { Id = Guid.NewGuid(), OptionText = "true", IsCorrect = true },
            new QuestionOptionDto { Id = Guid.NewGuid(), OptionText = "false", IsCorrect = false },
            new QuestionOptionDto { Id = Guid.NewGuid(), OptionText = "false", IsCorrect = false },
            new QuestionOptionDto { Id = Guid.NewGuid(), OptionText = "false", IsCorrect = false }
        }
    };

    public QuestionAnswerInput()
    {
        this.QuestionData = openEnded;
        QuestionOptions = QuestionData.QuestionOptions;
        IsCustomScore = false;
    }

    [Parameter]
    public int QuestionOrder { get; set; }

    [Parameter]
    public ICollection<Guid> AnsweredQuestionIds { get; set; }

    [Parameter]
    public int Score { get; set; }

    [Parameter]
    public bool IsCustomScore { get; set; }

    [Parameter]
    public QQBodyDto QuestionData { get; set; }

    [Parameter]
    public EventCallback<byte> OnEvaluationStatus { get; set; }

    [Parameter]
    public EventCallback<int> OnScoreChanged { get; set; }

    [Parameter]
    public EventCallback<string> OnKeywordAnswer { get; set; }

    [Parameter]
    public EventCallback<ICollection<Guid>> OnQOptionAnswerIds { get; set; }

    private void HandleScoreChange(int newScore)
    {
        Score = newScore;
        OnScoreChanged.InvokeAsync(newScore);
    }

    private void ToggleOpenEndedAnswerCheck(bool checkStatus, string keyword)
    {
        switch (checkStatus)
        {
            case true:
                {
                    _keywordList += keyword + ",";
                    break;
                }

            case false:
                {
                    _keywordList = _keywordList.Replace($"{keyword},", string.Empty);
                    break;
                }
        }
    }

    private IList<string> GetOpenEndedKeywords(IEnumerable<QuestionOptionDto> questionOptions)
    {
        List<string> extractedKeywords = [];

        if (questionOptions == null || !questionOptions.Any())
            return new List<string>();


        List<string> optionTexts = questionOptions
            .Where(option => !string.IsNullOrWhiteSpace(option.OptionText))
            .Select(option => option.OptionText!)
            .ToList();

        foreach (string option in optionTexts)
            extractedKeywords.AddRange(option.Split(','));

        return extractedKeywords;
    }

    private int GetMaxScoreLimit()
    {
        if (IsCustomScore)
            return QuestionData.MaxScore;
        return QuestionData.Score;
    }
    private void HandleFullScoreChange(bool checkStatus)
    {
        if (checkStatus)
        {
            if (IsCustomScore)
            {
                Score = QuestionData.MaxScore;
                _numberInputByteExpression = 9;
                return;
            }
            _numberInputByteExpression = 9;
            Score = QuestionData.Score;
            return;
        }
        Score = 0;
    }
    private void HandleMinMaxScore(int Score)
    {
        if (Score < 0 || Score > GetMaxScoreLimit())
            return;
        HandleScoreChange(Score);
    }

    private void SelectValueHandle(byte value)
    {
        OnEvaluationStatus.InvokeAsync(value);
    }

    private void HandleTF(byte status)
    {
        switch (status)
        {
            case 0:
                {
                    break;
                }
            case 1:
                {
                    break;
                }
            case 2:
                {
                    break;
                }
            default:
                return;
        }
        Console.WriteLine(status);
    }
    private void OpenEndedHandleScore(int args)
    {
        Console.WriteLine("Açık Uçlu Puan: " + args);
    }
    private void openEndedKeywordsHandler(ICollection<string> args)
    {
        Console.WriteLine("Açık Uçlu kelimeler: " + args.Select(k => k.Trim()).Aggregate((current, next) => current + ", " + next));
    }
    private void openEndedEStatusHandler(byte args)
    {
        Console.WriteLine("Açık uçlu status: " + args);
    }
}

@*
        Tek satır tasarımı:
        Solda soru sırası, ortada soruya göre cevaplayıcı komponent,
        sağda "Tam Puan Ver" butonu.
*@

<div class="form-control mb-3">
    <div class="d-flex align-items-center justify-content-between">

        <span class="fw-bold me-3">@QuestionOrder. soru</span>

        <div class="flex-grow-1 mx-3">
            <div class="d-flex flex-column flex-md-row align-items-center flex-wrap gap-5 m-2">

            @switch (QuestionData.SelectedQType)
            {
                case 1: // açık uçlu
                    {
                        <OpenEndedAnswerInput 
                            ScoreMax="GetMaxScoreLimit()"
                            QuestionOptions="QuestionOptions" 
                            OnScore="OpenEndedHandleScore"
                            OnOpenEndedKeywords="openEndedKeywordsHandler"
                            OnEvaluationStatus="openEndedEStatusHandler"/>

                        break;
                    }
                case 3: // çoktan seçmeli
                    {
                        Guid[] qoIds = QuestionOptions.Select(qo => qo.Id).ToArray();
                        <div class="d-flex flex-column flex-md-row align-items-center flex-wrap gap-3 m-2">
                        <label class="input-group-text">Seçenekler: </label>

                        <InputRadioGroup TValue="Guid" Name="inlineRadioOptions" @bind-Value="SelectedOptionId">
                            @for (int i = 0; i < QuestionOptions.Count(); i++)
                            {
                                Guid qoId = qoIds[i];
                                string optionId = "radioOption_"+ qoId.GetHashCode() + alphabet[i];
                                <div class="form-check form-check-inline mt-1">
                                    <InputRadio class="form-check-input ml-2" type="radio" id="@optionId" Value="@qoId" />
                                    <label class="form-check-label" for="@optionId">@alphabet[i]</label>
                                </div>
                            }

                            <div class="form-check form-check-inline mt-1">
                                <InputRadio class="form-check-input ml-2" type="radio" id="Empty" Value="@Guid.Empty" />
                                <label class="form-check-label" for="Empty">Boş</label>
                            </div>
                        </InputRadioGroup>
                    </div>
                    break;
                    }

                case 4: // doğru yanlış
                    {
                        @foreach (QuestionOptionDto option in QuestionOptions)
                        {
                            <div class="d-flex align-items-center flex-wrap m-2 border p-2 ">
                                    
                                        <InputRadioGroup TValue="byte"
                                                         ValueExpression="() => _radioForTF"
                                                         ValueChanged="(e)=> HandleTF(e)"
                                                         Name="@($"RadioG_TF_{option.Id.GetHashCode()}")"
                                                         class="d-flex gap-2">
                                            <div class="form-check form-check-inline">
                                                <InputRadio class="form-check-input" id="@($"opt_{option.Id.GetHashCode()}_E")" Value="(byte)0" />
                                                <label class="form-check-label" for="@($"opt_{option.Id.GetHashCode()}_E")">Boş</label>
                                            </div>

                                            <div class="form-check form-check-inline">
                                                <InputRadio class="form-check-input" id="@($"opt_{option.Id.GetHashCode()}_T")" Value="(byte)1" />
                                                <label class="form-check-label" for="@($"opt_{option.Id.GetHashCode()}_T")">Doğru</label>
                                            </div>

                                            <div class="form-check form-check-inline">
                                                <InputRadio class="form-check-input" id="@($"opt_{option.Id.GetHashCode()}_F")" Value="(byte)2" />
                                                <label class="form-check-label" for="@($"opt_{option.Id.GetHashCode()}_F")">Yanlış</label>
                                            </div>
                                        </InputRadioGroup>
                                <label class="mx-4">@option.OptionText</label>
                            </div>
                        }
                        break;
                    }
                case 5: // boşluk doldurma
                    {
                            <div class="d-flex flex-column flex-md-row align-items-center flex-wrap gap-5 m-2">
                                <div class="d-flex align-items-center flex-wrap border rounded">
                                    <label class="input-group-text me-3">Anahtar kelimeler:</label>
                                    
                                    @foreach (string keyword in GetOpenEndedKeywords(QuestionData.QuestionOptions))
                                    {
                                        <div class="form-check form-check-inline">
                                            <InputCheckbox class="form-check-input"
                                                            id="@("inlineCheckbox" + keyword)"
                                                            ValueChanged="(e) => ToggleOpenEndedAnswerCheck(e, keyword)"
                                                            ValueExpression="() => _isCheckBoxCheckedStatus" />
                                            <label class="form-check-label" for="@("inlineCheckbox" + keyword)">
                                                @keyword
                                            </label>
                                        </div>
                                    }
                                </div>

                                <div class="d-flex align-items-center gap-2 flex-wrap bg-light text-dark border rounded">
                                    <label class="input-group-text">Durum:</label>
                                    <InputSelect class="form-select w-auto"
                                        TValue="byte"
                                        ValueExpression="() => _selectEvaluationStatus"
                                        ValueChanged="(e) => SelectValueHandle(e)">

                                        @foreach (KeyValuePair<byte,string> status in EvaluationStatusTUR)
                                        {
                                            <option value="@status.Key">@status.Value</option>
                                        }
                                    </InputSelect>
                                </div>
                        </div>
                        break;
                    }
                case 6: // eşleştirme // TUR: bu kısımv 7 numaralı soru türü ile aynı mantıkta çalışıyor, sadece görsel olarak farklılık var.
                        // fakat bu kısım ayrı bir komponente olmalı çükü PDF oluşturucuda karıştırma mantığı şuan ki yere uygun değil. zaten kod olmuş spagetti
                    {
                        <div class="d-flex flex-column flex-md-row align-items-center flex-wrap gap-5 m-2">
                            <div class="d-flex align-items-center flex-wrap border rounded">
                                <label class="input-group-text me-3">Doğru eşleşmeler:</label>
                                @foreach (QuestionOptionDto option in QuestionOptions)
                                {


                                }

                                </div>
                            </div>
                            break;
                    }
                case 7: // sıralama
                    {
                        break;
                    }
                default:
                    {
                        <p>Geçersiz soru tipi.</p>
                        break;
                    }
            }
            </div>
        </div>
    </div>
</div>
