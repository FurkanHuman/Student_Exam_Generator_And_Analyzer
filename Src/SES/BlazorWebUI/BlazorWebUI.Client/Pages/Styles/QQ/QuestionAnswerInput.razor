@using BlazorWebUI.Client.Pages.Styles.QQ.QuestionAnswerInputs
@rendermode InteractiveAuto
@code {
    private QuestionAnswerDto QuestionAnswer { get; set; } = new();

    private IEnumerable<QuestionOptionDto> QuestionOptions { get; set; } = [];

    [Parameter]
    public int QuestionOrder { get; set; }

    [Parameter]
    public bool IsCustomScore { get; set; }

    [Parameter]
    public int Seed { get; set; }

    [Parameter]
    public QQBodyDto QuestionData { get; set; } = default!;

    [Parameter]
    public QuestionAnswerDto? ExistingAnswer { get; set; }

    [Parameter]
    public EventCallback<QuestionAnswerDto> OnQAnswer { get; set; }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (QuestionData != null)
            QuestionOptions = QuestionData.QuestionOptions ?? new List<QuestionOptionDto>();

        if (ExistingAnswer != null)
        {
            QuestionAnswer = new QuestionAnswerDto
            {
                QuizQuestionId = ExistingAnswer.QuizQuestionId,
                AnswerText = ExistingAnswer.AnswerText,
                GivenScore = ExistingAnswer.GivenScore,
                QuestionOptionId = ExistingAnswer.QuestionOptionId,
                EvaluationStatus = ExistingAnswer.EvaluationStatus,
                StudentId = ExistingAnswer.StudentId,
                ExamId = ExistingAnswer.ExamId,
                EvaluationOrigin = ExistingAnswer.EvaluationOrigin
            };
        }
        else
        {
            QuestionAnswer = new QuestionAnswerDto();
        }

    }

    private int GetMaxScoreLimit()
    {
        if (IsCustomScore)
            return QuestionData.MaxScore;
        return QuestionData.Score;
    }

    private async Task OnScoreChanged(int score)
    {
        QuestionAnswer.GivenScore = score;
        await OnQAnswer.InvokeAsync(QuestionAnswer);
    }

    private async Task OnAnswerText(string answerText)
    {
        QuestionAnswer.AnswerText = answerText;
        await OnQAnswer.InvokeAsync(QuestionAnswer);
    }

    private async Task OnEvaluationStatus(byte status)
    {
        QuestionAnswer.EvaluationStatus = status;
        await OnQAnswer.InvokeAsync(QuestionAnswer);
    }

    private async Task OnOptionId(Guid? optionId)
    {
        QuestionAnswer.QuestionOptionId = optionId;
        await OnQAnswer.InvokeAsync(QuestionAnswer);
    }
}


<div class="form-control mb-3">
    <div class="d-flex align-items-center justify-content-between">

        <span class="fw-bold me-3">@QuestionOrder. soru</span>

        <div class="flex-grow-1 mx-3">
            <div class="d-flex flex-column flex-md-row align-items-center flex-wrap gap-5 m-2">

                @switch (QuestionData.SelectedQType)
                {
                    case 1: // Open-ended
                        {
                            <OpenEndedAnswerInput QuestionOptions="QuestionOptions"
                                                  ScoreMax="GetMaxScoreLimit()"
                                                  OnScore="(s) => OnScoreChanged(s)"
                                                  OnOpenEndedKeywords="(k) => OnAnswerText(k)"
                                                  OnEvaluationStatus="(e) => OnEvaluationStatus(e)" />

                            break;
                        }
                    case 3: // Multiple choice
                        {
                            <MultipleChoiceAnswerInput QuestionOptions="QuestionOptions"
                                                       ScoreMax="GetMaxScoreLimit()"
                                                       OnScore="(s) => OnScoreChanged(s)"
                                                       OnOptionId="(OId) => OnOptionId(OId)"
                                                       OnEvaluationStatus="(e) => OnEvaluationStatus(e)" />
                            break;
                        }

                    case 4: // True/False
                        {
                            <TrueFalseAnswerInput QuestionOptions="QuestionOptions"
                                                  ScoreMax="GetMaxScoreLimit()"
                                                  OnScore="(s) => OnScoreChanged(s)"
                                                  OnEncodedOptionAnswers="(k) => OnAnswerText(k)"
                                                  OnEvaluationStatus="(e) => OnEvaluationStatus(e)" />
                            break;
                        }
                    case 5: // Fill in the blank
                        {
                            <FillInTheBlankAnswerInput QuestionOptions="QuestionOptions"
                                                       ScoreMax="GetMaxScoreLimit()"
                                                       OnScore="(s) => OnScoreChanged(s)"
                                                       OnFillInTheBlankKeywords="(k) => OnAnswerText(k)"
                                                       OnEvaluationStatus="(e) => OnEvaluationStatus(e)" />
                            break;
                        }
                    case 6: // Matching
                        {
                            <MatchingAnswerInput QuestionOptions="QuestionOptions"
                                                 ScoreMax="GetMaxScoreLimit()"
                                                 OnScore="(s) => OnScoreChanged(s)"
                                                 OnEncodedOptionAnswers="(k) => OnAnswerText(k)"
                                                 OnEvaluationStatus="(e) => OnEvaluationStatus(e)"
                                                 Seed="Seed" />
                            break;
                        }
                    case 7: // Ordering
                        {
                            <p>Planlanan Komponent</p>
                            <p>Geçersiz soru tipi.</p>
                            break;
                        }

                    default:
                        {
                            <p>Geçersiz soru tipi.</p>
                            break;
                        }
                }
            </div>
        </div>
    </div>
</div>
