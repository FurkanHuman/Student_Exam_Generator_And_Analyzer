@code {
    private IDictionary<string, bool> _keywordCheckedStatusDict { get; set; } = new Dictionary<string, bool>();
    private string _keywordList { get; set; } = string.Empty;
    private double _perKeywordScore { get; set; }
    private int _score { get; set; } = 0;
    private uint _openEndedKeywordsCount { get; set; }
    private byte _selectedEvaluationStatus { get; set; } = 0;

    [Parameter]
    public IEnumerable<QuestionOptionDto> QuestionOptions { get; set; } = default!;

    [Parameter]
    public int ScoreMax { get; set; }

    [Parameter]
    public EventCallback<string> OnOpenEndedKeywords { get; set; }

    [Parameter]
    public EventCallback<int> OnScore { get; set; }

    [Parameter]
    public EventCallback<byte> OnEvaluationStatus { get; set; }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _openEndedKeywordsCount = (uint)GetOpenEndedKeywords().Count();
        if (_keywordCheckedStatusDict.Count == 0)
            foreach (string str in GetOpenEndedKeywords())
                _keywordCheckedStatusDict[str] = false;
    }

    private IEnumerable<string> GetOpenEndedKeywords()
    {
        if (QuestionOptions == null)
            yield break;

        foreach (QuestionOptionDto Option in QuestionOptions)
        {
            if (string.IsNullOrEmpty(Option?.OptionText))
                continue;
            string[]? keywords = Option.OptionText.Split(',');

            foreach (string keyword in keywords)
            {
                string trimmedKeyword = keyword.Trim();
                if (!string.IsNullOrEmpty(trimmedKeyword))
                    yield return trimmedKeyword;
            }
        }
    }

    private void ToggleOpenEndedAnswerCheck(bool checkStatus, string keyword)
    {
        _keywordCheckedStatusDict[keyword] = checkStatus;

        IEnumerable<string> checkedKeywords = _keywordCheckedStatusDict.Where(x => x.Value).Select(x => x.Key);
        _keywordList = string.Join(",", checkedKeywords);

        _perKeywordScore = (double)ScoreMax * checkedKeywords.Count() / _openEndedKeywordsCount;
        _score = (int)Math.Round(_perKeywordScore, 2, MidpointRounding.ToEven);

        UpdateEvaluationStatus();
        OnScore.InvokeAsync(_score);
        OnOpenEndedKeywords.InvokeAsync(_keywordList);
    }

    private void OnScoreInputChanged(ChangeEventArgs args)
    {
        string raw = args.Value?.ToString() ?? string.Empty;

        if (int.TryParse(raw, out int value))
            _score = Math.Clamp(value, 0, ScoreMax);
        else
            _score = 0;

        UpdateEvaluationStatus();
        OnScore.InvokeAsync(_score);
    }

    private void UpdateEvaluationStatus()
    {
        if (_score < ScoreMax)
            _selectedEvaluationStatus = 8;
        else if (_score == ScoreMax)
            _selectedEvaluationStatus = 9;
        OnEvaluationStatus.InvokeAsync(_selectedEvaluationStatus);
    }

    private void EvaluationStatusChanged(ChangeEventArgs args)
    {
        string raw = args.Value?.ToString() ?? string.Empty;
        if (byte.TryParse(raw, out byte value))
        {
            _selectedEvaluationStatus = value;
            OnEvaluationStatus.InvokeAsync(_selectedEvaluationStatus);
        }
        else
        {
            _selectedEvaluationStatus = 0;
            OnEvaluationStatus.InvokeAsync(_selectedEvaluationStatus);
        }
        ApplyEvaluationStatusEffects();
    }

    private void ApplyEvaluationStatusEffects()
    {
        switch (_selectedEvaluationStatus)
        {
            case 0 or 1:
                {
                    _score = 0;
                    _keywordList = string.Empty;
                    _keywordCheckedStatusDict = _keywordCheckedStatusDict.ToDictionary(x => x.Key, x => false);
                    break;
                }

            case 3 or 5 or 6 or 7:
                {
                    _score = 0;
                    break;
                }

            case 9:
                {
                    _score = ScoreMax;
                    _keywordList = string.Join(",", _keywordCheckedStatusDict.Where(x => x.Value).Select(x => x.Key));
                    break;
                }
        }
        OnScore.InvokeAsync(_score);
        OnOpenEndedKeywords.InvokeAsync(_keywordList);
    }
}

<div class="answer-input-section">
    <div class="keyword-selector card border-0 shadow-sm mb-3">
        <div class="card-header bg-success text-white">
            <i class="bi bi-key me-2"></i>Anahtar Kelimeler
        </div>
        <div class="card-body">
            <div class="keywords-grid">
                @foreach (string keyword in _keywordCheckedStatusDict.Keys.ToList())
                {
                    <div class="form-check keyword-item">
                        <InputCheckbox class="form-check-input"
                                       id="@("keyword_" + keyword.GetHashCode())"
                                       Value="@_keywordCheckedStatusDict[keyword]"
                                       ValueChanged="(newValue) => ToggleOpenEndedAnswerCheck(newValue, keyword)"
                                       ValueExpression="@(() => _keywordCheckedStatusDict[keyword])" />
                        <label class="form-check-label" for="@("keyword_" + keyword.GetHashCode())">
                            @keyword
                        </label>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-4">
            <div class="score-input card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="bi bi-star-fill text-warning fs-4"></i>
                    <div class="flex-grow-1">
                        <label class="form-label mb-1 small text-muted">Puan</label>
                        <InputNumber type="number"
                                     class="form-control"
                                     min="0"
                                     max="@ScoreMax"
                                     TValue="int"
                                     @oninput="OnScoreInputChanged"
                                     @bind-Value="_score" />
                    </div>
                    <span class="text-muted">/ @ScoreMax</span>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="status-selector card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="bi bi-clipboard-check text-primary fs-4"></i>
                    <div class="flex-grow-1">
                        <label class="form-label mb-1 small text-muted">Değerlendirme Durumu</label>
                        <InputSelect class="form-select"
                                     TValue="byte"
                                     @oninput="EvaluationStatusChanged"
                                     @bind-Value="_selectedEvaluationStatus">
                            @foreach (KeyValuePair<byte, string> status in QQStatic.EvaluationStatusTUR)
                            {
                                <option value="@status.Key">@status.Value</option>
                            }
                        </InputSelect>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .answer-input-section {
        animation: fadeIn 0.3s ease-out;
    }

    .keywords-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 0.75rem;
    }

    .keyword-item {
        padding: 0.5rem;
        border-radius: 0.375rem;
        transition: all 0.2s;
        background: #f8f9fa;
    }

        .keyword-item:hover {
            background: #e9ecef;
        }

        .keyword-item .form-check-input:checked ~ label {
            font-weight: 600;
            color: #198754;
        }

    .form-check-input {
        width: 1.25rem;
        height: 1.25rem;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>