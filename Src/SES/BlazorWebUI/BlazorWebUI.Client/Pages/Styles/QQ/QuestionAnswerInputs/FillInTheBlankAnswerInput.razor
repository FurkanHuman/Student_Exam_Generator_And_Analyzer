@code {

    private IDictionary<string, bool> _keywordCheckedStatusDict { get; set; } = new Dictionary<string, bool>();
    private string _keywordList { get; set; } = string.Empty;
    private double _perKeywordScore { get; set; }
    private int _score { get; set; } = 0;
    private uint _fillInTheBlankKeywordsCount { get; set; }
    private uint _selectedKeywordsCount { get; set; }
    private byte _selectedEvaluationStatus { get; set; } = 0;

    [Parameter]
    public IEnumerable<QuestionOptionDto> QuestionOptions { get; set; } = default!;

    [Parameter]
    public int ScoreMax { get; set; }

    [Parameter]
    public EventCallback<string> OnFillInTheBlankKeywords { get; set; }

    [Parameter]
    public EventCallback<int> OnScore { get; set; }

    [Parameter]
    public EventCallback<byte> OnEvaluationStatus { get; set; }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        _fillInTheBlankKeywordsCount = (uint)GetFillInTheBlankKeywords().Count();

        if (_keywordCheckedStatusDict.Count == 0)
            foreach (string str in GetFillInTheBlankKeywords())
                _keywordCheckedStatusDict[str] = false;


    }

    private IEnumerable<string> GetFillInTheBlankKeywords()
    {
        if (QuestionOptions == null)
            yield break;

        foreach (QuestionOptionDto Option in QuestionOptions)
        {
            if (string.IsNullOrEmpty(Option?.OptionText))
                continue;
            string[]? keywords = Option.OptionText.Split(',');

            foreach (string keyword in keywords)
            {
                string trimmedKeyword = keyword.Trim();
                if (!string.IsNullOrEmpty(trimmedKeyword))
                    yield return trimmedKeyword;
            }
        }
    }

    private void ToggleFillInTheBlankAnswerCheck(bool checkStatus, string keyword)
    {
        _keywordCheckedStatusDict[keyword] = checkStatus;

        IEnumerable<string> checkedKeywords = _keywordCheckedStatusDict.Where(x => x.Value).Select(x => x.Key);
        _keywordList = string.Join(",", checkedKeywords);

        _perKeywordScore = (double)ScoreMax * checkedKeywords.Count() / _fillInTheBlankKeywordsCount;
        _score = (int)Math.Round(_perKeywordScore, 2, MidpointRounding.ToEven);

        UpdateEvaluationStatus();
        OnScore.InvokeAsync(_score);
        OnFillInTheBlankKeywords.InvokeAsync(_keywordList);
    }

    private void OnScoreInputChanged(ChangeEventArgs args)
    {
        string raw = args.Value?.ToString() ?? string.Empty;

        if (int.TryParse(raw, out int value))
            _score = Math.Clamp(value, 0, ScoreMax);
        else
            _score = 0;

        UpdateEvaluationStatus();
        OnScore.InvokeAsync(_score);
    }

    private void UpdateEvaluationStatus()
    {
        if (_score < ScoreMax)
            _selectedEvaluationStatus = 8;
        else if (_score == ScoreMax)
            _selectedEvaluationStatus = 9;
        OnEvaluationStatus.InvokeAsync(_selectedEvaluationStatus);
    }

    private void EvaluationStatusChanged(ChangeEventArgs args)
    {
        string raw = args.Value?.ToString() ?? string.Empty;
        if (byte.TryParse(raw, out byte value))
        {
            _selectedEvaluationStatus = value;

            OnEvaluationStatus.InvokeAsync(_selectedEvaluationStatus);
        }
        else
        {
            _selectedEvaluationStatus = 0;
            OnEvaluationStatus.InvokeAsync(_selectedEvaluationStatus);
        }
        ApplyEvaluationStatusEffects();
    }

    private void ApplyEvaluationStatusEffects()
    {
        switch (_selectedEvaluationStatus)
        {
            case 0 or 1:
                {
                    _score = 0;
                    _keywordList = string.Empty;
                    _keywordCheckedStatusDict = _keywordCheckedStatusDict.ToDictionary(x => x.Key, x => false);
                    break;
                }

            case 3 or 5 or 6 or 7:
                {
                    _score = 0;
                    break;
                }

            case 9:
                {
                    _score = ScoreMax;
                    _keywordCheckedStatusDict = _keywordCheckedStatusDict.ToDictionary(x => x.Key, x => true);
                    break;
                }
        }
        OnScore.InvokeAsync(_score);
        OnFillInTheBlankKeywords.InvokeAsync(_keywordList);
    }
}

<div class="d-flex align-items-center flex-wrap border rounded">
    <label class="input-group-text me-3">Kelimeler:</label>

    @foreach (string keyword in _keywordCheckedStatusDict.Keys.ToList())
    {
        <div class="form-check form-check-inline">
            <InputCheckbox class="form-check-input" id="@("inlineCheckbox" + keyword)"
                           Value="@_keywordCheckedStatusDict[keyword]"
                           ValueChanged="(newValue) => ToggleFillInTheBlankAnswerCheck(newValue, keyword)"
                           ValueExpression="@(() => _keywordCheckedStatusDict[keyword])" />

            <label class="form-check-label" for="@("inlineCheckbox" + keyword)">
                @keyword
            </label>
        </div>
    }
</div>

<div class="input-group rounded border" style="width:12rem;">
    <label class="input-group-text">Puanı:</label>
    <InputNumber type="number" class="form-control conversion" id="ScoreInput" min="0" max="@ScoreMax" TValue="int"
                 @oninput="OnScoreInputChanged" @bind-Value="_score" />
</div>

<div class="d-flex align-items-center gap-2 flex-wrap bg-light text-dark border rounded">
    <label class="input-group-text">Durum:</label>
    <InputSelect class="form-select w-auto" TValue="byte" @oninput="EvaluationStatusChanged"
                 @bind-Value="_selectedEvaluationStatus">

        @foreach (KeyValuePair<byte, string> status in QQStatic.EvaluationStatusTUR)
        {
            <option value="@status.Key">@status.Value</option>
        }
    </InputSelect>
</div>
