@code {
    private IDictionary<Guid, byte> _tFAnswers { get; set; } = new Dictionary<Guid, byte>();
    private int _optionCount { get; set; } = 0;
    private int _score { get; set; } = 0;
    private byte _selectedTFRadio { get; set; } = 0;

    [Parameter]
    public IEnumerable<QuestionOptionDto> QuestionOptions { get; set; } = default!;

    [Parameter]
    public int ScoreMax { get; set; } = 0;

    [Parameter]
    public EventCallback<byte> OnEvaluationStatus { get; set; }

    [Parameter]
    public EventCallback<int> OnScore { get; set; }

    [Parameter]
    public EventCallback<string> OnEncodedOptionAnswers { get; set; }

    private string? _lastEncodedAnswers;
    private int _lastScore = -1;
    private byte? _lastEvaluationStatus;

    private void ProcessTFSelection(Guid id, byte optionValue)
    {
        if (_tFAnswers.TryGetValue(id, out byte currentValue) && currentValue == optionValue)
            return;

        _tFAnswers[id] = optionValue;

        CalculateScore();
        UpdateState();
    }

    private void CalculateScore()
    {
        double perOptionScore = 0;

        foreach (KeyValuePair<Guid, byte> answerPair in _tFAnswers)
        {
            if (answerPair.Value == 2) continue;

            QuestionOptionDto? option = QuestionOptions.FirstOrDefault(x => x.Id == answerPair.Key);
            if (option == null) continue;

            bool isCorrect = (answerPair.Value == 1 && option.IsCorrect) ||
                           (answerPair.Value == 0 && !option.IsCorrect);

            if (isCorrect)
                perOptionScore += (double)ScoreMax / _optionCount;
        }

        _score = (int)Math.Round(perOptionScore, 2, MidpointRounding.ToEven);
    }

    private byte GetEvaluationStatus()
    {
        if (_score < ScoreMax && _score > 0)
            return 8;
        else if (_score == ScoreMax)
            return 9;
        else if (_score == 0)
            return 1;
        return 0;
    }

    private void UpdateState()
    {
        byte currentEvaluationStatus = GetEvaluationStatus();
        string currentEncodedAnswers = System.Text.Json.JsonSerializer.Serialize(_tFAnswers);

        if (_lastEvaluationStatus != currentEvaluationStatus)
        {
            _lastEvaluationStatus = currentEvaluationStatus;
            OnEvaluationStatus.InvokeAsync(currentEvaluationStatus);
        }

        if (_lastScore != _score)
        {
            _lastScore = _score;
            OnScore.InvokeAsync(_score);
        }

        if (_lastEncodedAnswers != currentEncodedAnswers)
        {
            _lastEncodedAnswers = currentEncodedAnswers;
            OnEncodedOptionAnswers.InvokeAsync(currentEncodedAnswers);
        }
    }

    private byte GetAnswer(Guid id)
    {
        return _tFAnswers.TryGetValue(id, out byte value) ? value : (byte)2;
    }

    private void SetAnswer(Guid id, byte value)
    {
        ProcessTFSelection(id, value);
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        int newOptionCount = QuestionOptions?.Count() ?? 0;
        if (_optionCount != newOptionCount || _tFAnswers.Count == 0)
        {
            _optionCount = newOptionCount;
            _tFAnswers.Clear();

            if (QuestionOptions != null)
            {
                foreach (QuestionOptionDto option in QuestionOptions)
                {
                    _tFAnswers[option.Id] = 2;
                }
            }

            _lastScore = -1;
            _lastEvaluationStatus = null;
            _lastEncodedAnswers = null;

            OnEvaluationStatus.InvokeAsync(0);
        }
    }
}

<div class="tf-answer-section card border-0 shadow-sm">
    <div class="card-header bg-info text-white">
        <i class="bi bi-check2-square me-2"></i>Doğru / Yanlış İfadeleri
    </div>
    <div class="card-body">
        <div class="statements-list">
            @foreach (var (option, index) in QuestionOptions.Select((o, i) => (o, i)))
            {
                int hashCode = option.Id.GetHashCode();
                byte currentAnswer = GetAnswer(option.Id);

                <div class="statement-card @(currentAnswer != 2 ? "answered" : "")">
                    <div class="statement-header">
                        <span class="badge bg-secondary">İfade @(index + 1)</span>
                    </div>
                    <p class="statement-text">@option.OptionText</p>

                    <InputRadioGroup TValue="byte"
                                     Value="@currentAnswer"
                                     ValueChanged="val => SetAnswer(option.Id, val)"
                                     ValueExpression="() => _selectedTFRadio"
                                     Name="@($"TF_{hashCode}")"
                                     class="answer-options">

                        <div class="option-group">
                            <label class="option-btn empty @(currentAnswer == 2 ? "selected" : "")"
                                   for="@($"tf_{hashCode}_E")">
                                <InputRadio class="form-check-input" id="@($"tf_{hashCode}_E")" Value="(byte)2" />
                                <span><i class="bi bi-dash-circle"></i> Boş</span>
                            </label>

                            <label class="option-btn true @(currentAnswer == 1 ? "selected" : "")"
                                   for="@($"tf_{hashCode}_T")">
                                <InputRadio class="form-check-input" id="@($"tf_{hashCode}_T")" Value="(byte)1" />
                                <span><i class="bi bi-check-circle"></i> Doğru</span>
                            </label>

                            <label class="option-btn false @(currentAnswer == 0 ? "selected" : "")"
                                   for="@($"tf_{hashCode}_F")">
                                <InputRadio class="form-check-input" id="@($"tf_{hashCode}_F")" Value="(byte)0" />
                                <span><i class="bi bi-x-circle"></i> Yanlış</span>
                            </label>
                        </div>
                    </InputRadioGroup>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .tf-answer-section {
        animation: fadeIn 0.3s ease-out;
    }

    .statements-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .statement-card {
        padding: 1rem;
        border: 2px solid #dee2e6;
        border-radius: 0.5rem;
        background: white;
        transition: all 0.3s;
    }

        .statement-card.answered {
            border-color: #17a2b8;
            background: #f0f8ff;
        }

    .statement-header {
        margin-bottom: 0.75rem;
    }

    .statement-text {
        margin-bottom: 1rem;
        font-size: 1rem;
        line-height: 1.6;
    }

    .option-group {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .option-btn {
        flex: 1;
        min-width: 100px;
        padding: 0.75rem 1rem;
        border: 2px solid #dee2e6;
        border-radius: 0.5rem;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s;
        background: white;
    }

        .option-btn:hover {
            border-color: #17a2b8;
            box-shadow: 0 2px 8px rgba(23, 162, 184, 0.2);
        }

        .option-btn.selected {
            font-weight: 600;
            box-shadow: 0 4px 12px rgba(23, 162, 184, 0.3);
        }

        .option-btn.empty.selected {
            border-color: #6c757d;
            background: #f8f9fa;
        }

        .option-btn.true.selected {
            border-color: #28a745;
            background: #d4edda;
            color: #155724;
        }

        .option-btn.false.selected {
            border-color: #dc3545;
            background: #f8d7da;
            color: #721c24;
        }

        .option-btn .form-check-input {
            display: none;
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>