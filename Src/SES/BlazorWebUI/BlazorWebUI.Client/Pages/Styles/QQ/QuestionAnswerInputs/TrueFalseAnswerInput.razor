@code {
    private IDictionary<Guid, byte> _tFAnswers { get; set; } = new Dictionary<Guid, byte>();
    private int _optionCount { get; set; } = 0;
    private int _score { get; set; } = 0;
    private byte _selectedTFRadio { get; set; } = 0;

    [Parameter]
    public IEnumerable<QuestionOptionDto> QuestionOptions { get; set; } = default!;

    [Parameter]
    public int ScoreMax { get; set; } = 0;

    [Parameter]
    public EventCallback<byte> OnEvaluationStatus { get; set; }

    [Parameter]
    public EventCallback<int> OnScore { get; set; }

    [Parameter]
    public EventCallback<string> OnEncodedOptionAnswers { get; set; }

    private string? _lastEncodedAnswers;
    private int _lastScore = -1;
    private byte? _lastEvaluationStatus;

    private void ProcessTFSelection(Guid id, byte optionValue)
    {
        if (_tFAnswers.TryGetValue(id, out byte currentValue) && currentValue == optionValue)
            return;

        _tFAnswers[id] = optionValue;

        CalculateScore();
        UpdateState();
    }

    private void CalculateScore()
    {
        double perOptionScore = 0;

        foreach (KeyValuePair<Guid, byte> answerPair in _tFAnswers)
        {
            if (answerPair.Value == 2) continue;

            QuestionOptionDto? option = QuestionOptions.FirstOrDefault(x => x.Id == answerPair.Key);
            if (option == null) continue;

            bool isCorrect = (answerPair.Value == 1 && option.IsCorrect) ||
                           (answerPair.Value == 0 && !option.IsCorrect);

            if (isCorrect)
                perOptionScore += (double)ScoreMax / _optionCount;
        }

        _score = (int)Math.Round(perOptionScore, 2, MidpointRounding.ToEven);
    }

    private byte GetEvaluationStatus()
    {
        if (_score < ScoreMax && _score > 0)
            return 8;
        else if (_score == ScoreMax)
            return 9;
        else if (_score == 0)
            return 1;
        return 0;
    }

    private void UpdateState()
    {
        byte currentEvaluationStatus = GetEvaluationStatus();
        string currentEncodedAnswers = System.Text.Json.JsonSerializer.Serialize(_tFAnswers);

        if (_lastEvaluationStatus != currentEvaluationStatus)
        {
            _lastEvaluationStatus = currentEvaluationStatus;
            OnEvaluationStatus.InvokeAsync(currentEvaluationStatus);
        }

        if (_lastScore != _score)
        {
            _lastScore = _score;
            OnScore.InvokeAsync(_score);
        }

        if (_lastEncodedAnswers != currentEncodedAnswers)
        {
            _lastEncodedAnswers = currentEncodedAnswers;
            OnEncodedOptionAnswers.InvokeAsync(currentEncodedAnswers);
        }
    }

    private byte GetAnswer(Guid id)
    {
        return _tFAnswers.TryGetValue(id, out byte value) ? value : (byte)2;
    }

    private void SetAnswer(Guid id, byte value)
    {
        ProcessTFSelection(id, value);
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        int newOptionCount = QuestionOptions?.Count() ?? 0;
        if (_optionCount != newOptionCount || _tFAnswers.Count == 0)
        {
            _optionCount = newOptionCount;
            _tFAnswers.Clear();

            if (QuestionOptions != null)
            {
                foreach (QuestionOptionDto option in QuestionOptions)
                {
                    _tFAnswers[option.Id] = 2;
                }
            }

            _lastScore = -1;
            _lastEvaluationStatus = null;
            _lastEncodedAnswers = null;

            OnEvaluationStatus.InvokeAsync(0);
        }
    }
}

@foreach (Guid optionId in QuestionOptions.Select(o => o.Id))
{
    int hashCode = optionId.GetHashCode();

    <div style="display: block; width: 100%;">
        <div class="d-block w-50 m-0 border p-2 ps-5">
            <InputRadioGroup TValue="byte"
                             Value="@GetAnswer(optionId)"
                             ValueChanged="val => SetAnswer(optionId, val)"
                             ValueExpression="()=>_selectedTFRadio"
                             Name="@($"RadioG_TF_{hashCode}")"
                             class="d-flex gap-2">

                <div class="form-check form-check-inline">
                    <InputRadio class="form-check-input" id="@($"opt_{hashCode}_E")" Value="(byte)2" />
                    <label class="form-check-label" for="@($"opt_{hashCode}_E")">Boş</label>
                </div>

                <div class="form-check form-check-inline">
                    <InputRadio class="form-check-input" id="@($"opt_{hashCode}_T")" Value="(byte)1" />
                    <label class="form-check-label" for="@($"opt_{hashCode}_T")">Doğru</label>
                </div>

                <div class="form-check form-check-inline">
                    <InputRadio class="form-check-input" id="@($"opt_{hashCode}_F")" Value="(byte)0" />
                    <label class="form-check-label" for="@($"opt_{hashCode}_F")">Yanlış</label>
                </div>
            </InputRadioGroup>
        </div>
    </div>
}