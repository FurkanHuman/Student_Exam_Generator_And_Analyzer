@code {
    private int _questionOptionCount { get; set; }
    private string[] _firstParts { get; set; } = Array.Empty<string>();
    private string[] _secondParts { get; set; } = Array.Empty<string>();
    private IDictionary<string, string> _matchSelections { get; set; } = new Dictionary<string, string>();

    private IEnumerable<QuestionOptionDto> _previousQuestionOptions = default!;
    private int _previousSeed;
    private int _currentScore = 0;

    [Parameter]
    public IEnumerable<QuestionOptionDto> QuestionOptions { get; set; } = default!;

    [Parameter]
    public int ScoreMax { get; set; } = 0;

    [Parameter]
    public int Seed { get; set; }

    [Parameter]
    public EventCallback<byte> OnEvaluationStatus { get; set; }

    [Parameter]
    public EventCallback<string> OnEncodedOptionAnswers { get; set; }

    [Parameter]
    public EventCallback<int> OnScore { get; set; }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (QuestionOptions == _previousQuestionOptions && Seed == _previousSeed)
            return;

        _previousQuestionOptions = QuestionOptions;
        _previousSeed = Seed;

        Random _rnd = new(Seed);

        QuestionOptionDto[]? shuffledOptions = QuestionOptions
            .Select(q => (Value: q, Order: _rnd.Next()))
            .OrderBy(x => x.Order)
            .Select(x => x.Value)
            .ToArray();

        _questionOptionCount = shuffledOptions.Length;

        string[] tempF = new string[_questionOptionCount];
        string[] tempS = new string[_questionOptionCount];

        for (int i = 0; i < _questionOptionCount; i++)
        {
            string[] splitedString = (shuffledOptions[i].OptionText ?? string.Empty).Split(',');
            tempF[i] = splitedString.Length > 0 ? splitedString[0].Trim() : string.Empty;
            tempS[i] = splitedString.Length > 1 ? splitedString[1].Trim() : string.Empty;
        }

        QQStatic.ShuffleStringArray(ref tempF, _rnd.Next());
        QQStatic.ShuffleStringArray(ref tempS, _rnd.Next());

        _firstParts = tempF;
        _secondParts = tempS;

        _matchSelections.Clear();

        foreach (string key in _secondParts)
            _matchSelections[key] = "";
    }

    private void HandleMatchSelectionInput(ChangeEventArgs args, string rightKey)
    {
        string? selectedLeftValue = args.Value?.ToString();
        if (selectedLeftValue == null)
            return;

        _matchSelections[rightKey] = selectedLeftValue;

        int newScore = CalculateScore();
        if (newScore != _currentScore)
        {
            _currentScore = newScore;
            OnScore.InvokeAsync(_currentScore);
        }

        byte evaluationStatus = UpdateEvaluationStatus(_currentScore);
        OnEvaluationStatus.InvokeAsync(evaluationStatus);

        string encodedAnswers = EncodeOptionAnswers();
        OnEncodedOptionAnswers.InvokeAsync(encodedAnswers);
        StateHasChanged();
    }

    private int CalculateScore()
    {
        if (_questionOptionCount == 0) return 0;

        int correctMatches = 0;
        QuestionOptionDto[] originalOptions = QuestionOptions.ToArray();

        foreach (var kvp in _matchSelections)
        {
            if (string.IsNullOrEmpty(kvp.Value))
                continue;

            string rightPart = kvp.Key;
            string selectedLeftPart = kvp.Value;

            QuestionOptionDto? correctOption = Array.Find(originalOptions, (opt =>
                opt.OptionText != null &&
                opt.OptionText.Split(',').Length == 2 &&
                opt.OptionText.Split(',')[0].Trim() == selectedLeftPart &&
                opt.OptionText.Split(',')[1].Trim() == rightPart));

            if (correctOption != null)
                correctMatches++;
        }

        double scorePerMatch = (double)ScoreMax / _questionOptionCount;

        return (int)Math.Round((correctMatches * scorePerMatch), 2, MidpointRounding.ToEven);
    }

    private byte UpdateEvaluationStatus(int score)
    {
        bool hasAnySelection = _matchSelections.Any(kvp => !string.IsNullOrEmpty(kvp.Value));

        if (!hasAnySelection)
            return 0;

        bool allMatchesCompleted = _matchSelections.All(kvp => !string.IsNullOrEmpty(kvp.Value));

        if (allMatchesCompleted)
        {
            if (score == ScoreMax)
                return 9;
            else
                return 7;
        }

        return 8;
    }

    private string EncodeOptionAnswers()
    {
        IDictionary<string, string> selections = _matchSelections.Where(kvp => !string.IsNullOrEmpty(kvp.Value))
                                       .ToDictionary(kvp => kvp.Key, kvp => kvp.Value);
        return System.Text.Json.JsonSerializer.Serialize(selections);
    }
}

<div class="matching-section card border-0 shadow-sm">
    <div class="card-header bg-purple text-white">
        <i class="bi bi-arrows-collapse me-2"></i>Eşleştirme
    </div>
    <div class="card-body">
        <div class="matching-instruction alert alert-info mb-3">
            <i class="bi bi-info-circle me-2"></i>
            Sol sütundaki her öğe için sağ sütundan eşleştiğini seçin
        </div>

        <div class="matching-grid">
            @for (byte i = 0; i < _questionOptionCount; i++)
            {
                string rightKey = _secondParts[i];
                bool isMatched = !string.IsNullOrEmpty(_matchSelections[rightKey]);

                <div class="match-row @(isMatched ? "matched" : "")">
                    <div class="left-item">
                        <span class="item-marker bg-primary">@QQStatic.Alphabet[i]</span>
                        <span class="item-text">@_firstParts[i]</span>
                    </div>

                    <div class="match-selector">
                        <InputSelect class="form-select"
                                     TValue="string"
                                     value="@_matchSelections[rightKey]"
                                     @onchange="(args) => HandleMatchSelectionInput(args, rightKey)">
                            <option value="">Seç...</option>
                            @for (byte j = 0; j < _firstParts.Length; j++)
                            {
                                <option value="@_firstParts[j]">@QQStatic.Alphabet[j]</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="right-item">
                        <span class="item-marker bg-success">@(i + 1)</span>
                        <span class="item-text">@_secondParts[i]</span>
                    </div>
                </div>
            }
        </div>

        <div class="score-indicator mt-3 p-3 bg-light rounded">
            <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted">
                    <i class="bi bi-check2-all me-1"></i>
                    Doğru Eşleşme: <strong>@(_currentScore > 0 ? $"{_currentScore}/{ScoreMax}" : "Henüz yok")</strong>
                </span>
                <span class="badge bg-primary">
                    @_matchSelections.Count(x => !string.IsNullOrEmpty(x.Value)) / @_questionOptionCount Tamamlandı
                </span>
            </div>
        </div>
    </div>
</div>

<style>
    .matching-section {
        animation: fadeIn 0.3s ease-out;
    }

    .bg-purple {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .matching-grid {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .match-row {
        display: grid;
        grid-template-columns: 2fr auto 2fr;
        gap: 1rem;
        align-items: center;
        padding: 1rem;
        border: 2px solid #dee2e6;
        border-radius: 0.5rem;
        background: white;
        transition: all 0.3s;
    }

        .match-row:hover {
            border-color: #667eea;
            box-shadow: 0 2px 8px rgba(102, 126, 234, 0.15);
        }

        .match-row.matched {
            border-color: #28a745;
            background: #f0fff4;
        }

    .left-item, .right-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .item-marker {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        color: white;
        border-radius: 50%;
        font-weight: bold;
        flex-shrink: 0;
    }

    .item-text {
        flex: 1;
        font-size: 1rem;
    }

    .match-selector {
        min-width: 100px;
    }

        .match-selector select {
            font-weight: 600;
            text-align: center;
            border: 2px solid #667eea;
        }

    .score-indicator {
        border-left: 4px solid #667eea;
    }

    @@media (max-width: 768px) {
        .match-row {
            grid-template-columns: 1fr;
            gap: 0.75rem;
        }

        .match-selector {
            width: 100%;
        }
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>