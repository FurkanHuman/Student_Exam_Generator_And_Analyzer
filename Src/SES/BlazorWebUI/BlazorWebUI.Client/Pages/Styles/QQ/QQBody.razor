@using BlazorWebUI.Client.Pages.Styles.Form

<div class="qq-body-container">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-question-circle me-2"></i>
                @(IsVariantMode ? "Soru Versiyonu Düzenle" : "Soru Oluştur")
            </h5>
        </div>

        <div class="card-body p-4">
            @if (IsVariantMode && VariantData != null)
            {
                <div class="alert alert-success mb-4" role="alert">
                    <i class="bi bi-diagram-2 me-2"></i>
                    <strong>Versiyon Modu:</strong> Orijinal sorudan kopyalanan verilerle yeni bir versiyon oluşturuyorsunuz.
                    İstediğiniz alanları değiştirebilirsiniz.
                </div>
            }

            @if (CheckboxItems.Count > 0)
            {
                <div class="mb-4 p-3 bg-light rounded">
                    <h6 class="text-primary mb-3"><i class="bi bi-bookmark-star me-2"></i>Kazanımlar</h6>
                    <QQBenefitAdd OnSelectedBenefits="HandleBenefits" CheckboxItems="CheckboxItems" />

                    @if (_bodyData.SelectedBenefits.Any())
                    {
                        <div class="mt-3">
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (KeyValuePair<int, string> benefit in _bodyData.SelectedBenefits)
                                {
                                    <span class="badge bg-primary-subtle text-primary px-3 py-2">
                                        <i class="bi bi-check-circle me-1"></i>@benefit.Value
                                    </span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="row g-3">
                @if (_isStem)
                {
                    <div class="col-12">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-file-text me-2"></i>Bilgi / Ana Metin
                        </label>
                        <InputTextArea class="form-control" rows="4" @bind-Value="_stem"
                                       placeholder="Soruyla ilgili ek bilgi veya ana metni buraya yazın..." />
                    </div>
                }

                <div class="col-12">
                    <label class="form-label fw-semibold required">
                        <i class="bi bi-pencil me-2"></i>Soru Kökü
                    </label>
                    <InputTextArea class="form-control" rows="3" @bind-Value="_prompt"
                                   placeholder="Soru metnini buraya yazın..." />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold required">
                        <i class="bi bi-star me-2"></i>Puan
                    </label>
                    <InputText class="form-control" type="number" min="0"
                               placeholder="Örn: 5" @bind-Value="_score" />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold required">
                        <i class="bi bi-star-fill me-2"></i>Maksimum Puan
                    </label>
                    <InputText class="form-control" type="number" min="0"
                               placeholder="Örn: 10" @bind-Value="_maxScore" />
                </div>

                <div class="col-12">
                    <div class="card bg-light border-0">
                        <div class="card-body">
                            <label class="form-label fw-semibold mb-3">
                                <i class="bi bi-list-check me-2"></i>Soru Türü ve Seçenekler
                            </label>
                            <QQOptionBody @ref="_optionBody"
                                          OnSelectedOptions="HandleOptions"
                                          OnSelectedQType="HandleQType"
                                          InitialOptions="_initialOptions"
                                          SelectedQType="_selectedQType" />
                        </div>
                    </div>
                </div>

                @if (_isImage)
                {
                    <div class="col-12">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-image me-2"></i>Görsel
                        </label>

                        @if (_hasExistingImage)
                        {
                            <div class="alert alert-info mb-2">
                                <i class="bi bi-info-circle me-1"></i>
                                Orijinal soruda görsel mevcut. Yeni görsel yüklemezseniz mevcut görsel korunacak.
                            </div>
                        }

                        <div class="d-flex gap-2 mb-2">
                            <InputFile class="form-control" OnChange="HandleFileSelected" accept="image/*" />

                            @if (_hasExistingImage || _hasNewImage)
                            {
                                <button class="btn btn-outline-danger" type="button" @onclick="ClearImage">
                                    <i class="bi bi-trash"></i> Temizle
                                </button>
                            }
                        </div>

                        @if (_hasNewImage)
                        {
                            <div class="alert alert-success mb-0">
                                <i class="bi bi-check-circle me-1"></i>
                                Yeni görsel seçildi: @_bodyData.FileData?.FileName
                            </div>
                        }
                        else if (_hasExistingImage)
                        {
                            <div class="alert alert-warning mb-0">
                                <i class="bi bi-image me-1"></i>
                                Mevcut görsel kullanılacak
                            </div>
                        }

                        <small class="form-text text-muted d-block mt-2">
                            Desteklenen formatlar: JPG, PNG, GIF (Max 5MB)
                        </small>
                    </div>
                }
            </div>

            <hr class="my-4" />

            <div class="row g-3">
                <div class="col-12">
                    <h6 class="text-secondary mb-3">
                        <i class="bi bi-gear me-2"></i>Ek Ayarlar
                    </h6>
                </div>

                <div class="col-md-4">
                    <div class="form-check form-switch">
                        <InputCheckbox class="form-check-input" @bind-Value="_isStem" id="flexCheckBody" />
                        <label class="form-check-label" for="flexCheckBody">
                            <i class="bi bi-file-earmark-text me-1"></i>Bilgi/Ana Metin İçerir
                        </label>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-check form-switch">
                        <InputCheckbox class="form-check-input" @bind-Value="_isImage" id="flexCheckImage" />
                        <label class="form-check-label" for="flexCheckImage">
                            <i class="bi bi-card-image me-1"></i>Görsel İçerir
                        </label>
                    </div>
                </div>

                @if (!IsVariantMode)
                {
                    <div class="col-md-4">
                        <div class="form-check form-switch">
                            <InputCheckbox class="form-check-input" @bind-Value="_isQQBenefitLoader"
                                           id="flexCheckLoader" @onclick="ToggleBenefitLoader" />
                            <label class="form-check-label" for="flexCheckLoader">
                                <i class="bi bi-shuffle me-1"></i>Çapraz Kazanım
                                <span class="badge bg-warning text-dark ms-1">DENEYSEL</span>
                            </label>
                        </div>
                    </div>
                }
            </div>

            <div class="d-grid gap-2 mt-4">
                <button class="btn btn-primary btn-lg" type="button" @onclick="ExecuteSubmit">
                    <i class="bi @(IsVariantMode ? "bi-diagram-2" : "bi-plus-circle") me-2"></i>
                    @(IsVariantMode ? "Versiyon Oluştur" : "Soruyu Ekle")
                </button>
            </div>

            @if (_showSuccessMessage.HasValue)
            {
                <div class="alert @(_showSuccessMessage.Value ? "alert-success" : "alert-danger") alert-dismissible fade show mt-3" role="alert">
                    <i class="bi @(_showSuccessMessage.Value ? "bi-check-circle" : "bi-exclamation-triangle") me-2"></i>
                    @if (_showSuccessMessage.Value)
                    {
                        <strong>Başarılı!</strong>
                        <text> @(IsVariantMode ? "Soru versiyonu başarıyla oluşturuldu." : "Soru başarıyla eklendi.")</text>
                    }
                    else
                    {
                        <strong>Hata!</strong>
                        <text>Lütfen tüm zorunlu alanları doldurun ve en az bir kazanım seçin.</text>
                    }
                    <button type="button" class="btn-close" @onclick="() => _showSuccessMessage = null"></button>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .qq-body-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .required::after {
        content: " *";
        color: #dc3545;
    }

    .form-check-input:checked {
        background-color: #0d6efd;
        border-color: #0d6efd;
    }

    .badge.bg-primary-subtle {
        font-size: 0.875rem;
        font-weight: 500;
    }

    .card-header {
        border-bottom: 2px solid rgba(255,255,255,0.2);
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #80bdff;
        box-shadow: 0 0 0 0.2rem rgba(13,110,253,.25);
    }

    textarea.form-control {
        resize: vertical;
        min-height: 100px;
    }
</style>

@code {
    [Parameter]
    public ICollection<CheckboxItem<int>> CheckboxItems { get; set; } = [];

    [Parameter]
    public EventCallback<bool> OnQQBenefitLoader { get; set; }

    [Parameter]
    public EventCallback<QQBodyDto> OnQQBodyData { get; set; }

    [Parameter]
    public bool IsVariantMode { get; set; }

    [Parameter]
    public QQBodyDto? VariantData { get; set; }

    private QQOptionBody _optionBody = new();
    private QQBodyDto _bodyData = new();
    private byte _selectedQType;

    private string _prompt = string.Empty;
    private string? _stem;
    private string? _score;
    private string? _maxScore;
    private bool _isStem;
    private bool _isImage;
    private bool _isQQBenefitLoader;
    private bool? _showSuccessMessage;

    private ICollection<QuestionOptionDto>? _initialOptions;
    private bool _hasExistingImage => IsVariantMode && VariantData?.FileData?.Id != null;
    private bool _hasNewImage => _bodyData.FileData?.MemoryStream != null;

    protected override void OnInitialized()
    {
        _bodyData = new();

        if (IsVariantMode && VariantData != null)
        {
            LoadVariantData();
        }

        base.OnInitialized();
    }

    protected override void OnParametersSet()
    {
        if (IsVariantMode && VariantData != null)
        {
            LoadVariantData();
            StateHasChanged();
        }

        base.OnParametersSet();
    }

    private void LoadVariantData()
    {
        if (VariantData == null) return;

        _prompt = VariantData.Prompt;
        _stem = VariantData.Stem;
        _score = VariantData.Score.ToString();
        _maxScore = VariantData.MaxScore.ToString();
        _isStem = !string.IsNullOrEmpty(VariantData.Stem);
        _isImage = VariantData.FileData != null;
        _selectedQType = VariantData.SelectedQType;

        _bodyData.SelectedQType = VariantData.SelectedQType;
        _bodyData.SelectedBenefits = new Dictionary<int, string>(VariantData.SelectedBenefits);

        _initialOptions = VariantData.QuestionOptions != null
            ? new List<QuestionOptionDto>(VariantData.QuestionOptions)
            : new List<QuestionOptionDto>();

        if (VariantData.FileData != null && VariantData.FileData.Id != null)
        {
                _bodyData.FileData = new FileData
                {
                    Id = VariantData.FileData.Id,
                    FileName = VariantData.FileData.FileName
                };
        }
    }

    private async Task ExecuteSubmit()
    {
        if (!ValidateForm())
        {
            _showSuccessMessage = false;
            return;
        }

        await _optionBody.QQOption.OnSelectedOptionHandler();

        _bodyData.Prompt = _prompt;
        _bodyData.Stem = _stem;
        _bodyData.Score = int.Parse(_score!);
        _bodyData.MaxScore = int.Parse(_maxScore!);

        await OnQQBodyData.InvokeAsync(_bodyData);

        if (!IsVariantMode)
        {
            ResetForm();
        }

        _showSuccessMessage = true;
        StateHasChanged();
    }

    private bool ValidateForm()
    {
        return !string.IsNullOrWhiteSpace(_prompt) &&
               !string.IsNullOrEmpty(_score) &&
               !string.IsNullOrEmpty(_maxScore) &&
               _bodyData.SelectedBenefits.Count > 0;
    }

    private void ResetForm()
    {
        _bodyData = new();
        _prompt = string.Empty;
        _stem = string.Empty;
        _score = string.Empty;
        _maxScore = string.Empty;
    }

    private Task ToggleBenefitLoader() => OnQQBenefitLoader.InvokeAsync(_isQQBenefitLoader);

    private void HandleOptions(ICollection<QuestionOptionDto> questionOptions)
        => _bodyData.QuestionOptions = questionOptions;

    private void HandleQType(byte qType)
    {
        // Sadece gerçekten değiştiğinde güncelle
        if (_bodyData.SelectedQType != qType)
        {
            _bodyData.SelectedQType = qType;
            _selectedQType = qType;
        }
    }

    private void HandleBenefits(ICollection<CheckboxItem<int>> selectedItems)
        => _bodyData.SelectedBenefits = selectedItems.ToDictionary(item => item.Key, item => item.DisplayValue);

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        if (!_isImage || e.File == null) return;

        using MemoryStream memoryStream = new();
        await e.File.OpenReadStream().CopyToAsync(memoryStream);

        _bodyData.FileData = new FileData
        {
            FileName = e.File.Name,
            MemoryStream = memoryStream,
            ContentType = e.File.ContentType,
            FileExtension = Path.GetExtension(e.File.Name),
            FileSize = e.File.Size
        };
    }

    private void ClearImage()
    {
        _bodyData.FileData = null;
        StateHasChanged();
    }
}