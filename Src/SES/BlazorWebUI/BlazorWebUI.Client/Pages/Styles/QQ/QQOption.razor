@rendermode InteractiveAuto

<div class="form-control">
    @switch (SelectedOption)
    {
        case 1: // OpenEnded
            foreach (QuestionOptionDto option in QuestionOptions)
            {
                <div class="input-group mb-3">
                    <div class="input-group-text">
                        <InputCheckbox class="form-check-input mt-0" @bind-Value="option.IsCorrect" disabled />
                    </div>
                    <InputText type="text" class="form-control"
                               placeholder="Anahtar Kelimeleri ekleyin ve Virgül ile ayırın"
                               @bind-Value="option.OptionText"
                               disabled="@IsViewMode" />
                </div>
            }
            break;

        case 2: // ClosedEnded
            break;

        case 3: // MultipleChoice
            foreach (QuestionOptionDto option in QuestionOptions)
            {
                <div class="input-group mb-3">
                    <div class="input-group-text">
                        <InputCheckbox class="form-check-input mt-0"
                                       @bind-Value="option.IsCorrect"
                                       disabled="@IsViewMode" />
                    </div>
                    <InputText type="text" class="form-control"
                               placeholder="Seçenek Metni"
                               @bind-Value="option.OptionText"
                               disabled="@IsViewMode" />
                    @if (!IsViewMode)
                    {
                        <button class="btn btn-danger" @onclick="() => RemoveOption(option)">
                            <i class="bi bi-trash"></i>
                        </button>
                    }
                </div>
            }

            @if (!IsViewMode)
            {
                <button class="btn btn-primary" @onclick="AddOption">
                    <i class="bi bi-plus-circle me-1"></i>Seçenek Ekle
                </button>
            }
            break;

        case 4: // True/False
            foreach (QuestionOptionDto option in QuestionOptions)
            {
                <div class="input-group mb-3">
                    <div class="input-group-text">
                        <InputCheckbox class="form-check-input mt-0"
                                       @bind-Value="option.IsCorrect"
                                       disabled="@IsViewMode" />
                    </div>
                    <InputText type="text" class="form-control"
                               placeholder="Seçenek Metni"
                               @bind-Value="option.OptionText"
                               disabled="@IsViewMode" />
                </div>
            }
            @if (!IsViewMode)
            {
                <button class="btn btn-primary" @onclick="AddOption">
                    <i class="bi bi-plus-circle me-1"></i>Seçenek Ekle
                </button>
            }
            break;

        case 5: // FillInTheBlank
            foreach (QuestionOptionDto option in QuestionOptions)
            {
                <div class="input-group mb-3">
                    <InputText type="text" class="form-control"
                               placeholder="Boş Bırakılacak Kelimeleri yazın ve Virgül ile ayırın"
                               @bind-Value="option.OptionText"
                               disabled="@IsViewMode" />
                </div>
            }
            break;

        case 6: // Matching
            foreach (QuestionOptionDto option in QuestionOptions)
            {
                <div class="input-group mb-3">
                    <div class="input-group-text">
                        <InputCheckbox class="form-check-input mt-0"
                                       @bind-Value="option.IsCorrect"
                                       disabled="@IsViewMode" />
                    </div>
                    <InputText type="text" class="form-control"
                               placeholder="Eşleştirmeleri VIRGÜL ile ayırın"
                               @bind-Value="option.OptionText"
                               disabled="@IsViewMode" />
                    @if (!IsViewMode)
                    {
                        <button class="btn btn-danger" @onclick="() => RemoveOption(option)">
                            <i class="bi bi-trash"></i>
                        </button>
                    }
                </div>
            }

            @if (!IsViewMode)
            {
                <button class="btn btn-primary" @onclick="AddOption">
                    <i class="bi bi-plus-circle me-1"></i>Seçenek Ekle
                </button>
            }
            break;

        case 7: // Ordering
            break;

        default: // Undefined
                 <div class="alert alert-warning" role="alert">
                     <i class="bi bi-exclamation-triangle me-2"></i>
                     Lütfen bir soru türü seçiniz
                 </div>
            break;
    }
</div>

@code {
    [Parameter]
    public bool IsViewMode { get; set; }

    [Parameter]
    public byte SelectedOption { get; set; } = 1;

    [Parameter]
    public ICollection<QuestionOptionDto> QuestionOptions { get; set; } = [];

    [Parameter]
    public EventCallback<ICollection<QuestionOptionDto>> OnSelectedOptions { get; set; }

    public async Task OnSelectedOptionHandler()
    {
        await OnSelectedOptions.InvokeAsync(QuestionOptions.ToList());
    }

    public void AddOption()
    {
        QuestionOptions.Add(new QuestionOptionDto());
    }

    public void RemoveOption(QuestionOptionDto option)
    {
        QuestionOptions.Remove(option);
    }

    protected override Task OnParametersSetAsync()
    {
        if (!IsViewMode && (QuestionOptions == null || QuestionOptions.Count == 0))
            InitializeDefaultOptions();

        return base.OnParametersSetAsync();
    }

    private void InitializeDefaultOptions()
    {
        QuestionOptions ??= new List<QuestionOptionDto>();
        QuestionOptions.Clear();

        switch (SelectedOption)
        {
            case 1: // OpenEnded
                for (int i = 0; i < QQStatic.DefaultOpenEndedOptions; i++)
                    QuestionOptions.Add(new() { IsCorrect = true });
                break;

            case 2: // ClosedEnded
                break;

            case 3: // MultipleChoice
                for (int i = 0; i < QQStatic.DefaultMultipleChoiceOptions; i++)
                    QuestionOptions.Add(new());
                break;

            case 4: // True/False
                for (int i = 0; i < QQStatic.DefaultTrueFalseOptions; i++)
                    QuestionOptions.Add(new(){ IsCorrect = i % 2 == 0 });
                break;

            case 5: // FillInTheBlank
                for (int i = 0; i < QQStatic.DefaultFillInTheBlankOptions; i++)
                    QuestionOptions.Add(new() { IsCorrect = true });
                break;

            case 6: // Matching
                for (int i = 0; i < QQStatic.DefaultMachingOptions; i++)
                    QuestionOptions.Add(new() { IsCorrect = true });
                break;

            case 7: // Ordering
                break;

            default:
                break;
        }
    }
}