@rendermode InteractiveAuto

<div class="form-control">
    @switch (SelectedOption)
    {

        case 1: // OpenEnded
            {
                foreach (QuestionOptionDto questionOption in QuestionOptions)
                {
                    <div class="input-group mb-3">
                        <div class="input-group-text">
                            <InputCheckbox class="form-check-input mt-0" @bind-Value="questionOption.IsCorrect" disabled="true" />
                        </div>
                        <InputText type="text" class="form-control" placeholder="Anahtar Kelimeleri ekleyin ve Virgül ile ayırın" @bind-Value="questionOption.OptionText" disabled="@IsViewMode" />
                    </div>
                }
                break;
            }

        case 2: // ClosedEnded
            {

                break;
            }

        case 3: // MultipleChoice
            {
                foreach (QuestionOptionDto questionOption in QuestionOptions)
                {
                    <div class="input-group mb-3">
                        <div class="input-group-text">
                            <InputCheckbox class="form-check-input mt-0" @bind-Value="questionOption.IsCorrect" disabled="@IsViewMode" />
                        </div>
                        <InputText type="text" class="form-control" placeholder="Seçenek Metni" @bind-Value="questionOption.OptionText" disabled="@IsViewMode" />
                        <button class="btn btn-danger" @onclick="() => RemoveOption(questionOption)" hidden="@IsViewMode" disabled="@IsViewMode">Sil</button>
                    </div>
                }

                <button class="btn btn-primary" @onclick="AddOption" hidden="@IsViewMode" disabled="@IsViewMode">Seçenek Ekle</button>

                break;
            }

        case 4: // True/False
            {
                foreach (QuestionOptionDto questionOption in QuestionOptions)
                {
                    <div class="input-group mb-3">
                        <div class="input-group-text">
                            <InputCheckbox class="form-check-input mt-0" @bind-Value="questionOption.IsCorrect" disabled="@IsViewMode" />
                        </div>
                        <InputText type="text" class="form-control" placeholder="Seçenek Metni" @bind-Value="questionOption.OptionText" disabled="@IsViewMode" />
                    </div>
                }

                break;
            }

        case 5: // FillInTheBlank
            {
                foreach (QuestionOptionDto questionOption in QuestionOptions)
                {
                    <div class="input-group mb-3">
                        <InputText type="text" class="form-control" placeholder="Boş Bırakılacak Kelimeleri yazın ve Virgül ile ayırın" @bind-Value="questionOption.OptionText" disabled="@IsViewMode" />
                    </div>
                }

                break;
            }

        case 6: // Matching
            {
                foreach (QuestionOptionDto questionOption in QuestionOptions)
                {
                    <div class="input-group mb-3">
                        <div class="input-group-text">
                            <InputCheckbox class="form-check-input mt-0" @bind-Value="questionOption.IsCorrect" disabled="@IsViewMode" />
                        </div>
                        <InputText type="text" class="form-control" placeholder="eşletirmeleri VİRGÜL ile ayırın" @bind-Value="questionOption.OptionText" disabled="@IsViewMode" />
                        <button class="btn btn-danger" @onclick="() => RemoveOption(questionOption)" hidden="@IsViewMode" disabled="@IsViewMode">Sil</button>
                    </div>
                }

                <button class="btn btn-primary" @onclick="AddOption" hidden="@IsViewMode" disabled="@IsViewMode">Seçenek Ekle</button>

                break;
            }

        case 7: // Ordering
            {
                break;
            }

        default: // Undefined
            {
                <span>Seçenek Seçiniz</span>
                break;
            }
    }
</div>

@code {
    [Parameter]
    public bool IsViewMode { get; set; } = false;

    [Parameter]
    public int SelectedOption { get; set; } = 1;

    [Parameter]
    public ICollection<QuestionOptionDto> QuestionOptions { get; set; } = [];

    [Parameter]
    public EventCallback<ICollection<QuestionOptionDto>> OnSelectedOptions { get; set; }


    public async Task OnSelectedOptionHandler()
    {
        ICollection<QuestionOptionDto> questionOptionsAfter = QuestionOptions.ToList();
        await OnSelectedOptions.InvokeAsync(questionOptionsAfter);
        QuestionOptions.Clear();
    }

    public void AddOption()
    {
        QuestionOptions.Add(new QuestionOptionDto());
    }

    public void RemoveOption(QuestionOptionDto questionOption)
    {
        QuestionOptions.Remove(questionOption);
    }

    protected override Task OnParametersSetAsync()
    {
        if (!IsViewMode)
            BeforeSetup();
        return base.OnParametersSetAsync();
    }


    private void BeforeSetup()
    {
        QuestionOptions.Clear();

        switch (SelectedOption)
        {
            case 1:
                {
                    for (int i = 0; i < QQStatic.DefaultOpenEndedOptions; i++)
                        QuestionOptions.Add(new() { IsCorrect = true });
                    break;
                }

            case 2:
                {
                    break;
                }

            case 3:
                {
                    for (int i = 0; i < QQStatic.DefaultMultipleChoiceOptions; i++)
                        QuestionOptions.Add(new());
                    break;
                }

            case 4:
                {
                    for (int i = 0; i < QQStatic.DefaultTrueFalseOptions; i++)
                        QuestionOptions.Add(new() { IsCorrect = (i % 2 == 0) });
                    break;
                }

            case 5:
                {
                    for (int i = 0; i < QQStatic.DefaultFillInTheBlankOptions; i++)
                        QuestionOptions.Add(new() { IsCorrect = true });
                    break;
                }

            case 6:
                {
                    for (int i = 0; i < QQStatic.DefaultMachingOptions; i++)
                        QuestionOptions.Add(new() { IsCorrect = true });                    
                    break;
                }

            case 7:
                {
                    break;
                }

            default:
                {
                    break;
                }
        }
        return;
    }
}
